#!/usr/bin/env sh
set -eu

usage() {
  cat <<'EOF'
aiops - AI Agent Ops project helper

Usage:
  aiops seed [--adapter codex|claude|both] [--mode link|copy] [--target DIR] [--core DIR] [--force]
  aiops doctor [--target DIR] [--strict]
  aiops migrate [--target DIR] [--plan|--apply]
  aiops project inspect [--target DIR] [--json]
  aiops project snapshot [--target DIR] --json
  aiops project context --role ROLE [--target DIR] [--task TASK_ID] [--json]
  aiops project health [--target DIR] [--json]
  aiops project dashboard [--target DIR] [--view main|work] [--level compact|standard|detail] [--format terminal|tree|mermaid] [--map dependencies|workflow|agents|blockers] [--json] [--color auto|always|never] [--no-color]
  aiops policy evaluate [--target DIR|--snapshot FILE] [--strict-level LEVEL] --json
  aiops bootstrap-guide [--target DIR]
  aiops session-guide [--target DIR]
  aiops role prompt ROLE [--target DIR] [--task TASK_ID] [--adapter codex|claude|generic] [--agent NAME]
  aiops action plan --role ROLE --task TASK_ID [--target DIR] [--intends LIST] [--paths LIST] --json
  aiops action validate FILE
  aiops validate [project] [--target DIR] [--strict]
  aiops validate task FILE [--strict]
  aiops validate handoff FILE [--strict]
  aiops validate policy-rules [--core DIR]
  aiops validate workflow-catalog [--target DIR|--core DIR]
  aiops validate project-snapshot FILE
  aiops validate project-dashboard FILE
  aiops validate policy-evaluation FILE
  aiops task create --title TITLE [--target DIR] [--workflow NAME] [--role ROLE] [--capability NAME]
  aiops task status TASK_ID [--target DIR] [--source local|canonical]
  aiops task transition TASK_ID --to STATUS --role ROLE [--target DIR] [--by AGENT] [--reason TEXT] [--blocker TEXT] [--next-decision TEXT]
  aiops task lock TASK_ID --by AGENT [--target DIR] [--role ROLE] [--session ID]
  aiops task unlock TASK_ID --by AGENT [--target DIR]
  aiops handoff create TASK_ID --from ROLE --to ROLE --next-action TEXT [--target DIR]
  aiops handoff validate FILE|TASK_ID [--target DIR] [--strict]
  aiops status-ref [--target DIR]
  aiops sync-status [--target DIR]
  aiops worktree doctor [--target DIR]
  aiops knowledge init [--target DIR] [--mode minimal|full] [--force]
  aiops knowledge pack TOPIC [--target DIR] [--create] [--task TASK_ID] [--source PATH] [--purpose TEXT]
  aiops knowledge lint [--target DIR]
  aiops knowledge status [--target DIR]
  aiops ci init [--target DIR] [--provider github] [--force]
  aiops export runtime [--target DIR] [--output FILE]
  aiops version [--core DIR]
  aiops update [--core DIR] [--check]
  aiops release-check [--core DIR] [--strict] [--allow-pending-release]
  aiops help

Defaults:
  adapter: codex
  mode: link
  target: current directory
  core: AIOPS_CORE_HOME, or ai-agent-ops directory that contains this bin/aiops

Examples:
  aiops seed --adapter codex
  aiops seed --adapter claude
  aiops seed --adapter both --mode copy
  aiops doctor
  aiops migrate --plan
  aiops project inspect
  aiops project inspect --json
  aiops project snapshot --json
  aiops project context --role execution --task T-YYYYMMDD-001
  aiops action plan --role execution --task T-YYYYMMDD-001 --json
  aiops action validate /tmp/action_plan.json
  aiops project health
  aiops project dashboard
  aiops project dashboard --level compact
  aiops project dashboard --view work --format mermaid --map dependencies
  aiops project dashboard --json
  aiops policy evaluate --json
  aiops validate --strict
  aiops validate project --target /path/to/project --strict
  aiops validate task .ai_project/tasks/active/T-YYYYMMDD-001.md
  aiops validate handoff .ai_project/handoffs/T-YYYYMMDD-001_execution_to_verification.md --strict
  aiops validate policy-rules
  aiops validate workflow-catalog
  aiops validate project-snapshot /tmp/project_snapshot.json
  aiops validate project-dashboard /tmp/project_dashboard.json
  aiops validate policy-evaluation /tmp/policy_evaluation.json
  aiops task create --title "로그인 화면 구현" --workflow feature --role "Lead Role"
  aiops task status T-YYYYMMDD-001 --source canonical
  aiops task transition T-YYYYMMDD-001 --to approved --role "Direction Role"
  aiops handoff create T-YYYYMMDD-001 --from "Execution Role" --to "Verification Role" --next-action "변경 결과 검증"
  aiops status-ref
  aiops sync-status
  aiops worktree doctor
  aiops knowledge init --mode minimal
  aiops knowledge pack ios_login --create --task T-YYYYMMDD-001
  aiops knowledge lint
  aiops ci init
  aiops export runtime
  aiops bootstrap-guide
  aiops session-guide
  aiops role prompt execution --task T-YYYYMMDD-001 --adapter codex
  aiops update --check
  aiops release-check --strict
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

same_file_content() {
  [ -f "$1" ] && [ -f "$2" ] && cmp -s "$1" "$2"
}

aiops_runtime_ignore_present() {
  gitignore="$1"
  [ -f "$gitignore" ] || return 1
  grep -Eq '^/?\.ai_project/\.runtime/?$' "$gitignore"
}

ensure_aiops_runtime_ignored() {
  target="$1"
  gitignore="$target/.gitignore"

  if aiops_runtime_ignore_present "$gitignore"; then
    return 1
  fi

  if [ -s "$gitignore" ]; then
    printf '\n# AI Ops local runtime cache\n.ai_project/.runtime/\n' >> "$gitignore"
  else
    {
      printf '# AI Ops local runtime cache\n'
      printf '.ai_project/.runtime/\n'
    } > "$gitignore"
  fi
  return 0
}

runtime_status_ref_tracked() {
  target="$1"
  git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  git -C "$target" ls-files --error-unmatch .ai_project/.runtime/status_ref >/dev/null 2>&1
}

check_required_file() {
  file="$1"
  label="$2"
  if [ -f "$file" ]; then
    info "ok: $label"
  else
    info "missing: $label"
    return 1
  fi
}

check_required_dir() {
  dir="$1"
  label="$2"
  if [ -d "$dir" ]; then
    info "ok: $label"
  else
    info "missing: $label"
    return 1
  fi
}

detect_ai_project_mode() {
  project_dir="$1"
  operating_model="$project_dir/operating_model.md"

  if [ ! -f "$operating_model" ]; then
    printf '%s\n' "unknown"
    return 0
  fi

  if grep -q 'bootstrap_mode.*fast_track' "$operating_model"; then
    printf '%s\n' "fast_track"
  else
    printf '%s\n' "guided_full"
  fi
}

task_field_value() {
  file="$1"
  field="$2"
  awk -F': *' -v field="$field" '$1 == field { print $2; exit }' "$file"
}

markdown_table_value() {
  file="$1"
  key="$2"
  awk -F'|' -v key="$key" '
    NF >= 3 {
      left=$2
      value=$3
      gsub(/^[ \t]+|[ \t]+$/, "", left)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      gsub(/^`|`$/, "", value)
      if (left == key) {
        print value
        exit
      }
    }
  ' "$file"
}

normalize_project_value() {
  printf '%s\n' "${1:-}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^`//; s/`$//; s/^"//; s/"$//; s/^'\''//; s/'\''$//'
}

project_field_value() {
  operating_model="$1"
  key="$2"

  [ -f "$operating_model" ] || return 0
  value="$(task_field_value "$operating_model" "$key")"
  if [ -z "$value" ]; then
    value="$(markdown_table_value "$operating_model" "$key")"
  fi
  normalize_project_value "$value"
}

project_field_unresolved() {
  value="$(normalize_project_value "${1:-}")"
  case "$value" in
    ""|"null"|"none"|"unresolved"|"pending"|"pending_decision"|"{{"*"}}")
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

conditional_project_file_required() {
  file_name="$1"
  operating_model="$2"

  case "$file_name" in
    branch_pr_strategy.md)
      branch_pr="$(project_field_value "$operating_model" "branch_pr")"
      ! project_field_unresolved "$branch_pr"
      ;;
    workflow_overrides.md)
      workflow_policy="$(project_field_value "$operating_model" "workflow_policy")"
      workflow_override="$(project_field_value "$operating_model" "workflow_override")"
      workflow_overrides="$(project_field_value "$operating_model" "workflow_overrides")"
      [ "$workflow_policy" = "custom" ] || [ "$workflow_override" = "true" ] || [ "$workflow_overrides" = "true" ]
      ;;
    ops_migration_plan.md)
      bootstrap_mode="$(project_field_value "$operating_model" "bootstrap_mode")"
      case "$bootstrap_mode" in
        migrated|*migration*) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    *)
      return 0
      ;;
  esac
}

conditional_project_file_reason() {
  file_name="$1"
  operating_model="$2"

  case "$file_name" in
    branch_pr_strategy.md)
      branch_pr="$(project_field_value "$operating_model" "branch_pr")"
      if project_field_unresolved "$branch_pr"; then
        printf '%s\n' "branch_pr pending_decision or unresolved"
      else
        printf '%s\n' "branch_pr strategy active"
      fi
      ;;
    workflow_overrides.md)
      workflow_policy="$(project_field_value "$operating_model" "workflow_policy")"
      printf '%s\n' "workflow_policy ${workflow_policy:-unknown} uses standard catalog"
      ;;
    ops_migration_plan.md)
      bootstrap_mode="$(project_field_value "$operating_model" "bootstrap_mode")"
      printf '%s\n' "bootstrap_mode ${bootstrap_mode:-unknown}, migration not requested"
      ;;
    *)
      printf '%s\n' "conditional project file not required"
      ;;
  esac
}

check_conditional_project_files() {
  target="$1"
  project_dir="$2"
  operating_model="$3"
  failed=0

  for file_name in branch_pr_strategy.md workflow_overrides.md ops_migration_plan.md; do
    path="$project_dir/$file_name"
    label="${path#$target/}"
    if conditional_project_file_required "$file_name" "$operating_model"; then
      check_required_file "$path" "$label" || failed=1
    elif [ -e "$path" ]; then
      info "ok: optional $label"
    else
      info "not_required: $label"
      info "reason: $(conditional_project_file_reason "$file_name" "$operating_model")"
    fi
  done

  [ "$failed" -eq 0 ]
}

task_has_field() {
  file="$1"
  field="$2"
  grep -q "^$field:" "$file"
}

validate_front_matter() {
  subject="$1"
  file="$2"
  strict="${3:-no}"

  ruby -ryaml -rdate -e '
    subject = ARGV[0]
    path = ARGV[1]
    strict = ARGV[2] == "yes"

    statuses = %w[
      proposed scoped approved in_progress verification_ready
      verification_in_progress verification_passed completion_review done
      blocked rework_requested cancelled
    ]
    roles = [
      "Direction Role", "Lead Role", "Execution Role", "Verification Role",
      "Completion Role", "Release Role", "Ops Governance Role", "Product Owner",
      "any", nil
    ]
    task_id_pattern = /\AT-[0-9]{8}-[0-9]{3,}\z/

    def say(message)
      STDOUT.puts(message)
    end

    def fail_with(message)
      STDOUT.puts(message)
      exit 1
    end

    def extract_front_matter(path)
      text = File.read(path)
      return [nil, text] unless text.start_with?("---\n")
      lines = text.lines
      closing = nil
      lines[1..].each_with_index do |line, idx|
        if line.strip == "---"
          closing = idx + 1
          break
        end
      end
      return [nil, text] unless closing
      [lines[1...closing].join, lines[(closing + 1)..]&.join.to_s]
    end

    def parse_yaml_map(source, path)
      data = YAML.safe_load(source, permitted_classes: [Date, Time, Symbol], aliases: true)
      return {} if data.nil?
      return data if data.is_a?(Hash)
      fail_with("schema_error: front matter is not a mapping: #{path}")
    rescue Psych::SyntaxError => e
      fail_with("schema_error: invalid YAML front matter: #{path}: #{e.message.lines.first.to_s.strip}")
    end

    def scalar_present?(value)
      !value.nil? && !(value.respond_to?(:empty?) && value.empty?)
    end

    def array_present?(value)
      value.is_a?(Array) && value.any?
    end

    front, body = extract_front_matter(path)
    if front
      data = parse_yaml_map(front, path)
    else
      # Backward compatibility for older task files that were plain metadata
      # lines without YAML front matter.
      data = parse_yaml_map(body, path)
      say("note: YAML front matter missing; legacy metadata mode")
    end

    failed = false

    case subject
    when "task"
      required = %w[id status workflow target_role required_capabilities]
      if front
        required = ["schema"] + required
      end
      required.each do |field|
        ok =
          if field == "required_capabilities"
            array_present?(data[field])
          elsif field == "target_role"
            data.key?(field)
          else
            scalar_present?(data[field])
          end
        if ok
          say("ok: #{field}")
        else
          say("missing: #{field}")
          failed = true
        end
      end

      if front && data["schema"] && data["schema"] != "aiops.task.v1"
        say("schema_error: schema must be aiops.task.v1")
        failed = true
      end
      if data["id"] && data["id"] !~ task_id_pattern
        say("schema_error: invalid id #{data["id"]}")
        failed = true
      end
      if data["status"] && !statuses.include?(data["status"])
        say("schema_error: invalid status #{data["status"]}")
        failed = true
      end
      if data["target_role"] && !roles.include?(data["target_role"])
        say("schema_error: invalid target_role #{data["target_role"]}")
        failed = true
      end
      if !%w[done cancelled].include?(data["status"]) && !scalar_present?(data["target_role"])
        say("schema_error: target_role required for status #{data["status"]}")
        failed = true
      end
      if data.key?("required_capabilities") && !array_present?(data["required_capabilities"])
        say("schema_error: required_capabilities must be a non-empty list")
        failed = true
      end

      case data["status"]
      when "approved", "in_progress"
        %w[allowed_paths source_of_truth report_to].each do |field|
          ok = field == "report_to" ? scalar_present?(data[field]) : array_present?(data[field])
          if ok
            say("ok: #{field}")
          else
            say("missing: #{field} required for status #{data["status"]}")
            failed = true
          end
        end
      when "verification_ready", "verification_in_progress", "verification_passed"
        if scalar_present?(data["qa_to"])
          say("ok: qa_to")
        else
          say("missing: qa_to required for status #{data["status"]}")
          failed = true
        end
      when "blocked"
        %w[blocker next_decision].each do |field|
          if scalar_present?(data[field])
            say("ok: #{field}")
          else
            say("missing: #{field} required for status blocked")
            failed = true
          end
        end
      end
    when "operating_model"
      required = %w[
        schema project bootstrap_mode core_version start_context readiness_level
        operating_mode team_pattern workflow_policy ownership_model coordination
        board_model knowledge_mode
      ]
      required.each do |field|
        if scalar_present?(data[field])
          say("ok: #{field}")
        else
          say("missing: #{field}")
          failed = true
        end
      end

      enums = {
        "schema" => ["aiops.operating_model.v1"],
        "bootstrap_mode" => %w[fast_track guided_full manual migrated],
        "start_context" => %w[
          new_project_with_requirement assigned_or_existing_project blank_slate_discovery
          rescue_or_recovery migration_or_modernization ops_setup_only
          scale_up_existing_ops custom_start_context
        ],
        "readiness_level" => %w[
          idea_only idea_structured planning_ready implementation_ready
          existing_project_scan_required discovery_required recovery_required ops_only
        ],
        "operating_mode" => %w[solo_light team_basic team_pr multi_team enterprise],
        "team_pattern" => %w[single_team functional_teams platform_teams cross_functional custom],
        "workflow_policy" => %w[standard_vnext skip_scoped_for_simple_tasks custom],
        "ownership_model" => %w[path_only path_plus_domain document_ownership strict_parallel_control custom],
        "coordination" => %w[single_active_task parallel_with_locks team_board_coordination custom],
        "board_model" => %w[project_board_only project_plus_team_board custom_views],
        "knowledge_mode" => %w[minimal indexed context_packs external_source_of_truth custom]
      }
      enums.each do |field, allowed|
        next unless data[field]
        next if allowed.include?(data[field])
        say("schema_error: invalid #{field} #{data[field]}")
        failed = true
      end
    when "agent_registry"
      %w[schema project agents].each do |field|
        ok = field == "agents" ? array_present?(data[field]) : scalar_present?(data[field])
        if ok
          say("ok: #{field}")
        else
          say("missing: #{field}")
          failed = true
        end
      end
      if data["schema"] && data["schema"] != "aiops.agent_registry.v1"
        say("schema_error: schema must be aiops.agent_registry.v1")
        failed = true
      end
      if data["agents"].is_a?(Array)
        data["agents"].each_with_index do |agent, idx|
          unless agent.is_a?(Hash)
            say("schema_error: agents[#{idx}] must be a mapping")
            failed = true
            next
          end
          %w[agent status roles].each do |field|
            ok = field == "roles" ? array_present?(agent[field]) : scalar_present?(agent[field])
            unless ok
              say("missing: agents[#{idx}].#{field}")
              failed = true
            end
          end
          if agent["roles"].is_a?(Array)
            agent["roles"].each do |role|
              next if roles.include?(role) && role != "Product Owner" && role != "any"
              say("schema_error: invalid agents[#{idx}].roles #{role}")
              failed = true
            end
          end
        end
      end
    when "handoff"
      required = %w[
        schema task_id from_role to_role current_status next_action
        source_of_truth allowed_paths
      ]
      required.each do |field|
        ok =
          case field
          when "source_of_truth", "allowed_paths" then array_present?(data[field])
          else scalar_present?(data[field])
          end
        if ok
          say("ok: #{field}")
        else
          say("missing: #{field}")
          failed = true
        end
      end
      if data["schema"] && data["schema"] != "aiops.handoff.v1"
        say("schema_error: schema must be aiops.handoff.v1")
        failed = true
      end
      if data["task_id"] && data["task_id"] !~ task_id_pattern
        say("schema_error: invalid task_id #{data["task_id"]}")
        failed = true
      end
      if data["current_status"] && !statuses.include?(data["current_status"])
        say("schema_error: invalid current_status #{data["current_status"]}")
        failed = true
      end
      %w[from_role to_role].each do |field|
        next unless data[field]
        next if roles.include?(data[field]) && data[field] != "any"
        say("schema_error: invalid #{field} #{data[field]}")
        failed = true
      end
    else
      fail_with("schema_error: unknown validate subject #{subject}")
    end

    if strict && front.nil?
      say("schema_error: YAML front matter required in strict mode")
      failed = true
    end

    exit(failed ? 1 : 0)
  ' "$subject" "$file" "$strict"
}

validate_task_file() {
  task="$1"

  [ -f "$task" ] || {
    info "missing: $task"
    return 1
  }

  info "AI Ops task validate"
  info "task: $task"

  validate_front_matter task "$task" no || return 1
  info "ok: task metadata"
}

validate_project_relationships() {
  target="$1"
  project_dir="$target/.ai_project"

  info ""
  info "validate: relationships"

  if command -v ruby >/dev/null 2>&1; then
    ruby -ryaml -rdate -rfind -ropen3 -e '
      target = ARGV[0]
      project_dir = File.join(target, ".ai_project")
      warnings = 0

      def front_matter(path)
        return {} unless File.file?(path)
        text = File.read(path)
        return {} unless text.start_with?("---\n")
        lines = text.lines
        closing = nil
        lines[1..].each_with_index do |line, idx|
          if line.strip == "---"
            closing = idx + 1
            break
          end
        end
        return {} unless closing
        YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
      rescue Psych::SyntaxError
        {}
      end

      def legacy_field(path, key)
        return nil unless File.file?(path)
        File.foreach(path) do |line|
          if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
            value = Regexp.last_match(1).strip
            return nil if value.empty?
            return value.gsub(/\A`|`\z/, "")
          end
        end
        nil
      end

      def list(value)
        case value
        when Array then value.compact.map(&:to_s).reject(&:empty?)
        when nil then []
        else value.to_s.split(",").map(&:strip).reject(&:empty?)
        end
      end

      def blankish?(value)
        value.nil? || value.to_s.empty? || %w[null unresolved pending_decision none].include?(value.to_s)
      end

      def git(target, *args)
        stdout, _stderr, status = Open3.capture3("git", "-C", target, *args)
        return nil unless status.success?
        stdout.strip
      end

      def warn(message)
        puts "warn: #{message}"
        1
      end

      operating = front_matter(File.join(project_dir, "operating_model.md"))
      registry = front_matter(File.join(project_dir, "agent_registry.md"))
      agents = registry["agents"].is_a?(Array) ? registry["agents"] : []
      agent_names = agents.map { |agent| agent.is_a?(Hash) ? agent["agent"].to_s : nil }.compact.reject(&:empty?)
      agent_roles = agents.flat_map { |agent| agent.is_a?(Hash) ? list(agent["roles"]) : [] }.uniq
      declared_roles = list(operating["active_roles"]) + list(operating["deferred_roles"]) + agent_roles
      declared_roles = declared_roles.uniq

      workflow_names = %w[feature bugfix docs ops_migration release]
      ai_workflows = File.join(target, ".ai", "workflows")
      if Dir.exist?(ai_workflows)
        Dir.glob(File.join(ai_workflows, "*.md")).each do |path|
          workflow_names << File.basename(path, ".md")
        end
      end
      workflow_names = workflow_names.uniq

      task_files = []
      task_root = File.join(project_dir, "tasks")
      if Dir.exist?(task_root)
        Find.find(task_root) do |entry|
          task_files << entry if File.file?(entry) && File.basename(entry).end_with?(".md")
        end
      end
      task_files.sort!

      tasks = task_files.map do |path|
        data = front_matter(path)
        {
          "path" => path,
          "relative" => path.sub(%r{\A#{Regexp.escape(target)}/?}, ""),
          "id" => data["id"] || File.basename(path, ".md"),
          "status" => data["status"] || legacy_field(path, "status"),
          "workflow" => data["workflow"] || legacy_field(path, "workflow"),
          "target_role" => data["target_role"] || legacy_field(path, "target_role"),
          "target_agent" => data["target_agent"] || legacy_field(path, "target_agent"),
          "depends_on" => list(data["depends_on"]),
          "blocks" => list(data["blocks"]),
          "source_of_truth" => list(data["source_of_truth"])
        }
      end
      task_ids = tasks.map { |task| task["id"].to_s }.reject(&:empty?)

      if agents.empty?
        warnings += warn("agent_registry has no agents; target_agent relationship checks are limited")
      else
        puts "ok: agent registry reference set"
      end

      if workflow_names.empty?
        warnings += warn("workflow reference set is empty")
      else
        puts "ok: workflow reference set"
      end

      tasks.each do |task|
        label = task["relative"]
        role = task["target_role"]
        agent = task["target_agent"]
        workflow = task["workflow"]

        if !blankish?(role) && !declared_roles.include?(role.to_s)
          warnings += warn("#{label} target_role not declared in operating_model or agent_registry: #{role}")
        end

        if !blankish?(agent) && !agent_names.include?(agent.to_s)
          warnings += warn("#{label} target_agent not registered: #{agent}")
        end

        if !blankish?(workflow) && !workflow_names.include?(workflow.to_s)
          warnings += warn("#{label} workflow not found in .ai/workflows: #{workflow}")
        end

        (task["depends_on"] + task["blocks"]).each do |dependency|
          next if blankish?(dependency)
          warnings += warn("#{label} references missing task: #{dependency}") unless task_ids.include?(dependency.to_s)
        end

        task["source_of_truth"].each do |source|
          next if blankish?(source)
          next if source =~ %r{\Ahttps?://}
          next if source.start_with?("external:")
          source_path = source.start_with?("/") ? source : File.join(target, source)
          warnings += warn("#{label} source_of_truth missing: #{source}") unless File.exist?(source_path)
        end
      end

      canonical_status_ref = operating["canonical_status_ref"] || legacy_field(File.join(project_dir, "operating_model.md"), "canonical_status_ref")
      unless blankish?(canonical_status_ref)
        if git(target, "rev-parse", "--is-inside-work-tree") == "true"
          if git(target, "rev-parse", "--verify", "#{canonical_status_ref}^{commit}")
            puts "ok: canonical_status_ref resolves"
          else
            warnings += warn("canonical_status_ref does not resolve locally: #{canonical_status_ref}")
          end
        else
          warnings += warn("canonical_status_ref is set but target is not a Git worktree: #{canonical_status_ref}")
        end
      end

      puts "relationship_warnings: #{warnings}"
      puts "ok: relationship validation report_only"
    ' "$target"
  else
    info "note: ruby not available; relationship validation skipped"
  fi
}

validate_project_status_requirements() {
  target="$1"
  project_dir="$target/.ai_project"

  info ""
  info "validate: status requirements"

  if command -v ruby >/dev/null 2>&1; then
    ruby -ryaml -rdate -rfind -e '
      target = ARGV[0]
      project_dir = File.join(target, ".ai_project")
      warnings = 0

      def front_matter(path)
        return {} unless File.file?(path)
        text = File.read(path)
        return {} unless text.start_with?("---\n")
        lines = text.lines
        closing = nil
        lines[1..].each_with_index do |line, idx|
          if line.strip == "---"
            closing = idx + 1
            break
          end
        end
        return {} unless closing
        YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
      rescue Psych::SyntaxError
        {}
      end

      def legacy_field(path, key)
        return nil unless File.file?(path)
        File.foreach(path) do |line|
          if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
            value = Regexp.last_match(1).strip
            return nil if value.empty?
            return value.gsub(/\A`|`\z/, "")
          end
        end
        nil
      end

      def list(value)
        case value
        when Array then value.compact.map(&:to_s).reject(&:empty?)
        when nil then []
        else value.to_s.split(",").map(&:strip).reject(&:empty?)
        end
      end

      def present?(value)
        case value
        when Array then !list(value).empty?
        when Hash then value.values.any? { |item| present?(item) }
        else
          !value.nil? && !value.to_s.empty? && !%w[null unresolved pending_decision none].include?(value.to_s)
        end
      end

      def path_exists?(target, value)
        return false unless present?(value)
        path = value.to_s
        path = File.join(target, path) unless path.start_with?("/")
        File.exist?(path)
      end

      def warn(message)
        puts "warn: #{message}"
        1
      end

      def require_field(task, field, label = nil)
        present?(task["data"][field]) || present?(task["legacy"][field]) ? nil : (label || field)
      end

      def require_list(task, field, label = nil)
        !list(task["data"][field]).empty? ? nil : (label || field)
      end

      def require_path(task, field, target, label = nil)
        value = task["data"][field] || task["legacy"][field]
        path_exists?(target, value) ? nil : (label || field)
      end

      task_files = []
      task_root = File.join(project_dir, "tasks")
      if Dir.exist?(task_root)
        Find.find(task_root) do |entry|
          task_files << entry if File.file?(entry) && File.basename(entry).end_with?(".md")
        end
      end
      task_files.sort!

      tasks = task_files.map do |path|
        data = front_matter(path)
        legacy = {}
        %w[id status workflow target_role target_agent approved_by locked_by lock_session report_to qa_to status_ref status_ref_sha base_ref base_sha worktree_path].each do |field|
          legacy[field] = legacy_field(path, field)
        end
        branch = data["branch"].is_a?(Hash) ? data["branch"] : {}
        pr = data["pr"].is_a?(Hash) ? data["pr"] : {}
        {
          "path" => path,
          "relative" => path.sub(%r{\A#{Regexp.escape(target)}/?}, ""),
          "data" => data,
          "legacy" => legacy,
          "id" => data["id"] || legacy["id"] || File.basename(path, ".md"),
          "status" => data["status"] || legacy["status"],
          "branch" => branch,
          "pr" => pr
        }
      end

      tasks.each do |task|
        label = task["relative"]
        status = task["status"].to_s
        missing = []

        case status
        when "proposed"
          missing << require_field(task, "title")
          missing << require_field(task, "created_by")
        when "scoped"
          missing << require_list(task, "allowed_paths")
          missing << require_list(task, "source_of_truth")
          missing << require_field(task, "target_role")
        when "approved"
          missing << require_list(task, "allowed_paths")
          missing << require_list(task, "source_of_truth")
          missing << require_field(task, "target_role")
          missing << require_field(task, "approved_by")
          missing << require_field(task, "report_to")
        when "in_progress"
          missing << require_list(task, "allowed_paths")
          missing << require_list(task, "source_of_truth")
          missing << require_field(task, "target_role")
          missing << require_field(task, "locked_by")
          missing << require_field(task, "lock_session")
          missing << "branch.name" unless present?(task["branch"]["name"]) || present?(task["data"]["worktree_path"]) || present?(task["legacy"]["worktree_path"])
          missing << "base_ref" unless present?(task["data"]["base_ref"]) || present?(task["legacy"]["base_ref"])
          missing << "base_sha" unless present?(task["data"]["base_sha"]) || present?(task["legacy"]["base_sha"])
          missing << require_field(task, "report_to")
        when "verification_ready"
          missing << require_field(task, "report_to")
          missing << require_path(task, "report_to", target, "report_to file")
          missing << require_field(task, "qa_to")
          missing << require_field(task, "status_ref")
          missing << require_field(task, "status_ref_sha")
        when "verification_in_progress"
          missing << require_field(task, "qa_to")
          missing << require_field(task, "locked_by")
          missing << require_field(task, "lock_session")
        when "verification_passed"
          missing << require_field(task, "qa_to")
          missing << require_path(task, "qa_to", target, "qa_to file")
          missing << require_field(task, "status_ref")
          missing << require_field(task, "status_ref_sha")
        when "completion_review"
          missing << require_field(task, "report_to")
          missing << require_field(task, "qa_to")
          missing << require_path(task, "qa_to", target, "qa_to file")
          missing << require_field(task, "status_ref")
          missing << require_field(task, "status_ref_sha")
        when "done"
          missing << require_field(task, "report_to")
          missing << require_field(task, "qa_to")
          missing << require_field(task, "status_ref")
          missing << require_field(task, "status_ref_sha")
          missing << "pr.status or branch.name" unless present?(task["pr"]["status"]) || present?(task["branch"]["name"])
        when "blocked"
          missing << require_field(task, "blocker")
          missing << require_field(task, "next_decision")
        when "rework_requested"
          missing << require_field(task, "qa_to")
          missing << require_field(task, "target_role")
        end

        missing.compact!
        missing.uniq!
        if missing.empty?
          puts "ok: #{label} status requirements"
        else
          warnings += warn("#{label} status #{status} missing evidence: #{missing.join(", ")}")
        end
      end

      puts "status_requirement_warnings: #{warnings}"
      puts "ok: status requirements report_only"
    ' "$target"
  else
    info "note: ruby not available; status requirements skipped"
  fi
}

validate_project() {
  target="$1"
  strict="$2"
  failed=0

  target="$(abs_path "$target")"
  project_dir="$target/.ai_project"

  info "AI Ops project validate"
  info "target: $target"
  info "strict: $strict"

  if [ ! -d "$project_dir" ]; then
    info "missing: .ai_project"
    return 1
  fi
  info "ok: .ai_project"

  mode="$(detect_ai_project_mode "$project_dir")"
  info "mode: $mode"

  operating_model="$project_dir/operating_model.md"
  agent_registry="$project_dir/agent_registry.md"

  if [ -f "$operating_model" ]; then
    info ""
    info "validate: operating_model"
    validate_front_matter operating_model "$operating_model" "$strict" || failed=1
  else
    info "missing: .ai_project/operating_model.md"
    failed=1
  fi

  if [ -f "$agent_registry" ]; then
    info ""
    info "validate: agent_registry"
    validate_front_matter agent_registry "$agent_registry" "$strict" || failed=1
  else
    info "missing: .ai_project/agent_registry.md"
    failed=1
  fi

  for required in \
    "$project_dir/current_context.md" \
    "$project_dir/source_of_truth.md" \
    "$project_dir/task_board.md" \
    "$project_dir/ops_decisions.md" \
    "$project_dir/ops_issues.md" \
    "$project_dir/tasks"
  do
    if [ -d "$required" ]; then
      check_required_dir "$required" "${required#$target/}" || failed=1
    else
      check_required_file "$required" "${required#$target/}" || failed=1
    fi
  done

  check_conditional_project_files "$target" "$project_dir" "$operating_model" || failed=1

  for task_dir in "$project_dir/tasks/active" "$project_dir/tasks/backlog" "$project_dir/tasks/archive"; do
    check_required_dir "$task_dir" "${task_dir#$target/}" || failed=1
  done

  if [ -d "$project_dir/tasks" ]; then
    found_tasks="no"
    find "$project_dir/tasks" -type f -name '*.md' | while IFS= read -r task; do
      found_tasks="yes"
      info ""
      validate_task_file "$task" || exit 1
    done || failed=1
  fi

  validate_project_relationships "$target"
  validate_project_status_requirements "$target"

  [ "$failed" -eq 0 ] || return 1
  info ""
  info "ok: project validate"
}

task_find_file() {
  target="$1"
  task_id="$2"
  task_dir="$target/.ai_project/tasks"

  [ -d "$task_dir" ] || return 1

  if [ -f "$task_dir/active/$task_id.md" ]; then
    printf '%s\n' "$task_dir/active/$task_id.md"
    return 0
  fi
  if [ -f "$task_dir/backlog/$task_id.md" ]; then
    printf '%s\n' "$task_dir/backlog/$task_id.md"
    return 0
  fi
  if [ -f "$task_dir/archive/$task_id.md" ]; then
    printf '%s\n' "$task_dir/archive/$task_id.md"
    return 0
  fi

  found="$(find "$task_dir" -type f -name "$task_id*.md" | sort | head -n 1 || true)"
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

task_next_id() {
  target="$1"
  date_compact="$2"

  ruby -e '
    root = ARGV[0]
    date = ARGV[1]
    max = 0
    Dir.glob(File.join(root, ".ai_project/tasks/**/*")).each do |path|
      name = File.basename(path, ".md")
      match = name.match(/\AT-#{Regexp.escape(date)}-(\d{3,})/)
      max = [max, match[1].to_i].max if match
    end
    puts format("T-%s-%03d", date, max + 1)
  ' "$target" "$date_compact"
}

task_yaml_field() {
  file="$1"
  field="$2"

  ruby -ryaml -rdate -e '
    path = ARGV[0]
    field = ARGV[1]
    text = File.read(path)
    front = nil
    if text.start_with?("---\n")
      lines = text.lines
      closing = nil
      lines[1..].each_with_index do |line, idx|
        if line.strip == "---"
          closing = idx + 1
          break
        end
      end
      front = lines[1...closing].join if closing
    else
      front = text
    end
    data = front ? YAML.safe_load(front, permitted_classes: [Date, Time, Symbol], aliases: true) : {}
    data = {} unless data.is_a?(Hash)
    value = data[field]
    if value.is_a?(Array)
      puts value.join(", ")
    elsif value.nil?
      puts ""
    else
      puts value
    end
  ' "$file" "$field"
}

task_update_front_matter() {
  file="$1"
  shift

  ruby -ryaml -rdate -e '
    path = ARGV.shift
    updates = {}
    ARGV.each do |pair|
      key, value = pair.split("=", 2)
      updates[key] = value == "__AIOPS_NULL__" ? nil : value
    end

    text = File.read(path)
    unless text.start_with?("---\n")
      STDERR.puts("error: YAML front matter required: #{path}")
      exit 1
    end

    lines = text.lines
    closing = nil
    lines[1..].each_with_index do |line, idx|
      if line.strip == "---"
        closing = idx + 1
        break
      end
    end
    unless closing
      STDERR.puts("error: YAML front matter closing marker missing: #{path}")
      exit 1
    end

    front = lines[1...closing].join
    body = lines[(closing + 1)..]&.join.to_s
    data = YAML.safe_load(front, permitted_classes: [Date, Time, Symbol], aliases: true)
    data = {} unless data.is_a?(Hash)
    updates.each { |key, value| data[key] = value }
    File.write(path, YAML.dump(data) + "---\n" + body)
  ' "$file" "$@"
}

task_append_event() {
  file="$1"
  event="$2"
  actor="$3"
  reason="$4"
  date_value="$(date +%Y-%m-%d)"

  if ! grep -q '^## AI Ops CLI 기록' "$file"; then
    {
      printf '\n## AI Ops CLI 기록\n\n'
      printf '| 날짜 | Actor | Event | Reason |\n'
      printf '|---|---|---|---|\n'
    } >> "$file"
  fi
  printf '| %s | %s | %s | %s |\n' "$date_value" "$actor" "$event" "$reason" >> "$file"
}

task_next_role_for_status() {
  status="$1"
  case "$status" in
    proposed) printf '%s\n' "Lead Role" ;;
    scoped) printf '%s\n' "Direction Role" ;;
    approved) printf '%s\n' "Execution Role" ;;
    in_progress) printf '%s\n' "Execution Role" ;;
    verification_ready) printf '%s\n' "Verification Role" ;;
    verification_in_progress) printf '%s\n' "Verification Role" ;;
    verification_passed) printf '%s\n' "Completion Role" ;;
    completion_review) printf '%s\n' "Completion Role" ;;
    rework_requested) printf '%s\n' "Lead Role" ;;
    blocked) printf '%s\n' "Lead Role" ;;
    done|cancelled) printf '%s\n' "" ;;
    *) printf '%s\n' "" ;;
  esac
}

task_transition_allowed() {
  target="$1"
  workflow="$2"
  from="$3"
  to="$4"
  role="$5"

  catalog="$(workflow_catalog_path "$target" "" 2>/dev/null || true)"
  [ -n "$catalog" ] || return 1
  command -v ruby >/dev/null 2>&1 || return 1

  ruby -rjson -e '
    catalog_path = ARGV[0]
    workflow_id = ARGV[1]
    from = ARGV[2]
    to = ARGV[3]
    role = ARGV[4]
    catalog = JSON.parse(File.read(catalog_path))
    workflows = catalog["workflows"] || {}
    default_workflow = catalog["default_workflow"]

    def resolve_workflow(workflows, workflow_id, default_workflow, seen = [])
      return {} if workflow_id.nil? || seen.include?(workflow_id)
      entry = workflows[workflow_id] || workflows[default_workflow] || {}
      inherited = entry["inherits"]
      if inherited
        parent = resolve_workflow(workflows, inherited, default_workflow, seen + [workflow_id])
        parent.merge(entry) do |key, parent_value, child_value|
          if key == "statuses"
            parent_value.merge(child_value || {})
          elsif key == "transitions"
            child_value || parent_value
          else
            child_value.nil? ? parent_value : child_value
          end
        end
      else
        entry
      end
    end

    entry = resolve_workflow(workflows, workflow_id, default_workflow)
    transitions = entry["transitions"].is_a?(Array) ? entry["transitions"] : []
    allowed = transitions.any? do |transition|
      roles = transition["allowed_roles"].is_a?(Array) ? transition["allowed_roles"] : []
      transition["from"] == from &&
        transition["to"] == to &&
        (roles.include?(role) || roles.include?("any"))
    end
    exit(allowed ? 0 : 1)
  ' "$catalog" "$workflow" "$from" "$to" "$role"
}

workflow_catalog_path() {
  target="$1"
  core="${2:-}"

  if [ -n "$target" ] && [ -f "$target/.ai/runtime/workflows.json" ]; then
    printf '%s\n' "$target/.ai/runtime/workflows.json"
    return 0
  fi

  if [ -n "$core" ] && [ -f "$core/runtime/workflows.json" ]; then
    printf '%s\n' "$core/runtime/workflows.json"
    return 0
  fi

  default_core="$(default_core_dir)"
  if [ -f "$default_core/runtime/workflows.json" ]; then
    printf '%s\n' "$default_core/runtime/workflows.json"
    return 0
  fi

  return 1
}

workflow_status_field() {
  target="$1"
  workflow="$2"
  status="$3"
  field="$4"

  catalog="$(workflow_catalog_path "$target" "" 2>/dev/null || true)"
  [ -n "$catalog" ] || return 0
  command -v ruby >/dev/null 2>&1 || return 0

  ruby -rjson -e '
    catalog_path = ARGV[0]
    workflow_id = ARGV[1]
    status_id = ARGV[2]
    field = ARGV[3]
    catalog = JSON.parse(File.read(catalog_path))
    workflows = catalog["workflows"] || {}
    default_workflow = catalog["default_workflow"]

    def workflow_entry(workflows, workflow_id, default_workflow)
      workflows[workflow_id] || workflows[default_workflow] || {}
    end

    def resolve_status(workflows, workflow_id, status_id, default_workflow, seen = [])
      return nil if workflow_id.nil? || seen.include?(workflow_id)
      entry = workflow_entry(workflows, workflow_id, default_workflow)
      statuses = entry["statuses"] || {}
      return statuses[status_id] if statuses.key?(status_id)
      inherited = entry["inherits"]
      return resolve_status(workflows, inherited, status_id, default_workflow, seen + [workflow_id]) if inherited
      return nil if workflow_id == default_workflow
      resolve_status(workflows, default_workflow, status_id, default_workflow, seen + [workflow_id])
    end

    status = resolve_status(workflows, workflow_id, status_id, default_workflow)
    exit 0 unless status
    value = status[field]
    case value
    when true then puts "true"
    when false then puts "false"
    when nil then exit 0
    else puts value
    end
  ' "$catalog" "$workflow" "$status" "$field"
}

task_require_project() {
  target="$1"
  [ -d "$target/.ai_project/tasks" ] || die ".ai_project/tasks missing; bootstrap or migrate project first"
  mkdir -p "$target/.ai_project/tasks/active" "$target/.ai_project/tasks/backlog" "$target/.ai_project/tasks/archive"
}

role_slug() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/ role$//; s/[^a-z0-9]/_/g; s/_\{2,\}/_/g; s/^_//; s/_$//'
}

handoff_find_file() {
  target="$1"
  value="$2"

  if [ -f "$value" ]; then
    abs_path "$value"
    return 0
  fi

  case "$value" in
    /*)
      [ -f "$value" ] || return 1
      printf '%s\n' "$value"
      return 0
      ;;
  esac

  if [ -f "$target/$value" ]; then
    printf '%s\n' "$target/$value"
    return 0
  fi

  handoff_dir="$target/.ai_project/handoffs"
  [ -d "$handoff_dir" ] || return 1
  found="$(find "$handoff_dir" -type f -name "$value*.md" | sort | tail -n 1 || true)"
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

normalize_role_name() {
  role="$(printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[ _-]/ /g; s/[[:space:]]\{1,\}/ /g; s/^ //; s/ $//')"
  case "$role" in
    direction|"direction role"|pm|product|"product owner") printf '%s\n' "Direction Role" ;;
    lead|"lead role"|"team lead"|"pm lead") printf '%s\n' "Lead Role" ;;
    execution|"execution role"|dev|developer|development|implementation) printf '%s\n' "Execution Role" ;;
    verification|"verification role"|qa|test|review) printf '%s\n' "Verification Role" ;;
    completion|"completion role"|complete|done) printf '%s\n' "Completion Role" ;;
    release|"release role") printf '%s\n' "Release Role" ;;
    ops|"ops governance"|"ops governance role"|"ai ops"|aiops) printf '%s\n' "Ops Governance Role" ;;
    *) return 1 ;;
  esac
}

role_default_agent() {
  role="$1"
  case "$role" in
    "Direction Role") printf '%s\n' "PM Agent" ;;
    "Lead Role") printf '%s\n' "Lead Agent" ;;
    "Execution Role") printf '%s\n' "Development Agent" ;;
    "Verification Role") printf '%s\n' "QA Agent" ;;
    "Completion Role") printf '%s\n' "Completion Agent" ;;
    "Release Role") printf '%s\n' "Release Agent" ;;
    "Ops Governance Role") printf '%s\n' "AI Ops Agent" ;;
    *) printf '%s\n' "AI Agent" ;;
  esac
}

role_responsibility_text() {
  role="$1"
  case "$role" in
    "Direction Role")
      cat <<'EOF'
- 요구를 Task 후보로 정리한다.
- 우선순위, 승인 필요 여부, 성공 기준을 확인한다.
- 사용자 승인 없이 Task를 approved로 넘기지 않는다.
EOF
      ;;
    "Lead Role")
      cat <<'EOF'
- Task 범위, ownership, dependency, allowed_paths, source_of_truth를 조율한다.
- 실행 가능한 Task를 Execution Role로 인계한다.
- blocked/rework Task의 재조율을 담당한다.
EOF
      ;;
    "Execution Role")
      cat <<'EOF'
- 승인된 Task만 실행한다.
- allowed_paths 안에서만 파일을 수정한다.
- 구현 후 자체 검증과 작업 보고를 남기고 Verification Role로 인계한다.
- 독립 검증이나 완료 확정을 대신하지 않는다.
EOF
      ;;
    "Verification Role")
      cat <<'EOF'
- verification_ready Task만 독립적으로 검증한다.
- PASS, PASS_WITH_RISK, FAIL, BLOCKED 결과를 명확히 기록한다.
- 수정 필요 시 rework_requested로 Lead Role에게 넘긴다.
- Completion 판단을 대신하지 않는다.
EOF
      ;;
    "Completion Role")
      cat <<'EOF'
- verification_passed Task의 완료 확정 여부를 판단한다.
- 잔여 리스크, 후속 Task, release 영향을 확인한다.
- 완료 가능할 때만 done으로 전환한다.
EOF
      ;;
    "Release Role")
      cat <<'EOF'
- 배포 준비, release gate, rollback/운영 인계를 확인한다.
- 실제 release workflow가 활성화된 Task만 다룬다.
- 사용자 승인 없이 배포하지 않는다.
EOF
      ;;
    "Ops Governance Role")
      cat <<'EOF'
- AI Ops 운영모델, migration, 정책 충돌, adapter 상태를 점검한다.
- 제품 Task 실행 라인의 구현/검증/완료 판단을 대신하지 않는다.
- .ai/ 코어 수정은 운영자 승인 후에만 진행한다.
EOF
      ;;
  esac
}

render_template_file() {
  src="$1"
  dest="$2"
  date_value="$3"
  project_name="$4"

  sed \
    -e "s/{{DATE}}/$date_value/g" \
    -e "s/{{PROJECT_NAME}}/$project_name/g" \
    -e "s/{{PROJECT_ONE_LINE_SUMMARY}}/unresolved/g" \
    -e "s/{{PROJECT_GOAL}}/unresolved/g" \
    -e "s/{{PROJECT_STAGE}}/unresolved/g" \
    -e "s/{{KEY_DECISION}}/unresolved/g" \
    -e "s/{{SOURCE_DOC}}/unresolved/g" \
    -e "s/{{SOURCE_ROLE}}/unresolved/g" \
    -e "s/{{PRODUCT_SOURCE_OF_TRUTH}}/unresolved/g" \
    -e "s/{{TECH_SOURCE_OF_TRUTH}}/unresolved/g" \
    "$src" > "$dest"
}

knowledge_required_file() {
  target="$1"
  file="$2"
  if [ -f "$target/.ai_knowledge/$file" ]; then
    info "ok: .ai_knowledge/$file"
    return 0
  fi
  info "missing: .ai_knowledge/$file"
  return 1
}

target_core_source() {
  target="$1"
  ai="$target/.ai"

  if [ -L "$ai" ]; then
    link_target="$(readlink "$ai")"
    case "$link_target" in
      *homebrew*|*/Cellar/*|*/opt/ai-agent-ops*) printf '%s\n' "homebrew" ;;
      *) printf '%s\n' "symlink" ;;
    esac
  elif [ -d "$ai" ]; then
    printf '%s\n' "project_local_copy"
  else
    printf '%s\n' "missing"
  fi
}

target_core_version() {
  target="$1"
  if [ -f "$target/.ai/VERSION" ]; then
    cat "$target/.ai/VERSION"
  else
    printf '%s\n' "unknown"
  fi
}

project_recorded_core_version() {
  operating_model="$1"
  if [ ! -f "$operating_model" ]; then
    printf '%s\n' "missing"
    return 0
  fi

  recorded="$(task_field_value "$operating_model" "core_version")"
  if [ -z "$recorded" ]; then
    recorded="$(markdown_table_value "$operating_model" "core_version")"
  fi
  if [ -z "$recorded" ]; then
    printf '%s\n' "missing"
  else
    normalize_project_value "$recorded"
  fi
}

canonical_status_ref_value() {
  target="$1"
  project_dir="$target/.ai_project"
  ref=""

  if [ -f "$project_dir/operating_model.md" ]; then
    ref="$(task_field_value "$project_dir/operating_model.md" "canonical_status_ref")"
    if [ -z "$ref" ]; then
      ref="$(markdown_table_value "$project_dir/operating_model.md" "canonical_status_ref")"
    fi
  fi

  if [ -z "$ref" ] && [ -f "$project_dir/branch_pr_strategy.md" ]; then
    ref="$(awk -F': *' '$1 ~ /^[[:space:]]*canonical_status_ref$/ { print $2; exit }' "$project_dir/branch_pr_strategy.md")"
  fi

  case "$ref" in
    ""|"null"|"unresolved"|"{{CANONICAL_STATUS_REF}}")
      printf '%s\n' ""
      ;;
    \{*|\[*)
      printf '%s\n' ""
      ;;
    *)
      printf '%s\n' "$ref" | sed 's/^`//; s/`$//'
      ;;
  esac
}

git_require_repo() {
  target="$1"
  git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "target is not a Git work tree: $target"
}

git_ref_sha() {
  target="$1"
  ref="$2"
  git -C "$target" rev-parse --verify "$ref^{commit}" 2>/dev/null || return 1
}

task_find_file_in_ref() {
  target="$1"
  ref="$2"
  task_id="$3"

  git -C "$target" ls-tree -r --name-only "$ref" .ai_project/tasks 2>/dev/null | awk -v id="$task_id" '
    $0 == ".ai_project/tasks/active/" id ".md" { print; found=1; exit }
    $0 == ".ai_project/tasks/backlog/" id ".md" { print; found=1; exit }
    $0 == ".ai_project/tasks/archive/" id ".md" { print; found=1; exit }
    $0 == ".ai_project/tasks/" id ".md" { print; found=1; exit }
    index($0, ".ai_project/tasks/") == 1 && $0 ~ "/" id "[^/]*\\.md$" { candidate=$0 }
    END { if (!found && candidate != "") print candidate }
  '
}

cmd_status_ref() {
  target="$(pwd)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown status-ref option: $1"
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"
  ref="$(canonical_status_ref_value "$target")"

  info "AI Ops status ref"
  info "target: $target"
  if [ -n "$ref" ]; then
    info "canonical_status_ref: $ref"
    if git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      if sha="$(git_ref_sha "$target" "$ref")"; then
        info "status_ref_sha: $sha"
      else
        info "status_ref_sha: unresolved"
      fi
    else
      info "git: not_a_worktree"
    fi
  else
    info "canonical_status_ref: unresolved"
    info "note: set it in .ai_project/operating_model.md or .ai_project/branch_pr_strategy.md"
    info "examples:"
    info "  canonical_status_ref: origin/main"
    info "  canonical_status_ref: origin/develop"
  fi
}

cmd_sync_status() {
  target="$(pwd)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown sync-status option: $1"
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"
  git_require_repo "$target"
  status_ref="$(canonical_status_ref_value "$target")"
  [ -n "$status_ref" ] || die "canonical_status_ref unresolved; set it before sync-status"

  info "AI Ops sync status"
  info "target: $target"
  info "canonical_status_ref: $status_ref"

  git -C "$target" fetch --prune origin
  status_ref_sha="$(git_ref_sha "$target" "$status_ref")" || die "canonical_status_ref not found after fetch: $status_ref"
  worktree_branch="$(git -C "$target" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'unknown')"
  worktree_head="$(git -C "$target" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"

  info "status_ref_sha: $status_ref_sha"
  info "worktree_branch: $worktree_branch"
  info "worktree_head: $worktree_head"

  if [ -d "$target/.ai_project" ]; then
    if ensure_aiops_runtime_ignored "$target"; then
      info "updated: .gitignore ignores .ai_project/.runtime/"
    fi
    runtime_dir="$target/.ai_project/.runtime"
    mkdir -p "$runtime_dir"
    {
      printf 'status_ref: %s\n' "$status_ref"
      printf 'status_ref_sha: %s\n' "$status_ref_sha"
      printf 'worktree_branch: %s\n' "$worktree_branch"
      printf 'worktree_head: %s\n' "$worktree_head"
      printf 'checked_at: %s\n' "$(date +%Y-%m-%d)"
    } > "$runtime_dir/status_ref"
    info "recorded: .ai_project/.runtime/status_ref"
    info "runtime_cache: local_only"
  fi
}

cmd_worktree() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "worktree requires an action: doctor"
  shift

  case "$action" in
    doctor)
      target="$(pwd)"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown worktree doctor option: $1"
            ;;
        esac
        shift
      done

      target="$(abs_path "$target")"
      git_require_repo "$target"
      status_ref="$(canonical_status_ref_value "$target")"
      status_ref_sha=""
      if [ -n "$status_ref" ]; then
        status_ref_sha="$(git_ref_sha "$target" "$status_ref" || true)"
      fi

      info "AI Ops worktree doctor"
      info "target: $target"
      info "canonical_status_ref: ${status_ref:-unresolved}"
      info "status_ref_sha: ${status_ref_sha:-unresolved}"
      info ""

      git -C "$target" worktree list --porcelain | awk '
        /^worktree / { if (path != "") print path; path=substr($0, 10) }
        END { if (path != "") print path }
      ' | while IFS= read -r worktree_path; do
        [ -n "$worktree_path" ] || continue
        branch="$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'unknown')"
        head="$(git -C "$worktree_path" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
        dirty="no"
        if [ -n "$(git -C "$worktree_path" status --porcelain 2>/dev/null || true)" ]; then
          dirty="yes"
        fi

        merged="unknown"
        if [ -n "$status_ref" ] && [ -n "$status_ref_sha" ] && git -C "$worktree_path" merge-base --is-ancestor HEAD "$status_ref" >/dev/null 2>&1; then
          merged="yes"
        elif [ -n "$status_ref" ] && [ -n "$status_ref_sha" ]; then
          merged="no"
        fi

        classification="active"
        if [ "$dirty" = "yes" ]; then
          classification="dirty"
        elif [ "$merged" = "yes" ]; then
          classification="cleanup_candidate"
        elif [ -n "$status_ref" ] && [ -n "$status_ref_sha" ] && git -C "$worktree_path" merge-base --is-ancestor "$status_ref" HEAD >/dev/null 2>&1; then
          classification="active"
        elif [ -n "$status_ref" ] && [ -n "$status_ref_sha" ]; then
          classification="stale_or_diverged"
        fi

        info "worktree: $worktree_path"
        info "  branch: $branch"
        info "  head: $head"
        info "  dirty: $dirty"
        info "  merged_to_status_ref: $merged"
        info "  classification: $classification"
        info "  cleanup: report_only"
      done
      ;;
    *)
      die "unknown worktree action: $action"
      ;;
  esac
}

project_needs_core_version_update() {
  operating_model="$1"
  current_version="$2"
  recorded_version="$3"

  [ -f "$operating_model" ] || return 1
  case "$recorded_version" in
    ""|"missing"|"{{CORE_VERSION}}") return 0 ;;
    "$current_version") return 1 ;;
    *) return 0 ;;
  esac
}

file_has_schema_value() {
  file="$1"
  expected="$2"

  [ -f "$file" ] || return 1
  awk -v expected="$expected" '
    NR == 1 && $0 == "---" { in_front_matter=1; next }
    in_front_matter && $0 == "---" { exit }
    in_front_matter && $1 == "schema:" {
      if ($2 == expected) {
        found=1
      }
      exit
    }
    END { exit(found ? 0 : 1) }
  ' "$file"
}

missing_task_schema_count() {
  target="$1"
  task_root="$target/.ai_project/tasks"

  [ -d "$task_root" ] || {
    printf '%s\n' "0"
    return 0
  }

  find "$task_root" -type f -name '*.md' -print | while IFS= read -r task_file; do
    if ! file_has_schema_value "$task_file" "aiops.task.v1"; then
      printf '%s\n' "$task_file"
    fi
  done | wc -l | tr -d ' '
}

project_needs_review_decision() {
  target="$1"
  project_dir="$target/.ai_project"

  if [ -f "$project_dir/operating_model.md" ] && ! file_has_schema_value "$project_dir/operating_model.md" "aiops.operating_model.v1"; then
    return 0
  fi
  if [ -f "$project_dir/agent_registry.md" ] && ! file_has_schema_value "$project_dir/agent_registry.md" "aiops.agent_registry.v1"; then
    return 0
  fi
  if [ "$(missing_task_schema_count "$target")" -gt 0 ]; then
    return 0
  fi
  if [ -f "$target/AGENTS.md" ] && [ -f "$target/.ai/templates/tool_adapters/codex/AGENTS.md" ] && ! same_file_content "$target/AGENTS.md" "$target/.ai/templates/tool_adapters/codex/AGENTS.md"; then
    return 0
  fi
  if [ -f "$target/CLAUDE.md" ] && [ -f "$target/.ai/templates/tool_adapters/claude/CLAUDE.md" ] && ! same_file_content "$target/CLAUDE.md" "$target/.ai/templates/tool_adapters/claude/CLAUDE.md"; then
    return 0
  fi
  if runtime_status_ref_tracked "$target"; then
    return 0
  fi

  return 1
}

update_operating_model_core_version() {
  operating_model="$1"
  current_version="$2"
  core_source="$3"

  tmp_file="${TMPDIR:-/tmp}/aiops-operating-model.$$"
  if grep -q '|[[:space:]]*core_version[[:space:]]*|' "$operating_model"; then
    awk -F'|' -v version="$current_version" -v core_source="$core_source" '
      BEGIN { OFS="|" }
      /^core_version:/ {
        print "core_version: " version
        next
      }
      /^core_source:/ {
        print "core_source: " core_source
        next
      }
      $0 ~ /^\|/ {
        key=$2
        gsub(/^[ \t]+|[ \t]+$/, "", key)
        if (key == "core_version") {
          print "", " core_version ", " " version " ", ""
          next
        }
        if (key == "core_source") {
          print "", " core_source ", " " core_source " ", ""
          next
        }
      }
      { print }
    ' "$operating_model" > "$tmp_file"
    mv "$tmp_file" "$operating_model"
    return 0
  fi

  {
    cat "$operating_model"
    printf '\n'
    printf '## Migration Version Record\n\n'
    printf '| 항목 | 값 |\n'
    printf '|---|---|\n'
    printf '| core_version | %s |\n' "$current_version"
    printf '| core_source | %s |\n' "$core_source"
    printf '| core_update_policy | manual_review |\n'
  } > "$tmp_file"
  mv "$tmp_file" "$operating_model"
}

print_migration_lists() {
  target="$1"
  current_version="$2"
  recorded_version="$3"
  mode="$4"

  operating_model="$target/.ai_project/operating_model.md"
  safe_count=0

  info ""
  info "Migration Plan Summary"
  info "  - safe_auto_fix: AI Ops 운영 파일/디렉토리 중 자동 보강해도 제품 동작에 영향을 주지 않는 항목"
  info "  - needs_user_decision: 기존 프로젝트 결정이나 adapter 문구를 바꿀 수 있어 사용자 확인이 필요한 항목"
  info "  - manual_only: 제품 코드, 제품 문서, Git/배포처럼 AI Ops가 자동 변경하지 않는 항목"
  info ""

  info "safe_auto_fix:"
  if project_needs_core_version_update "$operating_model" "$current_version" "$recorded_version"; then
    info "  - operating_model.md core_version/core_source record"
    safe_count=$((safe_count + 1))
  fi
  for dir in "$target/.ai_project/tasks/active" "$target/.ai_project/tasks/backlog" "$target/.ai_project/tasks/archive"; do
    if [ ! -d "$dir" ]; then
      info "  - ${dir#$target/}"
      safe_count=$((safe_count + 1))
    fi
  done
  if [ ! -d "$target/.ai_project/handoffs" ]; then
    info "  - .ai_project/handoffs"
    safe_count=$((safe_count + 1))
  fi
  for file in "$target/.ai_project/ops_migration_plan.md" "$target/.ai_project/ops_decisions.md" "$target/.ai_project/ops_issues.md"; do
    if [ ! -f "$file" ]; then
      info "  - ${file#$target/}"
      safe_count=$((safe_count + 1))
    fi
  done
  if [ ! -d "$target/.ai_knowledge" ]; then
    info "  - .ai_knowledge minimal workspace"
    safe_count=$((safe_count + 1))
  elif [ ! -d "$target/.ai_knowledge/context_packs" ]; then
    info "  - .ai_knowledge/context_packs"
    safe_count=$((safe_count + 1))
  elif [ ! -f "$target/.ai_knowledge/context_packs/_template.md" ]; then
    info "  - .ai_knowledge/context_packs/_template.md"
    safe_count=$((safe_count + 1))
  fi
  if ! aiops_runtime_ignore_present "$target/.gitignore"; then
    info "  - .gitignore AI Ops runtime cache rule"
    safe_count=$((safe_count + 1))
  fi
  if [ "$safe_count" -eq 0 ]; then
    info "  - none"
  fi

  info "needs_user_decision:"
  decision_count=0
  if [ -f "$operating_model" ] && ! file_has_schema_value "$operating_model" "aiops.operating_model.v1"; then
    info "  - operating_model.md schema front matter adoption"
    decision_count=$((decision_count + 1))
  fi
  if [ -f "$target/.ai_project/agent_registry.md" ] && ! file_has_schema_value "$target/.ai_project/agent_registry.md" "aiops.agent_registry.v1"; then
    info "  - agent_registry.md schema front matter adoption"
    decision_count=$((decision_count + 1))
  fi
  task_schema_missing="$(missing_task_schema_count "$target")"
  if [ "$task_schema_missing" -gt 0 ]; then
    info "  - Task schema/front matter adoption ($task_schema_missing files)"
    decision_count=$((decision_count + 1))
  fi
  if [ -f "$target/AGENTS.md" ] && [ -f "$target/.ai/templates/tool_adapters/codex/AGENTS.md" ] && ! same_file_content "$target/AGENTS.md" "$target/.ai/templates/tool_adapters/codex/AGENTS.md"; then
    info "  - AGENTS.md adapter update"
    decision_count=$((decision_count + 1))
  fi
  if [ -f "$target/CLAUDE.md" ] && [ -f "$target/.ai/templates/tool_adapters/claude/CLAUDE.md" ] && ! same_file_content "$target/CLAUDE.md" "$target/.ai/templates/tool_adapters/claude/CLAUDE.md"; then
    info "  - CLAUDE.md adapter update"
    decision_count=$((decision_count + 1))
  fi
  if runtime_status_ref_tracked "$target"; then
    info "  - tracked .ai_project/.runtime/status_ref removal"
    decision_count=$((decision_count + 1))
  fi
  if [ "$decision_count" -eq 0 ]; then
    info "  - none"
  fi

  info "manual_only:"
  info "  - product code"
  info "  - product Docs"
  info "  - source_of_truth changes"
  info "  - Task metadata auto-fill"
  info "  - Task status"
  info "  - Role / Agent mapping"
  info "  - branch / PR strategy"
  info "  - commit / push / deploy"

  if [ "$mode" = "plan" ]; then
    info ""
    info "apply_scope:"
    info "  - .ai_project/operating_model.md"
    info "  - .ai_project/ops_migration_plan.md"
    info "  - .ai_project/ops_decisions.md"
    info "  - .ai_project/ops_issues.md"
    info "  - .ai_project/tasks/"
    info "  - .ai_project/handoffs/"
    info "  - .ai_knowledge/"
    info "  - .gitignore"
    info ""
    info "approval_prompt:"
    info "  위 safe_auto_fix와 apply_scope 범위만 적용해도 될까요?"
    info ""
    info "next_command_after_approval:"
    info "  aiops migrate --target \"$target\" --apply"
  else
    info ""
    info "next_command:"
    if [ "$safe_count" -gt 0 ]; then
      info "  aiops migrate --target \"$target\" --plan"
    elif [ "$decision_count" -gt 0 ]; then
      info "  사용자 결정 항목을 확인한 뒤 필요한 파일만 수동 조정"
    else
      info "  변경 필요 없음"
    fi
  fi
}

cmd_migrate_verify() {
  target="$1"
  expected_version="$2"
  failed=0

  info "AI Ops migration verify"
  info "target: $target"

  if [ -d "$target/.ai" ] || [ -L "$target/.ai" ]; then
    info "ok: .ai"
  else
    info "missing: .ai"
    failed=1
  fi

  if [ -f "$target/.ai/VERSION" ]; then
    info "ok: .ai/VERSION"
  else
    info "missing: .ai/VERSION"
    failed=1
  fi

  operating_model="$target/.ai_project/operating_model.md"
  if [ -f "$operating_model" ]; then
    info "ok: .ai_project/operating_model.md"
    recorded_version="$(project_recorded_core_version "$operating_model")"
    if [ "$recorded_version" = "$expected_version" ]; then
      info "ok: core_version $expected_version"
    else
      info "missing: core_version match expected $expected_version"
      failed=1
    fi
  else
    info "missing: .ai_project/operating_model.md"
    failed=1
  fi

  for dir in "$target/.ai_project/tasks/active" "$target/.ai_project/tasks/backlog" "$target/.ai_project/tasks/archive"; do
    if [ -d "$dir" ]; then
      info "ok: ${dir#$target/}"
    else
      info "missing: ${dir#$target/}"
      failed=1
    fi
  done

  if [ -d "$target/.ai_project/handoffs" ]; then
    info "ok: .ai_project/handoffs"
  else
    info "missing: .ai_project/handoffs"
    failed=1
  fi

  for file in "$target/.ai_project/ops_migration_plan.md" "$target/.ai_project/ops_decisions.md" "$target/.ai_project/ops_issues.md"; do
    if [ -f "$file" ]; then
      info "ok: ${file#$target/}"
    else
      info "missing: ${file#$target/}"
      failed=1
    fi
  done

  if [ -f "$target/AGENTS.md" ] && [ -f "$target/.ai/templates/tool_adapters/codex/AGENTS.md" ] && ! same_file_content "$target/AGENTS.md" "$target/.ai/templates/tool_adapters/codex/AGENTS.md"; then
    info "needs_user_decision: AGENTS.md adapter update"
  fi
  if [ -f "$target/CLAUDE.md" ] && [ -f "$target/.ai/templates/tool_adapters/claude/CLAUDE.md" ] && ! same_file_content "$target/CLAUDE.md" "$target/.ai/templates/tool_adapters/claude/CLAUDE.md"; then
    info "needs_user_decision: CLAUDE.md adapter update"
  fi

  if [ -f "$operating_model" ] && ! file_has_schema_value "$operating_model" "aiops.operating_model.v1"; then
    info "needs_user_decision: operating_model.md schema front matter adoption"
  fi
  if [ -f "$target/.ai_project/agent_registry.md" ] && ! file_has_schema_value "$target/.ai_project/agent_registry.md" "aiops.agent_registry.v1"; then
    info "needs_user_decision: agent_registry.md schema front matter adoption"
  fi
  task_schema_missing="$(missing_task_schema_count "$target")"
  if [ "$task_schema_missing" -gt 0 ]; then
    info "needs_user_decision: Task schema/front matter adoption ($task_schema_missing files)"
  fi

  cmd_knowledge lint --target "$target" || failed=1

  if [ -d "$target/.ai_knowledge/context_packs" ]; then
    info "ok: .ai_knowledge/context_packs"
  else
    info "missing: .ai_knowledge/context_packs"
    failed=1
  fi
  if [ -f "$target/.ai_knowledge/context_packs/_template.md" ]; then
    info "ok: .ai_knowledge/context_packs/_template.md"
  else
    info "missing: .ai_knowledge/context_packs/_template.md"
    failed=1
  fi

  if aiops_runtime_ignore_present "$target/.gitignore"; then
    info "ok: .gitignore ignores .ai_project/.runtime/"
  else
    info "missing: .gitignore AI Ops runtime cache rule"
    failed=1
  fi
  if runtime_status_ref_tracked "$target"; then
    info "needs_user_decision: tracked .ai_project/.runtime/status_ref removal"
  fi

  [ "$failed" -eq 0 ] || return 1
  info "verification: passed"
}

cmd_migrate() {
  target="$(pwd)"
  mode="check"
  mode_option_count=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      --plan)
        mode_option_count=$((mode_option_count + 1))
        mode="plan"
        ;;
      --apply)
        mode_option_count=$((mode_option_count + 1))
        mode="apply"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown migrate option: $1"
        ;;
    esac
    shift
  done

  [ "$mode_option_count" -le 1 ] || die "migrate accepts only one of --plan or --apply"

  target="$(abs_path "$target")"
  [ -d "$target" ] || die "target directory not found: $target"

  current_version="$(target_core_version "$target")"
  core_source="$(target_core_source "$target")"
  project_mode="missing"
  recorded_version="missing"
  status="not_configured"

  if [ -d "$target/.ai_project" ]; then
    project_mode="$(detect_ai_project_mode "$target/.ai_project")"
    recorded_version="$(project_recorded_core_version "$target/.ai_project/operating_model.md")"
    status="up_to_date"

    if project_needs_core_version_update "$target/.ai_project/operating_model.md" "$current_version" "$recorded_version"; then
      status="migration_needed"
    fi
    for dir in "$target/.ai_project/tasks/active" "$target/.ai_project/tasks/backlog" "$target/.ai_project/tasks/archive"; do
      [ -d "$dir" ] || status="migration_needed"
    done
    for file in "$target/.ai_project/ops_migration_plan.md" "$target/.ai_project/ops_decisions.md" "$target/.ai_project/ops_issues.md"; do
      [ -f "$file" ] || status="migration_needed"
    done
    [ -d "$target/.ai_project/handoffs" ] || status="migration_needed"
    [ -d "$target/.ai_knowledge" ] || status="migration_needed"
    if [ -d "$target/.ai_knowledge" ]; then
      [ -d "$target/.ai_knowledge/context_packs" ] || status="migration_needed"
      [ -f "$target/.ai_knowledge/context_packs/_template.md" ] || status="migration_needed"
    fi
    aiops_runtime_ignore_present "$target/.gitignore" || status="migration_needed"
    if [ "$status" = "up_to_date" ] && project_needs_review_decision "$target"; then
      status="review_needed"
    fi
  fi

  info "AI Ops migrate"
  info "mode: $mode"
  info "target: $target"
  info "core_source: $core_source"
  info "current_core_version: $current_version"
  info "project_mode: $project_mode"
  info "recorded_core_version: $recorded_version"
  info "migration_status: $status"
  info ""
  info "impact_policy:"
  info "  - product code: not touched"
  info "  - product Docs: not touched"
  info "  - .ai_project/.ai_knowledge: safe migration scope only"
  info "  - .gitignore: AI Ops runtime cache ignore only"
  info "  - adapter files: report drift, do not rewrite automatically"

  if [ "$mode" != "apply" ]; then
    if [ "$core_source" = "missing" ]; then
      info "blocking:"
      info "  - .ai missing; run aiops seed first"
      info ""
      info "No files changed."
      return 1
    fi

    if [ ! -d "$target/.ai_project" ]; then
      info "blocking:"
      info "  - .ai_project missing; run bootstrap before migration"
      info ""
      info "safe_auto_fix:"
      info "  - none"
      info ""
      info "No files changed."
      return 1
    fi

    print_migration_lists "$target" "$current_version" "$recorded_version" "$mode"
    info ""
    info "No files changed."
    return 0
  fi

  [ "$core_source" != "missing" ] || die ".ai missing; run aiops seed first"
  [ -d "$target/.ai_project" ] || die ".ai_project missing; run bootstrap before migration apply"
  [ -f "$target/.ai_project/operating_model.md" ] || die ".ai_project/operating_model.md missing"
  [ "$current_version" != "unknown" ] || die ".ai/VERSION missing"

  if [ "$status" = "up_to_date" ] || [ "$status" = "review_needed" ]; then
    info ""
    if [ "$status" = "review_needed" ]; then
      info "No safe migration changes needed."
      info "User decision items remain; see migration verify output."
    else
      info "No migration changes needed."
    fi
    info "No files changed."
    info ""
    info "Verifying migration state..."
    cmd_migrate_verify "$target" "$current_version"
    return 0
  fi

  date_value="$(date +%Y-%m-%d)"
  project_name="$(basename "$target")"

  info ""
  info "Applying safe migration scope..."

  update_operating_model_core_version "$target/.ai_project/operating_model.md" "$current_version" "$core_source"
  info "updated: .ai_project/operating_model.md"

  mkdir -p "$target/.ai_project/tasks/active" "$target/.ai_project/tasks/backlog" "$target/.ai_project/tasks/archive"
  info "ensured: .ai_project/tasks/active backlog archive"
  mkdir -p "$target/.ai_project/handoffs"
  info "ensured: .ai_project/handoffs"

  if [ ! -f "$target/.ai_project/ops_migration_plan.md" ]; then
    {
      printf '# AI Ops Migration Plan\n\n'
      printf '작성일: %s\n' "$date_value"
      printf '프로젝트: %s\n' "$project_name"
      printf '상태: Applied\n\n'
      printf '## Migration Record\n\n'
      printf '| 항목 | 값 |\n'
      printf '|---|---|\n'
      printf '| core_version | %s |\n' "$current_version"
      printf '| core_source | %s |\n' "$core_source"
      printf '| apply_scope | safe_auto_fix |\n'
      printf '| safe_fixes | core_version, tasks directories, handoffs directory, ops records, knowledge context packs, runtime cache ignore |\n'
      printf '| review_scope | schema front matter, adapter drift, source_of_truth, Task metadata |\n'
    } > "$target/.ai_project/ops_migration_plan.md"
    info "created: .ai_project/ops_migration_plan.md"
  else
    {
      printf '\n## Migration Record - %s\n\n' "$date_value"
      printf '| 항목 | 값 |\n'
      printf '|---|---|\n'
      printf '| core_version | %s |\n' "$current_version"
      printf '| core_source | %s |\n' "$core_source"
      printf '| apply_scope | safe_auto_fix |\n'
      printf '| safe_fixes | core_version, tasks directories, handoffs directory, ops records, knowledge context packs, runtime cache ignore |\n'
      printf '| review_scope | schema front matter, adapter drift, source_of_truth, Task metadata |\n'
    } >> "$target/.ai_project/ops_migration_plan.md"
    info "updated: .ai_project/ops_migration_plan.md"
  fi

  if [ ! -f "$target/.ai_project/ops_decisions.md" ]; then
    {
      printf '# Ops Decisions\n\n'
      printf '작성일: %s\n' "$date_value"
      printf '프로젝트: %s\n\n' "$project_name"
    } > "$target/.ai_project/ops_decisions.md"
    info "created: .ai_project/ops_decisions.md"
  fi
  {
    printf '\n## Migration Decision - %s\n\n' "$date_value"
    printf '| 결정 | 값 |\n'
    printf '|---|---|\n'
    printf '| core_version | %s |\n' "$current_version"
    printf '| apply_scope | safe_auto_fix only |\n'
    printf '| manual_only | product code, product Docs, source_of_truth, Task metadata/status, Role mapping, branch/PR, commit/push/deploy |\n'
    printf '| review_needed | schema front matter and adapter drift are reported but not rewritten automatically |\n'
  } >> "$target/.ai_project/ops_decisions.md"
  info "updated: .ai_project/ops_decisions.md"

  if [ ! -f "$target/.ai_project/ops_issues.md" ]; then
    {
      printf '# Ops Issues\n\n'
      printf '작성일: %s\n' "$date_value"
      printf '프로젝트: %s\n\n' "$project_name"
      printf '## Open Issues\n\n'
      printf '| ID | 유형 | 내용 | 상태 | 다음 조치 |\n'
      printf '|---|---|---|---|---|\n'
      printf '|  |  |  |  |  |\n'
    } > "$target/.ai_project/ops_issues.md"
    info "created: .ai_project/ops_issues.md"
  fi

  if [ ! -d "$target/.ai_knowledge" ]; then
    cmd_knowledge init --target "$target" --mode minimal >/dev/null
    info "created: .ai_knowledge minimal workspace"
  else
    info "ok: .ai_knowledge exists"
    if [ ! -d "$target/.ai_knowledge/context_packs" ]; then
      mkdir -p "$target/.ai_knowledge/context_packs"
      info "created: .ai_knowledge/context_packs"
    fi
    if [ ! -f "$target/.ai_knowledge/context_packs/_template.md" ]; then
      render_template_file "$target/.ai/templates/ai_knowledge/context_packs/_template.md" "$target/.ai_knowledge/context_packs/_template.md" "$date_value" "$project_name"
      info "created: .ai_knowledge/context_packs/_template.md"
    fi
  fi

  if ensure_aiops_runtime_ignored "$target"; then
    info "updated: .gitignore ignores .ai_project/.runtime/"
  else
    info "ok: .gitignore ignores .ai_project/.runtime/"
  fi

  info ""
  info "AI Ops migration apply complete."
  info ""
  info "changed_scope:"
  info "  - .ai_project operating records"
  info "  - task/handoff directories"
  info "  - .ai_knowledge minimal structure when missing"
  info "  - .gitignore AI Ops runtime cache rule"
  info "not_changed:"
  info "  - product code"
  info "  - product Docs"
  info "  - Git branch, commit, push, deploy"
  info ""
  info "Verifying migration state..."
  cmd_migrate_verify "$target" "$current_version"
}

print_markdown_section_list() {
  file="$1"
  heading="$2"
  [ -f "$file" ] || return 0
  awk -v heading="$heading" '
    $0 == heading { in_section=1; next }
    in_section && /^## / { exit }
    in_section && /^[0-9]+[.]/ { print "      " $0 }
    in_section && /^- / { print "      " $0 }
  ' "$file"
}

print_current_focus_rows() {
  file="$1"
  [ -f "$file" ] || return 1
  command -v ruby >/dev/null 2>&1 || return 1
  ruby -e '
    path = ARGV[0]
    lines = File.readlines(path, chomp: true)
    headings = [
      /\A##[[:space:]]+다음 초점[[:space:]]*\z/,
      /\A##[[:space:]]+Current Focus[[:space:]]*\z/,
      /\A##[[:space:]]+(?:[0-9]+[.][[:space:]]*)?현재 운영 상태[[:space:]]*\z/
    ]

    selected = nil
    headings.each do |pattern|
      index = lines.index { |line| line.match?(pattern) }
      if index
        selected = index
        break
      end
    end
    exit 2 unless selected

    body = []
    lines[(selected + 1)..].to_a.each do |line|
      break if line.start_with?("## ")
      body << line
    end

    rows = []
    body.each do |line|
      stripped = line.strip
      next if stripped.empty?
      next if stripped.match?(/\A\|[[:space:]-]+\|/)

      if stripped.start_with?("|")
        cells = stripped.split("|").map(&:strip).reject(&:empty?)
        next if cells.length < 2
        next if cells[0].match?(/\A-+\z/) || cells[0] == "항목"
        rows << "- #{cells[0]}: #{cells[1]}"
      elsif stripped.match?(/\A[0-9]+[.][[:space:]]+/)
        rows << "- #{stripped.sub(/\A[0-9]+[.][[:space:]]+/, "")}"
      elsif stripped.start_with?("- ")
        rows << stripped
      end
    end

    rows = rows.reject { |row| row.include?("{{") && row.include?("}}") }
    rows = body.grep(/\S/).first(3).map { |line| "- #{line.strip}" } if rows.empty?
    rows.first(5).each { |row| puts "      #{row}" }
    exit(rows.empty? ? 2 : 0)
  ' "$file"
}

print_agent_registry_rows() {
  file="$1"
  [ -f "$file" ] || return 0
  if command -v ruby >/dev/null 2>&1; then
    ruby -ryaml -rdate -e '
      path = ARGV[0]
      text = File.read(path)
      rows = []

      if text.start_with?("---\n")
        lines = text.lines
        closing = nil
        lines[1..].each_with_index do |line, idx|
          if line.strip == "---"
            closing = idx + 1
            break
          end
        end
        if closing
          data = YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
          Array(data["agents"]).each do |agent|
            next unless agent.is_a?(Hash)
            name = agent["agent"] || agent["id"]
            status = agent["status"] || "unknown"
            team = agent["team"]
            roles = Array(agent["roles"]).compact.map(&:to_s).reject(&:empty?)
            next if name.to_s.empty? || roles.empty?
            label =
              case status
              when "enabled" then "active"
              when "deferred" then "deferred"
              when "inactive" then "inactive"
              else status.to_s
              end
            suffix = team.to_s.empty? ? "" : " / #{team}"
            rows << "      - #{name}: #{roles.join(" / ")} (#{label}#{suffix})"
          end
        end
      end

      if rows.empty?
        text.each_line do |line|
          next unless line.start_with?("|")
          next if line.include?("---")
          cells = line.split("|").map(&:strip).reject(&:empty?)
          next if cells.empty? || %w[담당 Agent Role].include?(cells[0])
          status = cells.find { |cell| %w[enabled deferred inactive].include?(cell) }
          next unless status
          name = cells[0]
          role = cells.find { |cell| cell.include?("Role") } || cells[2]
          label =
            case status
            when "enabled" then "active"
            else status
            end
          rows << "      - #{name}: #{role} (#{label})" if name && role
        end
      end

      rows.each { |row| puts row }
      exit(rows.empty? ? 2 : 0)
    ' "$file" && return 0
  fi
  awk -F'|' '
    substr($0, 1, 1) == "|" && $0 !~ /---/ && $0 !~ /^\|[ \t]*(담당|Agent)[ \t]*\|/ && $0 ~ /enabled/ {
      left=$2
      role=$5
      if (role == "") {
        role=$4
      }
      gsub(/^[ \t]+|[ \t]+$/, "", left)
      gsub(/^[ \t]+|[ \t]+$/, "", role)
      if (left != "" && role != "") {
        print "      - " left " / " role
      }
    }
  ' "$file"
}

script_dir() {
  source="$0"
  while [ -L "$source" ]; do
    dir="$(cd "$(dirname "$source")" && pwd)"
    link="$(readlink "$source")"
    case "$link" in
      /*) source="$link" ;;
      *) source="$dir/$link" ;;
    esac
  done
  cd "$(dirname "$source")" && pwd
}

default_core_dir() {
  if [ "${AIOPS_CORE_HOME:-}" ]; then
    cd "$AIOPS_CORE_HOME" && pwd
    return
  fi
  cd "$(script_dir)/.." && pwd
}

abs_path() {
  if [ -d "$1" ]; then
    cd "$1" && pwd
  else
    case "$1" in
      /*) printf '%s\n' "$1" ;;
      *) printf '%s\n' "$(pwd)/$1" ;;
    esac
  fi
}

require_core() {
  core="$1"
  [ -d "$core" ] || die "core directory not found: $core"
  [ -f "$core/core/constitution.md" ] || die "invalid core: missing core/constitution.md"
  [ -f "$core/bootstrap/bootstrap_runbook.md" ] || die "invalid core: missing bootstrap/bootstrap_runbook.md"
  [ -f "$core/templates/tool_adapters/codex/AGENTS.md" ] || die "invalid core: missing codex adapter"
}

copy_core() {
  core="$1"
  target_ai="$2"
  mkdir "$target_ai"
  (
    cd "$core"
    tar \
      --exclude '.git' \
      --exclude '.DS_Store' \
      --exclude '.ai_project' \
      -cf - .
  ) | (
    cd "$target_ai"
    tar -xf -
  )
}

seed_adapter() {
  core="$1"
  target="$2"
  adapter="$3"
  force="$4"

  case "$adapter" in
    codex)
      src="$core/templates/tool_adapters/codex/AGENTS.md"
      dest="$target/AGENTS.md"
      ;;
    claude)
      src="$core/templates/tool_adapters/claude/CLAUDE.md"
      dest="$target/CLAUDE.md"
      ;;
    *)
      die "unknown adapter: $adapter"
      ;;
  esac

  [ -f "$src" ] || die "adapter template not found: $src"

  if [ -e "$dest" ] && [ "$force" != "yes" ]; then
    info "skip: $(basename "$dest") already exists"
    return 0
  fi

  cp "$src" "$dest"
  info "created: $dest"
}

cmd_seed() {
  adapter="codex"
  mode="link"
  target="$(pwd)"
  core="$(default_core_dir)"
  force="no"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --adapter)
        shift
        [ "$#" -gt 0 ] || die "--adapter requires a value"
        adapter="$1"
        ;;
      --mode)
        shift
        [ "$#" -gt 0 ] || die "--mode requires a value"
        mode="$1"
        ;;
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      --core)
        shift
        [ "$#" -gt 0 ] || die "--core requires a value"
        core="$1"
        ;;
      --force)
        force="yes"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown seed option: $1"
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"
  core="$(abs_path "$core")"
  require_core "$core"

  [ -d "$target" ] || die "target directory not found: $target"
  [ "$target" != "$core" ] || die "target cannot be the ai-agent-ops core directory"

  target_ai="$target/.ai"

  if [ -e "$target_ai" ] || [ -L "$target_ai" ]; then
    if [ "$force" = "yes" ]; then
      rm -rf "$target_ai"
    else
      info "skip: .ai already exists"
    fi
  fi

  if [ ! -e "$target_ai" ] && [ ! -L "$target_ai" ]; then
    case "$mode" in
      link)
        ln -s "$core" "$target_ai"
        info "created: $target_ai -> $core"
        ;;
      copy)
        copy_core "$core" "$target_ai"
        info "created: $target_ai"
        ;;
      *)
        die "unknown mode: $mode"
        ;;
    esac
  fi

  case "$adapter" in
    codex)
      seed_adapter "$core" "$target" codex "$force"
      ;;
    claude)
      seed_adapter "$core" "$target" claude "$force"
      ;;
    both)
      seed_adapter "$core" "$target" codex "$force"
      seed_adapter "$core" "$target" claude "$force"
      ;;
    *)
      die "unknown adapter: $adapter"
      ;;
  esac

  if ensure_aiops_runtime_ignored "$target"; then
    info "updated: .gitignore ignores .ai_project/.runtime/"
  else
    info "ok: .gitignore ignores .ai_project/.runtime/"
  fi

  info ""
  info "AI Ops seed complete."
  info "Next: open an agent session in $target and say:"
  info "  AI Ops bootstrap 시작해줘."
}

cmd_doctor() {
  target="$(pwd)"
  strict="no"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      --strict)
        strict="yes"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown doctor option: $1"
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"
  ai="$target/.ai"
  failed=0
  warnings=0

  info "AI Ops doctor"
  info "target: $target"
  info "strict: $strict"

  if [ -L "$ai" ]; then
    link_target="$(readlink "$ai")"
    info "ok: .ai symlink -> $link_target"
  elif [ -d "$ai" ]; then
    info "ok: .ai directory"
    info "warn: .ai is a writable project-local directory; symlink mode is recommended for vendor core"
    warnings=$((warnings + 1))
  else
    info "missing: .ai"
    failed=1
  fi

  for required in \
    "$ai/core/constitution.md" \
    "$ai/bootstrap/bootstrap_runbook.md" \
    "$ai/bootstrap/install_runbook.md" \
    "$ai/models/role_model.md" \
    "$ai/runtime/workflow.md"
  do
    check_required_file "$required" "${required#$target/}" || failed=1
  done

  if [ -f "$target/AGENTS.md" ]; then
    info "ok: AGENTS.md"
    if [ -f "$ai/templates/tool_adapters/codex/AGENTS.md" ]; then
      if same_file_content "$target/AGENTS.md" "$ai/templates/tool_adapters/codex/AGENTS.md"; then
        info "ok: AGENTS.md matches codex adapter template"
      else
        info "warn: AGENTS.md differs from codex adapter template"
        warnings=$((warnings + 1))
      fi
    fi
  else
    info "note: AGENTS.md missing"
  fi

  if [ -f "$target/CLAUDE.md" ]; then
    info "ok: CLAUDE.md"
    if [ -f "$ai/templates/tool_adapters/claude/CLAUDE.md" ]; then
      if same_file_content "$target/CLAUDE.md" "$ai/templates/tool_adapters/claude/CLAUDE.md"; then
        info "ok: CLAUDE.md matches claude adapter template"
      else
        info "warn: CLAUDE.md differs from claude adapter template"
        warnings=$((warnings + 1))
      fi
    fi
  else
    info "note: CLAUDE.md missing"
  fi

  if [ -d "$target/.ai_project" ]; then
    info "ok: .ai_project"
    ai_project_mode="$(detect_ai_project_mode "$target/.ai_project")"
    info "mode: .ai_project $ai_project_mode"
    operating_model="$target/.ai_project/operating_model.md"

    for required in \
      "$target/.ai_project/operating_model.md" \
      "$target/.ai_project/agent_registry.md" \
      "$target/.ai_project/current_context.md" \
      "$target/.ai_project/source_of_truth.md" \
      "$target/.ai_project/task_board.md" \
      "$target/.ai_project/ops_decisions.md" \
      "$target/.ai_project/ops_issues.md" \
      "$target/.ai_project/tasks"
    do
      if [ -d "$required" ]; then
        check_required_dir "$required" "${required#$target/}" || failed=1
      else
        check_required_file "$required" "${required#$target/}" || failed=1
      fi
    done

    check_conditional_project_files "$target" "$target/.ai_project" "$operating_model" || failed=1

    for task_dir in "$target/.ai_project/tasks/active" "$target/.ai_project/tasks/backlog" "$target/.ai_project/tasks/archive"; do
      if [ -d "$task_dir" ]; then
        info "ok: ${task_dir#$target/}"
      else
        info "warn: missing ${task_dir#$target/}"
        warnings=$((warnings + 1))
      fi
    done

    if [ -d "$target/.ai_project/tasks" ]; then
      task_warning_file="${TMPDIR:-/tmp}/aiops-doctor-task-warnings.$$"
      : > "$task_warning_file"
      find "$target/.ai_project/tasks" -type f -name '*.md' | while IFS= read -r task; do
        if ! grep -q '^status:' "$task"; then
          printf 'warn: task missing status: %s\n' "${task#$target/}"
          printf '1\n' >> "$task_warning_file"
        fi
        if ! grep -q '^target_role:' "$task"; then
          printf 'warn: task missing target_role: %s\n' "${task#$target/}"
          printf '1\n' >> "$task_warning_file"
        fi
        if grep -q '^status: verification_ready' "$task"; then
          qa_to="$(awk -F': ' '/^qa_to:/{print $2; exit}' "$task")"
          if [ -z "$qa_to" ]; then
            printf 'warn: verification_ready task missing qa_to: %s\n' "${task#$target/}"
            printf '1\n' >> "$task_warning_file"
          elif [ -f "$target/$qa_to" ]; then
            printf 'ok: qa report exists for %s\n' "${task#$target/}"
          else
            printf 'note: qa report pending for %s -> %s\n' "${task#$target/}" "$qa_to"
          fi
        fi
      done
      if [ -s "$task_warning_file" ]; then
        task_warnings="$(wc -l < "$task_warning_file" | tr -d ' ')"
        warnings=$((warnings + task_warnings))
      fi
      rm -f "$task_warning_file"
    fi

    if [ -f "$ai/VERSION" ] && [ -f "$operating_model" ]; then
      current_core_version="$(normalize_project_value "$(cat "$ai/VERSION")")"
      recorded_core_version="$(task_field_value "$operating_model" "core_version")"
      if [ -z "$recorded_core_version" ]; then
        recorded_core_version="$(markdown_table_value "$operating_model" "core_version")"
      fi
      recorded_core_version="$(normalize_project_value "$recorded_core_version")"

      case "$recorded_core_version" in
        ""|"{{CORE_VERSION}}")
          info "note: .ai_project core_version not recorded"
          ;;
        "$current_core_version")
          info "ok: .ai_project core_version matches $current_core_version"
          ;;
        *)
          info "warn: .ai_project core_version $recorded_core_version differs from current core $current_core_version"
          warnings=$((warnings + 1))
          ;;
      esac
    fi

    canonical_status_ref="$(canonical_status_ref_value "$target")"
    if [ -n "$canonical_status_ref" ]; then
      info "ok: canonical_status_ref $canonical_status_ref"
    else
      info "note: canonical_status_ref unresolved; recommended for multi-worktree projects"
    fi
    if runtime_status_ref_tracked "$target"; then
      info "warn: .ai_project/.runtime/status_ref is tracked; remove it from Git and keep .ai_project/.runtime/ ignored"
      warnings=$((warnings + 1))
    fi
  else
    info "note: .ai_project missing; run bootstrap when ready"
  fi

  if [ -f "$ai/VERSION" ]; then
    info "version: $(cat "$ai/VERSION")"
  fi

  if [ "$strict" = "yes" ] && [ "$warnings" -gt 0 ]; then
    failed=1
  fi

  info "warnings: $warnings"
  [ "$failed" -eq 0 ] || exit 1
}

cmd_project() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "project requires an action: inspect, snapshot, context, health, dashboard"
  shift

  case "$action" in
    dashboard)
      target="$(pwd)"
      view="main"
      level="standard"
      format="terminal"
      map="dependencies"
      color="auto"
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --view)
            shift
            [ "$#" -gt 0 ] || die "--view requires a value"
            view="$1"
            ;;
          --level)
            shift
            [ "$#" -gt 0 ] || die "--level requires a value"
            level="$1"
            ;;
          --format)
            shift
            [ "$#" -gt 0 ] || die "--format requires a value"
            format="$1"
            ;;
          --map)
            shift
            [ "$#" -gt 0 ] || die "--map requires a value"
            map="$1"
            ;;
          --no-color)
            color="never"
            ;;
          --color)
            shift
            [ "$#" -gt 0 ] || die "--color requires a value"
            color="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown project dashboard option: $1"
            ;;
        esac
        shift
      done

      case "$view" in
        main|work) ;;
        risk|agents|release)
          die "project dashboard --view $view is planned for a later dashboard phase"
          ;;
        *)
          die "unknown project dashboard view: $view"
          ;;
      esac
      case "$level" in
        compact|standard|detail) ;;
        *)
          die "unknown project dashboard level: $level"
          ;;
      esac
      case "$format" in
        terminal|tree|mermaid) ;;
        html)
          die "project dashboard --format $format is planned for a later dashboard phase"
        ;;
        *)
          die "unknown project dashboard format: $format"
          ;;
      esac
      case "$map" in
        dependencies|workflow|agents|blockers) ;;
        *)
          die "unknown project dashboard map: $map"
          ;;
      esac
      if [ "$json" != "yes" ] && [ "$format" != "mermaid" ] && [ "$map" != "dependencies" ]; then
        die "project dashboard --map requires --format mermaid"
      fi
      if [ "$json" != "yes" ] && [ "$format" = "mermaid" ] && [ "$view" != "work" ]; then
        die "project dashboard --format mermaid currently requires --view work"
      fi
      case "$color" in
        auto|always|never) ;;
        *)
          die "unknown project dashboard color mode: $color"
          ;;
      esac

      target="$(abs_path "$target")"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for project dashboard"
      snapshot_json="$("$0" project snapshot --target "$target" --json)"
      health_json="$("$0" project health --target "$target" --json)"

      {
        printf '%s\n' "$snapshot_json"
        printf '%s\n' "__AIOPS_DASHBOARD_HEALTH_JSON__"
        printf '%s\n' "$health_json"
      } | ruby -rjson -e '
        snapshot_text, health_text = STDIN.read.split("__AIOPS_DASHBOARD_HEALTH_JSON__", 2)
        snapshot = JSON.parse(snapshot_text)
        health_summary = JSON.parse(health_text)
        view = ARGV[0]
        format = ARGV[1]
        level = ARGV[2]
        color_mode = ARGV[3]
        map = ARGV[4]
        as_json = ARGV[5] == "yes"
        color_enabled = color_mode == "always" || (color_mode == "auto" && STDOUT.tty? && ENV["NO_COLOR"].to_s.empty?)

        def colorize(enabled, text, code)
          return text unless enabled
          "#{27.chr}[#{code}m#{text}#{27.chr}[0m"
        end

        def section(enabled, text)
          colorize(enabled, text, "1;34")
        end

        def muted(enabled, text)
          colorize(enabled, text, "90")
        end

        def severity_color(status)
          text = status.to_s.downcase
          return "32" if text =~ /\A0\z/
          return "33" if text =~ /\A[1-9][0-9]*\z/
          case text
          when "ok", "complete", "allowed", "ready", "recorded_current", "not_required", "done", "true"
            "32"
          when "warning", "allowed_with_warnings", "sync_required", "not_recorded", "recorded_stale", "migration_needed", "review_needed"
            "33"
          when "blocked", "missing", "partial", "needs_canonical_status_ref", "ref_not_found_locally", "false"
            "31"
          else
            "36"
          end
        end

        def status_value(enabled, value)
          text = value.nil? || value.to_s.empty? ? "unknown" : value.to_s
          colorize(enabled, text, severity_color(text))
        end

        def task_status_color(status)
          case status.to_s.downcase
          when "approved"
            "32"
          when "in_progress"
            "34"
          when "rework_requested"
            "1;31"
          when "verification_ready", "verification_passed", "completion_review"
            "35"
          when "scoped"
            "33"
          when "proposed"
            "90"
          when "blocked"
            "31"
          else
            severity_color(status)
          end
        end

        def task_status_value(enabled, value)
          text = value.nil? || value.to_s.empty? ? "unknown" : value.to_s
          colorize(enabled, text, task_status_color(text))
        end

        def workflow_value(enabled, value)
          text = value.nil? || value.to_s.empty? ? "unknown" : value.to_s
          colorize(enabled, text, "36")
        end

        def role_value(enabled, value)
          text = value.nil? || value.to_s.empty? ? "unassigned" : value.to_s
          colorize(enabled, text, "34")
        end

        def agent_value(enabled, value)
          text = value.nil? || value.to_s.empty? ? "unassigned" : value.to_s
          colorize(enabled, text, "36")
        end

        def lock_color(value)
          text = value.nil? || value.to_s.empty? ? "none" : value.to_s
          text == "none" ? "90" : "1;31"
        end

        def lock_value(enabled, value)
          text = value.nil? || value.to_s.empty? ? "none" : value.to_s
          colorize(enabled, text, lock_color(text))
        end

        def next_action_color(label)
          case label.to_s
          when "start execution"
            "32"
          when "continue work"
            "34"
          when "address rework"
            "1;31"
          when "start verification", "start completion"
            "35"
          when "approve or split", "scope or approve"
            "33"
          else
            "36"
          end
        end

        def next_action_value(enabled, label)
          text = label.nil? || label.to_s.empty? ? "inspect task" : label.to_s
          colorize(enabled, text, next_action_color(text))
        end

        def meta_value(enabled, value, fallback = "unresolved")
          text = value.nil? || value.to_s.empty? ? fallback : value.to_s
          code = %w[none unresolved unknown unassigned].include?(text) ? "90" : "36"
          colorize(enabled, text, code)
        end

        def padded(text, width)
          value = text.to_s
          return value if value.length >= width
          value + (" " * (width - value.length))
        end

        def value(data, *keys)
          keys.reduce(data) do |current, key|
            return nil unless current.is_a?(Hash)
            current[key]
          end
        end

        def count(data, key)
          value = data[key]
          value.is_a?(Numeric) ? value.to_i : 0
        end

        def status_label(status)
          status.to_s.empty? ? "UNKNOWN" : status.to_s.upcase
        end

        def progress_bar(done, total, width = 30, color_enabled = false)
          return "[#{45.chr * width}] 0%" if total <= 0
          ratio = [[done.to_f / total, 0.0].max, 1.0].min
          filled = (ratio * width).round
          done_part = 35.chr * filled
          rest_part = 45.chr * (width - filled)
          done_part = colorize(color_enabled, done_part, "32") unless done_part.empty?
          rest_part = muted(color_enabled, rest_part) unless rest_part.empty?
          "[#{done_part}#{rest_part}] #{(ratio * 100).round}%"
        end

        def command_or_message(step)
          return step unless step.is_a?(Hash)
          step["command"] || step["message"] || step["action"]
        end

        def print_key_value(key, value, color_enabled = false)
          puts "  #{key}: #{status_value(color_enabled, value)}"
        end

        def clean(value, fallback = "unassigned")
          text = value.to_s.strip
          text.empty? ? fallback : text
        end

        def shorten(text, limit = 44)
          value = text.to_s.strip
          return "untitled" if value.empty?
          return value if value.length <= limit
          "#{value[0, limit - 3]}..."
        end

        def active_work_items(tasks)
          Array(tasks["items"]).reject { |task| %w[done cancelled].include?(task["status"].to_s) }
        end

        def status_order(status)
          order = {
            "approved" => 0,
            "in_progress" => 1,
            "rework_requested" => 2,
            "verification_ready" => 3,
            "verification_passed" => 4,
            "completion_review" => 5,
            "scoped" => 6,
            "proposed" => 7
          }
          order.fetch(status.to_s, 50)
        end

        def sorted_work_items(items)
          items.sort_by { |task| [status_order(task["status"]), task["id"].to_s] }
        end

        def next_role_command(task, target)
          role = clean(task["target_role"], "")
          status = task["status"].to_s
          role = "Execution Role" if role.empty? && status == "approved"
          role = "Lead Role" if role.empty? && %w[scoped proposed].include?(status)
          role = "Verification Role" if role.empty? && status == "verification_ready"
          role = "Completion Role" if role.empty? && %w[verification_passed completion_review].include?(status)
          return "assign target_role before starting" if role.empty?
          role_key = role.split.first.to_s.downcase
          "aiops role prompt #{role_key} --target #{target} --task #{task["id"]}"
        end

        def next_action_label(task)
          case task["status"].to_s
          when "approved"
            "start execution"
          when "in_progress"
            "continue work"
          when "rework_requested"
            "address rework"
          when "verification_ready"
            "start verification"
          when "verification_passed", "completion_review"
            "start completion"
          when "scoped"
            "approve or split"
          when "proposed"
            "scope or approve"
          else
            "inspect task"
          end
        end

        def render_work_terminal(snapshot, level, color_enabled)
          project = snapshot.fetch("project", {})
          tasks = snapshot.fetch("tasks", {})
          items = sorted_work_items(active_work_items(tasks))
          puts colorize(color_enabled, "AI Ops Work Dashboard", "1;36")
          puts "Project: #{project["name"] || File.basename(snapshot["target"].to_s)}"
          puts "Active Work: #{items.length} / #{tasks["total"].to_i} tasks"
          puts ""

          if items.empty?
            puts section(color_enabled, "Active Work")
            puts "  none"
            return
          end

          if level == "compact"
            puts section(color_enabled, "Active Work")
            items.first(8).each do |task|
              puts "  - #{task["id"]}  #{task_status_value(color_enabled, task["status"])}  #{shorten(task["title"], 36)}"
            end
            remaining = items.length - 8
            puts "  ... #{remaining} more" if remaining.positive?
            return
          end

          puts section(color_enabled, "Active Work")
          puts "Task              Status              Workflow    Role                Agent               Lock        Next"
          items.each do |task|
            id = clean(task["id"], "unknown")
            status = clean(task["status"], "unknown")
            workflow = shorten(clean(task["workflow"], "unknown"), 10)
            role = shorten(clean(task["target_role"]), 18)
            agent = shorten(clean(task["target_agent"]), 18)
            lock = shorten(clean(task["locked_by"], "none"), 10)
            next_action = next_action_label(task)
            puts [
              padded(id, 17),
              colorize(color_enabled, padded(status, 19), task_status_color(status)),
              colorize(color_enabled, padded(workflow, 11), "36"),
              colorize(color_enabled, padded(role, 19), "34"),
              colorize(color_enabled, padded(agent, 19), "36"),
              colorize(color_enabled, padded(lock, 11), lock_color(lock)),
              next_action_value(color_enabled, next_action)
            ].join(" ")
          end

          return unless level == "detail"

          puts ""
          puts section(color_enabled, "Details")
          items.each do |task|
            puts "#{task["id"]} #{shorten(task["title"], 72)}"
            puts "  Status: #{task_status_value(color_enabled, task["status"])}"
            puts "  Workflow: #{workflow_value(color_enabled, task["workflow"])}"
            puts "  Role: #{role_value(color_enabled, clean(task["target_role"]))}"
            puts "  Agent: #{agent_value(color_enabled, clean(task["target_agent"]))}"
            puts "  Lock: #{lock_value(color_enabled, clean(task["locked_by"], "none"))}"
            puts "  Branch: #{meta_value(color_enabled, clean(task["branch"], "unresolved"))}"
            puts "  Worktree: #{meta_value(color_enabled, clean(task["worktree"], "unresolved"))}"
            puts "  Allowed Paths:"
            paths = Array(task["allowed_paths"])
            if paths.empty?
              puts "    - unrestricted_by_task"
            else
              paths.each { |path| puts "    - #{path}" }
            end
            puts "  Source of Truth:"
            sources = Array(task["source_of_truth"])
            if sources.empty?
              puts "    - none"
            else
              sources.each { |source| puts "    - #{source}" }
            end
            puts "  Next: #{next_role_command(task, snapshot["target"])}"
            puts ""
          end
        end

        def render_work_tree(snapshot, level, color_enabled)
          project = snapshot.fetch("project", {})
          tasks = snapshot.fetch("tasks", {})
          items = sorted_work_items(active_work_items(tasks))
          grouped = items.group_by { |task| task["status"].to_s.empty? ? "unknown" : task["status"].to_s }
          ordered_statuses = grouped.keys.sort_by { |status| [status_order(status), status] }
          puts colorize(color_enabled, "AI Ops Work Tree", "1;36")
          puts "Project: #{project["name"] || File.basename(snapshot["target"].to_s)}"
          puts ""

          if ordered_statuses.empty?
            puts "active_work"
            puts "`-- none"
            return
          end

          puts "active_work"
          ordered_statuses.each_with_index do |status, status_index|
            status_last = status_index == ordered_statuses.length - 1
            status_prefix = status_last ? "`--" : "|--"
            child_prefix = status_last ? "   " : "|  "
            puts "#{status_prefix} #{task_status_value(color_enabled, status)}"
            grouped[status].each_with_index do |task, task_index|
              task_last = task_index == grouped[status].length - 1
              task_prefix = task_last ? "`--" : "|--"
              detail_prefix = task_last ? "   " : "|  "
              puts "#{child_prefix}#{task_prefix} #{task["id"]} #{shorten(task["title"], 56)}"
              next if level == "compact"
              puts "#{child_prefix}#{detail_prefix}|-- Role: #{role_value(color_enabled, clean(task["target_role"]))}"
              puts "#{child_prefix}#{detail_prefix}|-- Agent: #{agent_value(color_enabled, clean(task["target_agent"]))}"
              puts "#{child_prefix}#{detail_prefix}|-- Workflow: #{workflow_value(color_enabled, clean(task["workflow"], "unknown"))}"
              puts "#{child_prefix}#{detail_prefix}|-- Lock: #{lock_value(color_enabled, clean(task["locked_by"], "none"))}"
              puts "#{child_prefix}#{detail_prefix}`-- Next: #{next_action_value(color_enabled, next_action_label(task))}"
              next unless level == "detail"
              puts "#{child_prefix}#{detail_prefix}    Command: #{next_role_command(task, snapshot["target"])}"
            end
          end
        end

        def mermaid_id(prefix, value)
          raw = value.nil? || value.to_s.empty? ? "unknown" : value.to_s
          safe = raw.gsub(/[^A-Za-z0-9_]/, "_").gsub(/_+/, "_").gsub(/\A_+|_+\z/, "")
          safe = "unknown" if safe.empty?
          "#{prefix}_#{safe}"
        end

        def mermaid_label(*parts)
          parts.flatten.compact.map(&:to_s).reject(&:empty?).join("\\n").gsub("\\", "\\\\").gsub("\"", "\\\"")
        end

        def mermaid_task_class(task)
          case task["status"].to_s
          when "done"
            "done"
          when "cancelled"
            "cancelled"
          when "proposed"
            "proposed"
          when "scoped"
            "scoped"
          when "approved", "in_progress", "verification_ready", "verification_passed", "completion_review"
            "active"
          when "rework_requested", "blocked"
            "blocked"
          else
            "unknown"
          end
        end

        def mermaid_class_defs
          [
            "  classDef done fill:#dcfce7,stroke:#16a34a,color:#14532d",
            "  classDef active fill:#dbeafe,stroke:#2563eb,color:#1e3a8a",
            "  classDef scoped fill:#fef3c7,stroke:#d97706,color:#78350f",
            "  classDef proposed fill:#f3f4f6,stroke:#6b7280,color:#374151",
            "  classDef blocked fill:#fee2e2,stroke:#dc2626,color:#7f1d1d",
            "  classDef cancelled fill:#f3f4f6,stroke:#9ca3af,color:#6b7280",
            "  classDef warning fill:#fef3c7,stroke:#d97706,color:#78350f",
            "  classDef agent fill:#cffafe,stroke:#0891b2,color:#164e63",
            "  classDef role fill:#dbeafe,stroke:#2563eb,color:#1e3a8a",
            "  classDef workflow fill:#ede9fe,stroke:#7c3aed,color:#4c1d95",
            "  classDef unknown fill:#f3f4f6,stroke:#6b7280,color:#374151"
          ]
        end

        def render_mermaid_dependencies(snapshot)
          tasks = snapshot.fetch("tasks", {})
          all_items = Array(tasks["items"])
          active_items = active_work_items(tasks)
          by_id = all_items.each_with_object({}) { |task, out| out[task["id"].to_s] = task }
          selected = {}
          edges = []

          active_items.each do |task|
            selected[task["id"].to_s] = task
            Array(task["depends_on"]).each do |dependency|
              dep_id = dependency.to_s
              selected[dep_id] = by_id[dep_id] || { "id" => dep_id, "title" => "external dependency", "status" => "unknown" }
              edges << [dep_id, task["id"].to_s]
            end
            Array(task["blocks"]).each do |blocked|
              blocked_id = blocked.to_s
              selected[blocked_id] = by_id[blocked_id] || { "id" => blocked_id, "title" => "external blocked task", "status" => "unknown" }
              edges << [task["id"].to_s, blocked_id]
            end
          end

          puts "flowchart LR"
          selected.values.sort_by { |task| task["id"].to_s }.each do |task|
            node = mermaid_id("T", task["id"])
            puts "  #{node}[\"#{mermaid_label(task["id"], shorten(task["title"], 36), task["status"])}\"]"
          end
          edges.uniq.each do |from, to|
            puts "  #{mermaid_id("T", from)} --> #{mermaid_id("T", to)}"
          end
          selected.values.each do |task|
            puts "  class #{mermaid_id("T", task["id"])} #{mermaid_task_class(task)}"
          end
          puts ""
          puts mermaid_class_defs
        end

        def render_mermaid_workflow(snapshot)
          tasks = snapshot.fetch("tasks", {})
          workflow = snapshot.fetch("workflow", {})
          edges = Array(workflow["transitions"]).map { |edge| [edge["from"].to_s, edge["to"].to_s] }.reject { |from, to| from.empty? || to.empty? }
          if edges.empty?
            edges = [
              %w[proposed scoped],
              %w[scoped approved],
              %w[approved in_progress],
              %w[in_progress verification_ready],
              %w[verification_ready verification_in_progress],
              %w[verification_in_progress verification_passed],
              %w[verification_passed completion_review],
              %w[completion_review done],
              %w[in_progress blocked],
              %w[verification_ready blocked],
              %w[verification_in_progress rework_requested],
              %w[completion_review rework_requested],
              %w[proposed cancelled],
              %w[scoped cancelled]
            ]
          end
          active_items = sorted_work_items(active_work_items(tasks))
          statuses = (Array(workflow["statuses"]).map(&:to_s) + edges.flatten + active_items.map { |task| task["status"].to_s }).reject(&:empty?).uniq
          puts "flowchart LR"
          statuses.each do |status|
            puts "  #{mermaid_id("S", status)}[\"#{status}\"]"
          end
          edges.each do |from, to|
            puts "  #{mermaid_id("S", from)} --> #{mermaid_id("S", to)}"
          end
          active_items.each do |task|
            task_node = mermaid_id("T", task["id"])
            status_node = mermaid_id("S", task["status"])
            puts "  #{task_node}[\"#{mermaid_label(task["id"], shorten(task["title"], 30))}\"] --> #{status_node}"
            puts "  class #{task_node} #{mermaid_task_class(task)}"
          end
          statuses.each do |status|
            node_class = %w[blocked rework_requested].include?(status) ? "blocked" : "workflow"
            node_class = "cancelled" if status == "cancelled"
            puts "  class #{mermaid_id("S", status)} #{node_class}"
          end
          puts ""
          puts mermaid_class_defs
        end

        def render_mermaid_agents(snapshot)
          tasks = snapshot.fetch("tasks", {})
          items = sorted_work_items(active_work_items(tasks))
          edges = []
          nodes = {}
          classes = {}
          puts "flowchart LR"
          items.each do |task|
            agent = clean(task["target_agent"])
            role = clean(task["target_role"])
            agent_node = mermaid_id("A", agent)
            role_node = mermaid_id("R", role)
            task_node = mermaid_id("T", task["id"])
            nodes[agent_node] = agent
            nodes[role_node] = role
            nodes[task_node] = mermaid_label(task["id"], task["status"])
            classes[agent_node] = "agent"
            classes[role_node] = "role"
            classes[task_node] = mermaid_task_class(task)
            edges << [agent_node, role_node]
            edges << [role_node, task_node]
          end
          if items.empty?
            none_node = mermaid_id("A", "none")
            nodes[none_node] = "no active work"
            classes[none_node] = "done"
          end
          nodes.each do |node, label|
            puts "  #{node}[\"#{label}\"]"
          end
          edges.uniq.each { |from, to| puts "  #{from} --> #{to}" }
          classes.each { |node, node_class| puts "  class #{node} #{node_class}" }
          puts ""
          puts mermaid_class_defs
        end

        def render_mermaid_blockers(snapshot, health_summary)
          project = snapshot.fetch("project", {})
          checks = Array(health_summary["checks"]).select { |check| %w[blocker warn].include?(check["level"].to_s) }
          project_node = "P_project"
          puts "flowchart TD"
          puts "  #{project_node}[\"#{mermaid_label(project["name"] || File.basename(snapshot["target"].to_s), health_summary["overall"])}\"]"
          if checks.empty?
            ok_node = "C_none"
            puts "  #{ok_node}[\"no blockers or warnings\"]"
            puts "  #{project_node} --> #{ok_node}"
            puts "  class #{ok_node} done"
          else
            checks.each do |check|
              check_node = mermaid_id("C", check["code"])
              level = check["level"].to_s == "blocker" ? "blocked" : "warning"
              puts "  #{check_node}[\"#{mermaid_label(check["code"], shorten(check["message"], 48))}\"]"
              puts "  #{project_node} --> #{check_node}"
              puts "  class #{check_node} #{level}"
              Array(check.dig("evidence", "tasks")).each do |task_id|
                task_node = mermaid_id("T", task_id)
                puts "  #{task_node}[\"#{mermaid_label(task_id)}\"]"
                puts "  #{check_node} --> #{task_node}"
                puts "  class #{task_node} unknown"
              end
            end
          end
          puts ""
          puts mermaid_class_defs
        end

        def render_work_mermaid(snapshot, health_summary, map)
          case map
          when "dependencies"
            render_mermaid_dependencies(snapshot)
          when "workflow"
            render_mermaid_workflow(snapshot)
          when "agents"
            render_mermaid_agents(snapshot)
          when "blockers"
            render_mermaid_blockers(snapshot, health_summary)
          end
        end

        def dashboard_task_item(task, target)
          {
            "id" => task["id"],
            "title" => task["title"],
            "status" => task["status"],
            "status_class" => mermaid_task_class(task),
            "workflow" => task["workflow"],
            "target_role" => task["target_role"],
            "target_agent" => task["target_agent"],
            "locked_by" => task["locked_by"],
            "lock_state" => clean(task["locked_by"], "none") == "none" ? "none" : "locked",
            "branch" => task["branch"],
            "worktree" => task["worktree"],
            "depends_on" => Array(task["depends_on"]),
            "blocks" => Array(task["blocks"]),
            "allowed_paths" => Array(task["allowed_paths"]),
            "source_of_truth" => Array(task["source_of_truth"]),
            "report_to" => task["report_to"],
            "qa_to" => task["qa_to"],
            "path" => task["path"],
            "next" => {
              "action" => next_action_label(task),
              "command" => next_role_command(task, target)
            }
          }
        end

        def dependency_map_data(snapshot)
          tasks = snapshot.fetch("tasks", {})
          all_items = Array(tasks["items"])
          active_items = active_work_items(tasks)
          by_id = all_items.each_with_object({}) { |task, out| out[task["id"].to_s] = task }
          selected = {}
          edges = []

          active_items.each do |task|
            selected[task["id"].to_s] = task
            Array(task["depends_on"]).each do |dependency|
              dep_id = dependency.to_s
              selected[dep_id] = by_id[dep_id] || { "id" => dep_id, "title" => "external dependency", "status" => "unknown" }
              edges << { "from" => dep_id, "to" => task["id"].to_s, "type" => "depends_on" }
            end
            Array(task["blocks"]).each do |blocked|
              blocked_id = blocked.to_s
              selected[blocked_id] = by_id[blocked_id] || { "id" => blocked_id, "title" => "external blocked task", "status" => "unknown" }
              edges << { "from" => task["id"].to_s, "to" => blocked_id, "type" => "blocks" }
            end
          end

          {
            "type" => "dependencies",
            "direction" => "LR",
            "nodes" => selected.values.sort_by { |task| task["id"].to_s }.map do |task|
              { "id" => mermaid_id("T", task["id"]), "task_id" => task["id"].to_s, "label" => mermaid_label(task["id"], shorten(task["title"], 36), task["status"]), "class" => mermaid_task_class(task) }
            end,
            "edges" => edges.uniq
          }
        end

        def workflow_map_data(snapshot)
          tasks = snapshot.fetch("tasks", {})
          workflow = snapshot.fetch("workflow", {})
          transitions = Array(workflow["transitions"]).map { |edge| { "from" => edge["from"].to_s, "to" => edge["to"].to_s, "next_role" => edge["next_role"] } }.reject { |edge| edge["from"].empty? || edge["to"].empty? }
          active_items = sorted_work_items(active_work_items(tasks))
          statuses = (Array(workflow["statuses"]).map(&:to_s) + transitions.flat_map { |edge| [edge["from"], edge["to"]] } + active_items.map { |task| task["status"].to_s }).reject(&:empty?).uniq
          {
            "type" => "workflow",
            "direction" => "LR",
            "statuses" => statuses.map do |status|
              node_class = %w[blocked rework_requested].include?(status) ? "blocked" : "workflow"
              node_class = "cancelled" if status == "cancelled"
              { "id" => mermaid_id("S", status), "status" => status, "class" => node_class }
            end,
            "transitions" => transitions,
            "task_positions" => active_items.map do |task|
              { "task_id" => task["id"], "task_node_id" => mermaid_id("T", task["id"]), "status" => task["status"], "status_node_id" => mermaid_id("S", task["status"]), "class" => mermaid_task_class(task) }
            end
          }
        end

        def agent_map_data(snapshot)
          tasks = snapshot.fetch("tasks", {})
          items = sorted_work_items(active_work_items(tasks))
          nodes = {}
          edges = []

          items.each do |task|
            agent = clean(task["target_agent"])
            role = clean(task["target_role"])
            agent_node = mermaid_id("A", agent)
            role_node = mermaid_id("R", role)
            task_node = mermaid_id("T", task["id"])
            nodes[agent_node] = { "id" => agent_node, "label" => agent, "kind" => "agent", "class" => "agent" }
            nodes[role_node] = { "id" => role_node, "label" => role, "kind" => "role", "class" => "role" }
            nodes[task_node] = { "id" => task_node, "label" => mermaid_label(task["id"], task["status"]), "kind" => "task", "task_id" => task["id"], "class" => mermaid_task_class(task) }
            edges << { "from" => agent_node, "to" => role_node, "type" => "agent_role" }
            edges << { "from" => role_node, "to" => task_node, "type" => "role_task" }
          end

          if items.empty?
            none_node = mermaid_id("A", "none")
            nodes[none_node] = { "id" => none_node, "label" => "no active work", "kind" => "empty", "class" => "done" }
          end

          {
            "type" => "agents",
            "direction" => "LR",
            "nodes" => nodes.values,
            "edges" => edges.uniq
          }
        end

        def blocker_map_data(snapshot, health_summary)
          project = snapshot.fetch("project", {})
          checks = Array(health_summary["checks"]).select { |check| %w[blocker warn].include?(check["level"].to_s) }
          project_node = { "id" => "P_project", "label" => mermaid_label(project["name"] || File.basename(snapshot["target"].to_s), health_summary["overall"]), "kind" => "project", "class" => health_summary["overall"] == "blocked" ? "blocked" : "warning" }
          nodes = [project_node]
          edges = []

          if checks.empty?
            nodes << { "id" => "C_none", "label" => "no blockers or warnings", "kind" => "check", "class" => "done" }
            edges << { "from" => "P_project", "to" => "C_none", "type" => "status" }
          else
            checks.each do |check|
              check_node = mermaid_id("C", check["code"])
              node_class = check["level"].to_s == "blocker" ? "blocked" : "warning"
              nodes << { "id" => check_node, "label" => mermaid_label(check["code"], shorten(check["message"], 48)), "kind" => "check", "code" => check["code"], "level" => check["level"], "class" => node_class }
              edges << { "from" => "P_project", "to" => check_node, "type" => check["level"] }
              Array(check.dig("evidence", "tasks")).each do |task_id|
                task_node = mermaid_id("T", task_id)
                nodes << { "id" => task_node, "label" => mermaid_label(task_id), "kind" => "task", "task_id" => task_id, "class" => "unknown" }
                edges << { "from" => check_node, "to" => task_node, "type" => "evidence" }
              end
            end
          end

          {
            "type" => "blockers",
            "direction" => "TD",
            "nodes" => nodes.uniq { |node| node["id"] },
            "edges" => edges.uniq
          }
        end

        def dashboard_projection(snapshot, health_summary, view, level, format, map)
          project = snapshot.fetch("project", {})
          tasks = snapshot.fetch("tasks", {})
          task_status = tasks.fetch("by_status", {})
          total_tasks = tasks["total"].to_i
          done_tasks = task_status["done"].to_i
          active_items = sorted_work_items(active_work_items(tasks))
          warning_checks = Array(health_summary["checks"]).select { |check| check["level"] == "warn" }
          blocker_checks = Array(health_summary["checks"]).select { |check| check["level"] == "blocker" }
          readiness_source = health_summary.fetch("readiness", {})
          source_refs = snapshot.fetch("source_refs", {})
          agents = Array(value(snapshot, "agents", "active"))
          enabled_agents = agents.count { |agent| agent["status"] == "enabled" }
          deferred_agents = agents.count { |agent| agent["status"] == "deferred" }
          ratio = total_tasks.positive? ? done_tasks.to_f / total_tasks : 0.0

          {
            "schema" => "aiops.project_dashboard.v1",
            "generated_at" => snapshot["generated_at"],
            "target" => snapshot["target"],
            "view" => view,
            "level" => level,
            "format" => format,
            "map" => map,
            "project" => {
              "name" => project["name"] || File.basename(snapshot["target"].to_s),
              "core_version" => snapshot["core_version"],
              "recorded_core_version" => project["recorded_core_version"],
              "operating_mode" => project["operating_mode"],
              "workflow_policy" => project["workflow_policy"],
              "knowledge_mode" => project["knowledge_mode"]
            },
            "status" => {
              "overall" => health_summary["overall"] || snapshot.dig("health", "overall"),
              "blockers" => health_summary.dig("summary", "blockers").to_i,
              "warnings" => health_summary.dig("summary", "warnings").to_i
            },
            "progress" => {
              "total_tasks" => total_tasks,
              "done_tasks" => done_tasks,
              "active_tasks" => tasks["active"].to_i,
              "done_ratio" => ratio.round(4)
            },
            "readiness" => {
              "bootstrap" => readiness_source["bootstrap"],
              "task_work" => readiness_source["task_work"],
              "multi_agent" => readiness_source["multi_agent"],
              "migration" => readiness_source["migration"]
            },
            "git" => {
              "branch" => source_refs["local_branch"],
              "head" => source_refs["local_head"],
              "canonical_status_ref" => source_refs["canonical_status_ref"],
              "canonical_status_sha" => source_refs["canonical_status_sha"],
              "recorded_status_sha" => source_refs["recorded_status_sha"],
              "status_ref_state" => source_refs["status_ref_state"]
            },
            "agents" => {
              "enabled" => enabled_agents,
              "deferred" => deferred_agents,
              "total" => agents.length,
              "active_roles" => Array(value(snapshot, "agents", "active_roles")),
              "items" => agents
            },
            "tasks" => {
              "total" => total_tasks,
              "active" => tasks["active"].to_i,
              "by_status" => task_status,
              "items" => Array(tasks["items"]).map { |task| dashboard_task_item(task, snapshot["target"]) },
              "active_items" => active_items.map { |task| dashboard_task_item(task, snapshot["target"]) }
            },
            "risks" => {
              "blockers" => blocker_checks,
              "warnings" => warning_checks
            },
            "control" => snapshot["control"],
            "next" => Array(snapshot["next"]),
            "maps" => {
              "dependencies" => dependency_map_data(snapshot),
              "workflow" => workflow_map_data(snapshot),
              "agents" => agent_map_data(snapshot),
              "blockers" => blocker_map_data(snapshot, health_summary)
            }
          }
        end

        project = snapshot.fetch("project", {})
        health = health_summary.fetch("summary", {})
        health_status = health_summary.fetch("overall", snapshot.fetch("health", {})["overall"])
        source_refs = snapshot.fetch("source_refs", {})
        tasks = snapshot.fetch("tasks", {})
        task_status = tasks.fetch("by_status", {})
        readiness_source = health_summary.fetch("readiness", {})
        readiness = {
          "Bootstrap" => readiness_source["bootstrap"],
          "Task Work" => readiness_source["task_work"],
          "Multi-agent" => readiness_source["multi_agent"],
          "Migration" => readiness_source["migration"]
        }

        total_tasks = tasks["total"].to_i
        done_tasks = task_status["done"].to_i
        active_tasks = tasks["active"].to_i
        proposed_tasks = task_status["proposed"].to_i
        scoped_tasks = task_status["scoped"].to_i
        approved_tasks = task_status["approved"].to_i
        warning_checks = Array(health_summary["checks"]).select { |check| check["level"] == "warn" }
        blocker_checks = Array(health_summary["checks"]).select { |check| check["level"] == "blocker" }
        agents = Array(value(snapshot, "agents", "active"))
        enabled_agents = agents.count { |agent| agent["status"] == "enabled" }
        deferred_agents = agents.count { |agent| agent["status"] == "deferred" }
        active_roles = Array(value(snapshot, "agents", "active_roles")).map(&:to_s).reject(&:empty?)
        next_steps = Array(snapshot["next"]).map { |step| command_or_message(step) }.compact.uniq

        if as_json
          puts JSON.pretty_generate(dashboard_projection(snapshot, health_summary, view, level, format, map))
          exit 0
        end

        if view == "work"
          if format == "mermaid"
            render_work_mermaid(snapshot, health_summary, map)
          elsif format == "tree"
            render_work_tree(snapshot, level, color_enabled)
          else
            render_work_terminal(snapshot, level, color_enabled)
          end
          exit 0
        end

        puts colorize(color_enabled, "AI Ops Dashboard", "1;36")
        puts "Project: #{project["name"] || File.basename(snapshot["target"].to_s)}"
        puts "Status: #{status_value(color_enabled, status_label(health_status))}    Blockers: #{status_value(color_enabled, health["blockers"].to_i)}    Warnings: #{status_value(color_enabled, health["warnings"].to_i)}"
        puts "Target: #{snapshot["target"]}" if level == "detail"
        puts ""

        puts section(color_enabled, "Progress")
        puts "#{progress_bar(done_tasks, total_tasks, 30, color_enabled)}  #{done_tasks} / #{total_tasks} done"
        unless level == "compact"
          puts "Active: #{active_tasks}    Proposed: #{proposed_tasks}    Scoped: #{scoped_tasks}    Approved: #{approved_tasks}"
        end
        puts ""

        puts section(color_enabled, "Operations")
        readiness.each { |key, state| print_key_value(key, state, color_enabled) }
        print_key_value("Canonical Sync", source_refs["status_ref_state"], color_enabled)
        if level != "compact"
          print_key_value("Branch", source_refs["local_branch"], color_enabled)
          print_key_value("Head", source_refs["local_head"], color_enabled)
        end
        puts ""

        if level != "compact"
          puts section(color_enabled, "Settings")
          print_key_value("Core", "#{snapshot["core_version"]} (recorded #{project["recorded_core_version"] || "unrecorded"})", color_enabled)
          print_key_value("Operating Mode", project["operating_mode"], color_enabled)
          print_key_value("Workflow Policy", project["workflow_policy"], color_enabled)
          print_key_value("Knowledge Mode", project["knowledge_mode"], color_enabled)
          puts ""

          puts section(color_enabled, "Agents")
          puts "  Enabled: #{enabled_agents}    Deferred: #{deferred_agents}    Total: #{agents.length}"
          print_key_value("Roles", active_roles.empty? ? "none" : active_roles.join(", "), color_enabled)
          puts ""
        end

        if level == "detail"
          puts section(color_enabled, "Task Status")
          if task_status.empty?
            puts "  none"
          else
            task_status.sort.each { |key, value| print_key_value(key, value, color_enabled) }
          end
          puts ""

          blocked_actions = Array(value(snapshot, "control", "blocked_actions"))
          puts section(color_enabled, "Control")
          print_key_value("Can Start Task", value(snapshot, "control", "can_start_task"), color_enabled)
          print_key_value("Can Transition", value(snapshot, "control", "can_transition"), color_enabled)
          if blocked_actions.empty?
            puts "  Blocked Actions: none"
          else
            blocked_actions.each do |action|
              puts "  - #{action["action"]}: #{action["reason"]}"
            end
          end
          puts ""
        end

        puts blocker_checks.empty? ? "#{section(color_enabled, "Blockers")}\n  none" : section(color_enabled, "Blockers")
        blocker_checks.each { |check| puts "  - #{colorize(color_enabled, check["code"], "31")}: #{check["message"]}" }
        puts ""

        unless level == "compact"
          puts warning_checks.empty? ? "#{section(color_enabled, "Warnings")}\n  none" : section(color_enabled, "Warnings")
          warning_checks.each { |check| puts "  - #{colorize(color_enabled, check["code"], "33")}: #{check["message"]}" }
          puts ""
        end

        unless next_steps.empty?
          puts section(color_enabled, "Next")
          next_steps.first(level == "compact" ? 3 : next_steps.length).each { |step| puts "  - #{step}" }
        end
      ' "$view" "$format" "$level" "$color" "$map" "$json"
      ;;
    snapshot)
      target="$(pwd)"
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown project snapshot option: $1"
            ;;
        esac
        shift
      done

      [ "$json" = "yes" ] || die "project snapshot currently requires --json"
      target="$(abs_path "$target")"
      core="$(default_core_dir)"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for project snapshot"

      ruby -ryaml -rjson -rdate -rtime -rfind -ropen3 -rshellwords -e '
        target = ARGV[0]
        core = ARGV[1]

        def scalar_string(value)
          return nil unless value.is_a?(String) || value.is_a?(Integer) || value.is_a?(Float) || value == true || value == false
          string = value.to_s.strip
          if string.length >= 2
            quote_pairs = { 34.chr => 34.chr, 39.chr => 39.chr, 96.chr => 96.chr }
            first = string[0]
            string = string[1...-1].strip if quote_pairs[first] == string[-1]
          end
          string
        end

        def invalid_scalar?(value)
          !(value.nil? || value.is_a?(String) || value.is_a?(Integer) || value.is_a?(Float) || value == true || value == false)
        end

        def front_matter(path)
          return {} unless File.file?(path)
          text = File.read(path)
          return {} unless text.start_with?("---\n")
          lines = text.lines
          closing = nil
          lines[1..].each_with_index do |line, idx|
            if line.strip == "---"
              closing = idx + 1
              break
            end
          end
          return {} unless closing
          YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
        rescue Psych::SyntaxError
          {}
        end

        def legacy_field(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
              value = Regexp.last_match(1).strip
              return nil if value.empty?
              return value.gsub(/\A`|`\z/, "")
            end
          end
          nil
        end

        def table_value(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            next unless line.include?("|")
            cells = line.split("|").map { |cell| cell.strip.gsub(/\A`|`\z/, "") }
            next unless cells.length >= 4
            return cells[2] if cells[1] == key && !cells[2].empty?
          end
          nil
        end

        def value_from(data, path, key)
          value = data[key]
          value = legacy_field(path, key) || table_value(path, key) if value.nil? || value == ""
          return nil if value.nil?
          value = scalar_string(value)
          return nil if value.nil?
          return nil if value.empty?
          return nil if %w[null unresolved pending_decision {{CANONICAL_STATUS_REF}}].include?(value)
          value
        end

        def list(value)
          case value
          when Array then value.compact.map(&:to_s).reject(&:empty?)
          when nil then []
          else value.to_s.split(",").map(&:strip).reject(&:empty?)
          end
        end

        def git(target, *args)
          stdout, _stderr, status = Open3.capture3("git", "-C", target, *args)
          return nil unless status.success?
          stdout.strip
        end

        def git_tracked?(target, path)
          _stdout, _stderr, status = Open3.capture3("git", "-C", target, "ls-files", "--error-unmatch", path)
          status.success?
        end

        def files_under(path)
          return [] unless Dir.exist?(path)
          files = []
          Find.find(path) do |entry|
            files << entry if File.file?(entry) && File.basename(entry).end_with?(".md")
          end
          files.sort
        end

        def core_source(ai_path)
          if File.symlink?(ai_path)
            link = File.readlink(ai_path)
            if link.include?("homebrew") || link.include?("/Cellar/") || link.include?("/opt/ai-agent-ops")
              "homebrew"
            else
              "symlink"
            end
          elsif Dir.exist?(ai_path)
            "project_local_copy"
          else
            "missing"
          end
        end

        def runtime_status_ref(path)
          data = {}
          return data unless File.file?(path)
          File.foreach(path) do |line|
            key, value = line.split(":", 2)
            next unless key && value
            data[key.strip] = value.strip
          end
          data
        end

        def normalize(value)
          case value
          when Hash
            value.each_with_object({}) { |(key, item), out| out[key.to_s] = normalize(item) }
          when Array
            value.map { |item| normalize(item) }
          when Date, Time
            value.to_s
          else
            value
          end
        end

        project_dir = File.join(target, ".ai_project")
        ai_path = File.join(target, ".ai")
        operating_path = File.join(project_dir, "operating_model.md")
        registry_path = File.join(project_dir, "agent_registry.md")
        workflow_catalog_path = File.join(ai_path, "runtime", "workflows.json")
        policy_rules_path = File.join(ai_path, "runtime", "policy_rules.json")
        policy_rules_path = File.join(core, "runtime", "policy_rules.json") unless File.file?(policy_rules_path)
        operating = front_matter(operating_path)
        registry = front_matter(registry_path)

        core_version = File.file?(File.join(ai_path, "VERSION")) ? File.read(File.join(ai_path, "VERSION")).strip : "unknown"
        core = {
          "present" => File.exist?(ai_path),
          "source" => core_source(ai_path),
          "version" => core_version,
          "adapters" => {
            "codex" => File.file?(File.join(target, "AGENTS.md")),
            "claude" => File.file?(File.join(target, "CLAUDE.md"))
          }
        }

        status_ref = value_from(operating, operating_path, "canonical_status_ref")
        git_inside = git(target, "rev-parse", "--is-inside-work-tree") == "true"
        runtime_status_tracked = git_inside && git_tracked?(target, ".ai_project/.runtime/status_ref")
        local_branch = git_inside ? git(target, "rev-parse", "--abbrev-ref", "HEAD") : nil
        local_head = git_inside ? git(target, "rev-parse", "--short", "HEAD") : nil
        status_ref_sha = git_inside && status_ref ? git(target, "rev-parse", "--verify", "#{status_ref}^{commit}") : nil
        runtime_ref = runtime_status_ref(File.join(project_dir, ".runtime", "status_ref"))
        runtime_sha = runtime_ref["status_ref_sha"]
        status_ref_state =
          if !status_ref
            "unresolved"
          elsif !status_ref_sha
            "ref_not_found_locally"
          elsif runtime_sha.nil? || runtime_sha.empty?
            "not_recorded"
          elsif runtime_sha == status_ref_sha
            "recorded_current"
          else
            "recorded_stale"
          end

        tasks = files_under(File.join(project_dir, "tasks")).map do |path|
          data = front_matter(path)
          relative = path.sub(%r{\A#{Regexp.escape(target)}/?}, "")
          status = data["status"] || legacy_field(path, "status")
          {
            "id" => data["id"] || File.basename(path, ".md"),
            "title" => data["title"],
            "status" => status,
            "workflow" => data["workflow"] || legacy_field(path, "workflow"),
            "target_role" => data["target_role"] || legacy_field(path, "target_role"),
            "target_agent" => data["target_agent"] || legacy_field(path, "target_agent"),
            "depends_on" => list(data["depends_on"]),
            "blocks" => list(data["blocks"]),
            "allowed_paths" => list(data["allowed_paths"]),
            "source_of_truth" => list(data["source_of_truth"]),
            "locked_by" => data["locked_by"] || legacy_field(path, "locked_by"),
            "lock_session" => data["lock_session"] || legacy_field(path, "lock_session"),
            "status_ref" => data["status_ref"] || legacy_field(path, "status_ref"),
            "status_ref_sha" => data["status_ref_sha"] || legacy_field(path, "status_ref_sha"),
            "report_to" => data["report_to"],
            "qa_to" => data["qa_to"],
            "branch" => data["branch"],
            "worktree" => data["worktree_path"] || data["worktree"],
            "path" => relative
          }
        end

        task_counts_by_status = Hash.new(0)
        tasks.each { |task| task_counts_by_status[task["status"] || "unknown"] += 1 }
        active_tasks = tasks.select { |task| !%w[done cancelled].include?(task["status"].to_s) }
        missing_task_metadata = tasks.select { |task| task["status"].to_s.empty? || task["workflow"].to_s.empty? || task["target_role"].to_s.empty? }

        agents_raw = registry["agents"].is_a?(Array) ? registry["agents"] : []
        agents = agents_raw.map do |agent|
          next nil unless agent.is_a?(Hash)
          {
            "id" => agent["id"] || agent["agent"],
            "name" => agent["agent"] || agent["id"],
            "status" => agent["status"],
            "team" => agent["team"],
            "declared_roles" => list(agent["roles"]),
            "capabilities" => list(agent["capabilities"]),
            "current_task" => nil,
            "branch" => nil,
            "worktree" => nil,
            "drift" => []
          }
        end.compact
        active_roles = operating["active_roles"]
        unless active_roles.is_a?(Array)
          active_roles = agents_raw.flat_map { |agent| agent.is_a?(Hash) && agent["status"] == "enabled" ? Array(agent["roles"]) : [] }.uniq
        end

        workflow_catalog = nil
        if File.file?(workflow_catalog_path)
          begin
            workflow_catalog = JSON.parse(File.read(workflow_catalog_path))
          rescue JSON::ParserError
            workflow_catalog = nil
          end
        end
        default_workflow = workflow_catalog.is_a?(Hash) ? workflow_catalog["default_workflow"] : nil
        default_workflow_definition = workflow_catalog.is_a?(Hash) ? workflow_catalog.dig("workflows", default_workflow.to_s) : nil
        workflow_statuses = default_workflow_definition.is_a?(Hash) && default_workflow_definition["statuses"].is_a?(Hash) ? default_workflow_definition["statuses"].keys : []
        workflow_transitions =
          if default_workflow_definition.is_a?(Hash)
            Array(default_workflow_definition["transitions"]).map do |transition|
              next nil unless transition.is_a?(Hash)
              next nil if transition["from"].to_s.empty? || transition["to"].to_s.empty?
              {
                "from" => transition["from"],
                "to" => transition["to"],
                "next_role" => transition["next_role"]
              }
            end.compact
          else
            []
          end

        def value_at_path(data, path)
          current = data
          path.to_s.split(".").each do |part|
            return nil unless current.is_a?(Hash)
            return nil unless current.key?(part)
            current = current[part]
          end
          current
        end

        def condition_matches?(snapshot, key, expected)
          if key.start_with?("checks.")
            check_id = key.split(".", 2)[1]
            present = snapshot.fetch("checks", []).any? { |check| check.is_a?(Hash) && check["id"] == check_id }
            return present if expected == "present"
            return !present if expected == "absent"
            return present == expected if expected == true || expected == false
            return false
          end

          actual = value_at_path(snapshot, key)
          case expected
          when Array
            expected.include?(actual)
          when "present"
            !actual.nil?
          when "absent"
            actual.nil?
          else
            actual == expected
          end
        end

        def evaluate_policy(policy_rules_path, snapshot, strict_level)
          summary = { "info" => 0, "warn" => 0, "blocker" => 0 }
          unless File.file?(policy_rules_path)
            return {
              "catalog_present" => false,
              "strict_level" => strict_level,
              "matched_rules" => [],
              "summary" => summary
            }
          end

          catalog = JSON.parse(File.read(policy_rules_path))
          levels = Array(catalog["strict_levels"]).map { |level| level.is_a?(Hash) ? level["id"] : nil }.compact
          level = levels.include?(strict_level) ? strict_level : "basic"
          matched = []

          Array(catalog["rules"]).each do |rule|
            next unless rule.is_a?(Hash)
            next unless Array(rule["applies_to"]).include?(level)
            conditions = rule["when"]
            next unless conditions.is_a?(Hash) && conditions.all? { |key, expected| condition_matches?(snapshot, key, expected) }
            severity = rule["severity"].to_s
            summary[severity] += 1 if summary.key?(severity)
            evidence = {}
            conditions.each_key do |key|
              evidence[key] = key.start_with?("checks.") ? "present" : value_at_path(snapshot, key)
            end
            matched << {
              "id" => rule["id"],
              "severity" => severity,
              "message" => rule["message"],
              "source" => rule["source"],
              "evidence" => evidence
            }
          end

          {
            "catalog_present" => true,
            "strict_level" => level,
            "matched_rules" => matched,
            "summary" => summary
          }
        rescue JSON::ParserError
          {
            "catalog_present" => false,
            "strict_level" => strict_level,
            "matched_rules" => [],
            "summary" => summary
          }
        end

        def conditional_project_file_required?(file_name, project)
          case file_name
          when "branch_pr_strategy.md"
            value = project["branch_pr"].to_s
            !value.empty? && !%w[null unresolved pending pending_decision none unknown].include?(value)
          when "workflow_overrides.md"
            project["workflow_policy"].to_s == "custom" ||
              project["workflow_override"].to_s == "true" ||
              project["workflow_overrides"].to_s == "true"
          when "ops_migration_plan.md"
            bootstrap_mode = project["bootstrap_mode"].to_s
            bootstrap_mode == "migrated" || bootstrap_mode.include?("migration")
          else
            true
          end
        end

        def conditional_project_file_reason(file_name, project)
          case file_name
          when "branch_pr_strategy.md"
            "branch_pr #{project["branch_pr"] || "pending_decision"}"
          when "workflow_overrides.md"
            "workflow_policy #{project["workflow_policy"] || "unknown"}"
          when "ops_migration_plan.md"
            "bootstrap_mode #{project["bootstrap_mode"] || "unknown"}"
          else
            "conditional project file"
          end
        end

        project = {
          "present" => Dir.exist?(project_dir),
          "name" => value_from(operating, operating_path, "project") || File.basename(target),
          "policy_level" => value_from(operating, operating_path, "policy_level") || "basic",
          "bootstrap_mode" => value_from(operating, operating_path, "bootstrap_mode") || "unknown",
          "recorded_core_version" => value_from(operating, operating_path, "core_version"),
          "start_context" => value_from(operating, operating_path, "start_context") || "unknown",
          "readiness_level" => value_from(operating, operating_path, "readiness_level") || "unknown",
          "operating_mode" => value_from(operating, operating_path, "operating_mode") || "unknown",
          "team_pattern" => value_from(operating, operating_path, "team_pattern") || "unknown",
          "workflow_policy" => value_from(operating, operating_path, "workflow_policy") || "unknown",
          "workflow_override" => value_from(operating, operating_path, "workflow_override"),
          "workflow_overrides" => value_from(operating, operating_path, "workflow_overrides"),
          "ownership_model" => value_from(operating, operating_path, "ownership_model") || "unknown",
          "coordination" => value_from(operating, operating_path, "coordination") || "unknown",
          "board_model" => value_from(operating, operating_path, "board_model") || "unknown",
          "branch_pr" => value_from(operating, operating_path, "branch_pr") || "pending_decision",
          "knowledge_mode" => value_from(operating, operating_path, "knowledge_mode") || "unknown"
        }

        checks = []
        add_check = lambda do |id, severity, confidence, message, evidence = {}|
          checks << {
            "id" => id,
            "severity" => severity,
            "confidence" => confidence,
            "message" => message,
            "evidence" => evidence
          }
        end

        if core["present"]
          add_check.call("core_connected", "info", "high", ".ai core is connected", { "source" => core["source"], "version" => core["version"] })
        else
          add_check.call("core_missing", "blocker", "high", ".ai core missing; run aiops seed first", { "path" => ".ai" })
        end

        if core["adapters"]["codex"] || core["adapters"]["claude"]
          add_check.call("adapter_present", "info", "high", "at least one Agent adapter exists", core["adapters"])
        else
          add_check.call("adapter_missing", "warn", "high", "AGENTS.md or CLAUDE.md adapter is missing", { "expected" => ["AGENTS.md", "CLAUDE.md"] })
        end

        if project["present"]
          add_check.call("project_config_present", "info", "high", ".ai_project exists", { "path" => ".ai_project" })
        else
          add_check.call("project_config_missing", "blocker", "high", ".ai_project missing; run bootstrap first", { "path" => ".ai_project" })
        end

        if project["present"]
          required_files = %w[
            operating_model.md
            agent_registry.md
            current_context.md
            source_of_truth.md
            task_board.md
            ops_decisions.md
            ops_issues.md
          ]
          required_files.each do |name|
            path = File.join(project_dir, name)
            if File.file?(path)
              add_check.call("required_file_present", "info", "high", ".ai_project/#{name} exists", { "path" => ".ai_project/#{name}" })
            else
              add_check.call("required_file_missing", "blocker", "high", ".ai_project/#{name} missing", { "path" => ".ai_project/#{name}" })
            end
          end

          %w[tasks tasks/active tasks/backlog tasks/archive].each do |name|
            path = File.join(project_dir, name)
            if Dir.exist?(path)
              add_check.call("required_dir_present", "info", "high", ".ai_project/#{name} exists", { "path" => ".ai_project/#{name}" })
            else
              add_check.call("required_dir_missing", "blocker", "high", ".ai_project/#{name} missing", { "path" => ".ai_project/#{name}" })
            end
          end

          %w[branch_pr_strategy.md workflow_overrides.md ops_migration_plan.md].each do |name|
            path = File.join(project_dir, name)
            if conditional_project_file_required?(name, project)
              if File.file?(path)
                add_check.call("required_file_present", "info", "high", ".ai_project/#{name} exists", {
                  "path" => ".ai_project/#{name}",
                  "conditional" => true
                })
              else
                add_check.call("required_file_missing", "blocker", "high", ".ai_project/#{name} missing", {
                  "path" => ".ai_project/#{name}",
                  "conditional" => true,
                  "reason" => conditional_project_file_reason(name, project)
                })
              end
            elsif File.exist?(path)
              add_check.call("optional_file_present", "info", "medium", ".ai_project/#{name} exists", { "path" => ".ai_project/#{name}" })
            else
              add_check.call("conditional_file_not_required", "info", "medium", ".ai_project/#{name} not required", {
                "path" => ".ai_project/#{name}",
                "reason" => conditional_project_file_reason(name, project)
              })
            end
          end
        end

        if File.file?(workflow_catalog_path) && workflow_catalog.is_a?(Hash) && workflow_catalog["schema"] == "aiops.workflow_catalog.v1"
          add_check.call("workflow_catalog_present", "info", "high", "workflow catalog is readable", { "path" => ".ai/runtime/workflows.json" })
        elsif core["present"]
          add_check.call("workflow_catalog_missing", "blocker", "high", "workflow catalog missing or unreadable", { "path" => ".ai/runtime/workflows.json" })
        end

        if project["present"] && project["recorded_core_version"] && core_version != "unknown" && project["recorded_core_version"] != core_version
          add_check.call("core_version_drift", "warn", "high", ".ai_project core_version differs from current core", {
            "recorded_core_version" => project["recorded_core_version"],
            "core_version" => core_version
          })
        end

        if project["present"]
          %w[project operating_mode workflow_policy].each do |key|
            raw_value = operating[key]
            if invalid_scalar?(raw_value)
              add_check.call("project_field_type_invalid", "warn", "high", "operating_model #{key} is not a scalar; snapshot normalized it", {
                "path" => ".ai_project/operating_model.md",
                "field" => key,
                "raw_type" => raw_value.class.name,
                "normalized_value" => key == "project" ? project["name"] : project[key]
              })
            end
          end

          if runtime_status_tracked
            add_check.call("runtime_status_ref_tracked", "warn", "high", ".ai_project/.runtime/status_ref is tracked; remove it from Git and keep .ai_project/.runtime/ ignored", {
              "path" => ".ai_project/.runtime/status_ref",
              "expected_ignore" => ".ai_project/.runtime/"
            })
          end

          case status_ref_state
          when "unresolved"
            add_check.call("canonical_status_ref_unresolved", "warn", "medium", "canonical_status_ref is unresolved", { "source" => ".ai_project/operating_model.md" })
          when "ref_not_found_locally"
            add_check.call("canonical_status_ref_unavailable", "blocker", "high", "canonical_status_ref cannot be resolved locally", { "canonical_status_ref" => status_ref })
          when "not_recorded"
            add_check.call("canonical_status_not_recorded", "warn", "high", "canonical status SHA is not recorded; run aiops sync-status", { "canonical_status_ref" => status_ref, "canonical_status_sha" => status_ref_sha })
          when "recorded_stale"
            add_check.call("canonical_status_stale", "warn", "high", "canonical status SHA is stale", {
              "recorded_status_sha" => runtime_sha,
              "canonical_status_sha" => status_ref_sha,
              "source" => ".ai_project/.runtime/status_ref"
            })
          when "recorded_current"
            add_check.call("canonical_status_current", "info", "high", "recorded canonical status SHA is current", { "canonical_status_sha" => status_ref_sha })
          end
        end

        if missing_task_metadata.empty?
          add_check.call("task_metadata_present", "info", "medium", "task metadata is present or no tasks are registered", { "tasks" => tasks.length })
        else
          add_check.call("task_metadata_incomplete", "warn", "high", "#{missing_task_metadata.length} task(s) missing status, workflow, or target_role", {
            "tasks" => missing_task_metadata.map { |task| task["id"] }
          })
        end

        blockers = checks.count { |check| check["severity"] == "blocker" }
        warnings = checks.count { |check| check["severity"] == "warn" }
        overall = blockers.positive? ? "blocked" : (warnings.positive? ? "warning" : "ok")
        stale_canonical = %w[ref_not_found_locally not_recorded recorded_stale].include?(status_ref_state)
        can_start_task = blockers.zero? && project["present"]
        can_transition = can_start_task && !stale_canonical

        blocked_actions = []
        unless can_start_task
          blocked_actions << {
            "action" => "task_start",
            "reason" => "project setup has blockers",
            "evidence" => { "blockers" => checks.select { |check| check["severity"] == "blocker" }.map { |check| check["id"] } }
          }
        end
        unless can_transition
          reason = stale_canonical ? "canonical status ref is not current" : "project setup has blockers"
          blocked_actions << {
            "action" => "task_transition",
            "reason" => reason,
            "evidence" => {
              "status_ref_state" => status_ref_state,
              "canonical_status_ref" => status_ref,
              "canonical_status_sha" => status_ref_sha,
              "recorded_status_sha" => runtime_sha
            }
          }
        end

        next_steps = []
        escaped_target = Shellwords.escape(target)
        unless core["present"]
          next_steps << {
            "audience" => "agent",
            "action" => "seed_project",
            "command" => "aiops seed --target #{escaped_target} --adapter both"
          }
          next_steps << {
            "audience" => "user",
            "action" => "approve_seed",
            "message" => "AI Ops core가 연결되지 않았습니다. seed 설치가 필요합니다."
          }
        end
        unless project["present"]
          next_steps << {
            "audience" => "agent",
            "action" => "bootstrap_project",
            "command" => "aiops bootstrap-guide --target #{escaped_target}"
          }
          next_steps << {
            "audience" => "user",
            "action" => "start_bootstrap",
            "message" => ".ai_project 구성이 없습니다. bootstrap을 진행해야 합니다."
          }
        end
        if project["present"] && %w[not_recorded recorded_stale].include?(status_ref_state)
          next_steps << {
            "audience" => "agent",
            "action" => "sync_status",
            "command" => "aiops sync-status --target #{escaped_target}"
          }
          next_steps << {
            "audience" => "user",
            "action" => "approve_sync",
            "message" => "공용 상태 기준 SHA 기록이 최신이 아닙니다. 상태 동기화를 권장합니다."
          }
        end
        if checks.any? { |check| check["severity"] != "info" }
          next_steps << {
            "audience" => "agent",
            "action" => "validate_project",
            "command" => "aiops validate project --target #{escaped_target} --strict"
          }
        end

        snapshot = normalize({
          "schema" => "aiops.project_snapshot.v1",
          "core_version" => core_version,
          "generated_at" => Time.now.utc.iso8601,
          "target" => target,
          "source_refs" => {
            "inside_worktree" => git_inside,
            "local_branch" => local_branch,
            "local_head" => local_head,
            "canonical_status_ref" => status_ref,
            "canonical_status_sha" => status_ref_sha,
            "recorded_status_ref" => runtime_ref["status_ref"],
            "recorded_status_sha" => runtime_sha,
            "recorded_checked_at" => runtime_ref["checked_at"],
            "status_ref_state" => status_ref_state
          },
          "core" => core,
          "project" => project,
          "agents" => {
            "count" => agents.length,
            "active_roles" => active_roles || [],
            "active" => agents
          },
          "tasks" => {
            "total" => tasks.length,
            "active" => active_tasks.length,
            "by_status" => task_counts_by_status.sort.to_h,
            "items" => tasks
          },
          "workflow" => {
            "catalog_present" => workflow_catalog.is_a?(Hash),
            "default_workflow" => default_workflow,
            "catalog_schema" => workflow_catalog.is_a?(Hash) ? workflow_catalog["schema"] : nil,
            "statuses" => workflow_statuses,
            "transitions" => workflow_transitions
          },
          "policy" => {
            "catalog_present" => false,
            "strict_level" => project["policy_level"],
            "matched_rules" => [],
            "summary" => { "info" => 0, "warn" => 0, "blocker" => 0 }
          },
          "health" => {
            "overall" => overall,
            "warnings" => warnings,
            "blockers" => blockers
          },
          "control" => {
            "can_start_task" => can_start_task,
            "can_transition" => can_transition,
            "can_commit" => false,
            "can_push" => false,
            "can_merge" => false,
            "requires_user_approval" => ["commit", "push", "create_pr", "merge", "deploy", "external_configuration_changes"],
            "blocked_actions" => blocked_actions
          },
          "checks" => checks,
          "next" => next_steps
        })
        snapshot["policy"] = evaluate_policy(policy_rules_path, snapshot, project["policy_level"])

        puts JSON.pretty_generate(snapshot)
      ' "$target" "$core"
      ;;
    inspect)
      target="$(pwd)"
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown project inspect option: $1"
            ;;
        esac
        shift
      done

      target="$(abs_path "$target")"
      if command -v ruby >/dev/null 2>&1; then
        ruby -ryaml -rjson -rdate -rtime -rfind -ropen3 -e '
          target = ARGV[0]
          json = ARGV[1] == "yes"

          def scalar_string(value)
            return nil unless value.is_a?(String) || value.is_a?(Integer) || value.is_a?(Float) || value == true || value == false
            string = value.to_s.strip
            if string.length >= 2
              quote_pairs = { 34.chr => 34.chr, 39.chr => 39.chr, 96.chr => 96.chr }
              first = string[0]
              string = string[1...-1].strip if quote_pairs[first] == string[-1]
            end
            string
          end

          def front_matter(path)
            return {} unless File.file?(path)
            text = File.read(path)
            return {} unless text.start_with?("---\n")
            lines = text.lines
            closing = nil
            lines[1..].each_with_index do |line, idx|
              if line.strip == "---"
                closing = idx + 1
                break
              end
            end
            return {} unless closing
            YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
          rescue Psych::SyntaxError
            {}
          end

          def legacy_field(path, key)
            return nil unless File.file?(path)
            File.foreach(path) do |line|
              if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
                value = Regexp.last_match(1).strip
                return nil if value.empty?
                return value.gsub(/\A`|`\z/, "")
              end
            end
            nil
          end

          def table_value(path, key)
            return nil unless File.file?(path)
            File.foreach(path) do |line|
              next unless line.include?("|")
              cells = line.split("|").map { |cell| cell.strip.gsub(/\A`|`\z/, "") }
              next unless cells.length >= 4
              return cells[2] if cells[1] == key && !cells[2].empty?
            end
            nil
          end

          def value_from(data, path, key)
            value = data[key]
            if value.nil? || value == ""
              value = legacy_field(path, key) || table_value(path, key)
            end
            return nil if value.nil?
            value = scalar_string(value)
            return nil if value.nil?
            return nil if value.empty?
            return nil if %w[null unresolved pending_decision {{CANONICAL_STATUS_REF}}].include?(value)
            value
          end

          def normalize(value)
            case value
            when Hash
              value.each_with_object({}) { |(key, item), out| out[key.to_s] = normalize(item) }
            when Array
              value.map { |item| normalize(item) }
            when Date, Time
              value.to_s
            else
              value
            end
          end

          def git(target, *args)
            stdout, _stderr, status = Open3.capture3("git", "-C", target, *args)
            return nil unless status.success?
            stdout.strip
          end

          def files_under(path)
            return [] unless Dir.exist?(path)
            files = []
            Find.find(path) do |entry|
              files << entry if File.file?(entry) && File.basename(entry).end_with?(".md")
            end
            files.sort
          end

          def core_source(ai_path)
            if File.symlink?(ai_path)
              link = File.readlink(ai_path)
              if link.include?("homebrew") || link.include?("/Cellar/") || link.include?("/opt/ai-agent-ops")
                "homebrew"
              else
                "symlink"
              end
            elsif Dir.exist?(ai_path)
              "project_local_copy"
            else
              "missing"
            end
          end

          def runtime_status_ref(path)
            data = {}
            return data unless File.file?(path)
            File.foreach(path) do |line|
              key, value = line.split(":", 2)
              next unless key && value
              data[key.strip] = value.strip
            end
            data
          end

          project_dir = File.join(target, ".ai_project")
          ai_path = File.join(target, ".ai")
          operating_path = File.join(project_dir, "operating_model.md")
          registry_path = File.join(project_dir, "agent_registry.md")
          operating = front_matter(operating_path)
          registry = front_matter(registry_path)

          core = {
            "present" => File.exist?(ai_path),
            "source" => core_source(ai_path),
            "version" => File.file?(File.join(ai_path, "VERSION")) ? File.read(File.join(ai_path, "VERSION")).strip : "unknown",
            "adapters" => {
              "codex" => File.file?(File.join(target, "AGENTS.md")),
              "claude" => File.file?(File.join(target, "CLAUDE.md"))
            }
          }

          status_ref = value_from(operating, operating_path, "canonical_status_ref")
          git_inside = git(target, "rev-parse", "--is-inside-work-tree") == "true"
          git_branch = git_inside ? git(target, "rev-parse", "--abbrev-ref", "HEAD") : nil
          git_head = git_inside ? git(target, "rev-parse", "--short", "HEAD") : nil
          status_ref_sha = git_inside && status_ref ? git(target, "rev-parse", "--verify", "#{status_ref}^{commit}") : nil
          runtime_ref = runtime_status_ref(File.join(project_dir, ".runtime", "status_ref"))
          runtime_sha = runtime_ref["status_ref_sha"]
          status_ref_state =
            if !status_ref
              "unresolved"
            elsif !status_ref_sha
              "ref_not_found_locally"
            elsif runtime_sha.nil? || runtime_sha.empty?
              "not_recorded"
            elsif runtime_sha == status_ref_sha
              "recorded_current"
            else
              "recorded_stale"
            end

          tasks = files_under(File.join(project_dir, "tasks")).map do |path|
            data = front_matter(path)
            relative = path.sub(%r{\A#{Regexp.escape(target)}/?}, "")
            queue = relative[%r{\.ai_project/tasks/([^/]+)/}, 1] || "unknown"
            {
              "id" => data["id"] || File.basename(path, ".md"),
              "title" => data["title"],
              "status" => data["status"] || legacy_field(path, "status"),
              "workflow" => data["workflow"] || legacy_field(path, "workflow"),
              "target_role" => data["target_role"] || legacy_field(path, "target_role"),
              "target_agent" => data["target_agent"] || legacy_field(path, "target_agent"),
              "queue" => queue,
              "path" => relative
            }
          end

          task_counts_by_queue = Hash.new(0)
          task_counts_by_status = Hash.new(0)
          tasks.each do |task|
            task_counts_by_queue[task["queue"] || "unknown"] += 1
            task_counts_by_status[task["status"] || "unknown"] += 1
          end

          agents = registry["agents"].is_a?(Array) ? registry["agents"] : []
          active_roles = operating["active_roles"]
          unless active_roles.is_a?(Array)
            active_roles = agents.flat_map { |agent| agent.is_a?(Hash) && agent["status"] == "enabled" ? Array(agent["roles"]) : [] }.uniq
          end

          project = {
            "present" => Dir.exist?(project_dir),
            "name" => value_from(operating, operating_path, "project") || File.basename(target),
            "bootstrap_mode" => value_from(operating, operating_path, "bootstrap_mode") || "unknown",
            "core_version" => value_from(operating, operating_path, "core_version") || "unknown",
            "start_context" => value_from(operating, operating_path, "start_context") || "unknown",
            "readiness_level" => value_from(operating, operating_path, "readiness_level") || "unknown",
            "operating_mode" => value_from(operating, operating_path, "operating_mode") || "unknown",
            "team_pattern" => value_from(operating, operating_path, "team_pattern") || "unknown",
            "workflow_policy" => value_from(operating, operating_path, "workflow_policy") || "unknown",
            "ownership_model" => value_from(operating, operating_path, "ownership_model") || "unknown",
            "coordination" => value_from(operating, operating_path, "coordination") || "unknown",
            "board_model" => value_from(operating, operating_path, "board_model") || "unknown",
            "knowledge_mode" => value_from(operating, operating_path, "knowledge_mode") || "unknown"
          }

          state = normalize({
            "schema" => "aiops.project_inspect.v1",
            "target" => target,
            "core" => core,
            "project" => project,
            "git" => {
              "inside_worktree" => git_inside,
              "branch" => git_branch,
              "head" => git_head,
              "canonical_status_ref" => status_ref,
              "canonical_status_sha" => status_ref_sha,
              "recorded_status_ref" => runtime_ref["status_ref"],
              "recorded_status_sha" => runtime_sha,
              "recorded_checked_at" => runtime_ref["checked_at"],
              "status_ref_state" => status_ref_state
            },
            "agents" => {
              "count" => agents.length,
              "active_roles" => active_roles || []
            },
            "tasks" => {
              "total" => tasks.length,
              "by_queue" => task_counts_by_queue.sort.to_h,
              "by_status" => task_counts_by_status.sort.to_h,
              "items" => tasks
            },
            "next" => begin
              notes = []
              notes << "run aiops seed before bootstrap" unless core["present"]
              notes << "run AI Ops bootstrap before task work" unless project["present"]
              notes << "set canonical_status_ref for multi-worktree projects" if project["present"] && !status_ref
              notes << "run aiops sync-status to record latest canonical SHA" if status_ref && status_ref_state != "recorded_current"
              notes
            end
          })

          if json
            puts JSON.pretty_generate(state)
            exit 0
          end

          puts "AI Ops project inspect"
          puts "target: #{state["target"]}"
          puts ""
          puts "core:"
          puts "  present: #{state["core"]["present"]}"
          puts "  source: #{state["core"]["source"]}"
          puts "  version: #{state["core"]["version"]}"
          puts "  adapters: codex=#{state["core"]["adapters"]["codex"]}, claude=#{state["core"]["adapters"]["claude"]}"
          puts ""
          puts "project:"
          puts "  present: #{state["project"]["present"]}"
          puts "  name: #{state["project"]["name"]}"
          puts "  bootstrap_mode: #{state["project"]["bootstrap_mode"]}"
          puts "  readiness_level: #{state["project"]["readiness_level"]}"
          puts "  operating_mode: #{state["project"]["operating_mode"]}"
          puts "  team_pattern: #{state["project"]["team_pattern"]}"
          puts "  workflow_policy: #{state["project"]["workflow_policy"]}"
          puts "  knowledge_mode: #{state["project"]["knowledge_mode"]}"
          puts ""
          puts "git:"
          puts "  inside_worktree: #{state["git"]["inside_worktree"]}"
          puts "  branch: #{state["git"]["branch"] || "unknown"}"
          puts "  head: #{state["git"]["head"] || "unknown"}"
          puts "  canonical_status_ref: #{state["git"]["canonical_status_ref"] || "unresolved"}"
          puts "  canonical_status_sha: #{state["git"]["canonical_status_sha"] || "unresolved"}"
          puts "  recorded_status_sha: #{state["git"]["recorded_status_sha"] || "unrecorded"}"
          puts "  status_ref_state: #{state["git"]["status_ref_state"]}"
          puts ""
          puts "agents:"
          puts "  count: #{state["agents"]["count"]}"
          puts "  active_roles: #{Array(state["agents"]["active_roles"]).join(", ")}"
          puts ""
          puts "tasks:"
          puts "  total: #{state["tasks"]["total"]}"
          puts "  by_queue: #{state["tasks"]["by_queue"].map { |key, value| "#{key}=#{value}" }.join(", ")}"
          puts "  by_status: #{state["tasks"]["by_status"].map { |key, value| "#{key}=#{value}" }.join(", ")}"
          unless state["next"].empty?
            puts ""
            puts "next:"
            state["next"].each { |note| puts "  - #{note}" }
          end
        ' "$target" "$json"
      else
        die "ruby is required for project inspect"
      fi
      ;;
    context)
      target="$(pwd)"
      role_input=""
      task_id=""
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --role)
            shift
            [ "$#" -gt 0 ] || die "--role requires a value"
            role_input="$1"
            ;;
          --task)
            shift
            [ "$#" -gt 0 ] || die "--task requires a value"
            task_id="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown project context option: $1"
            ;;
        esac
        shift
      done

      [ -n "$role_input" ] || die "project context requires --role"
      role="$(normalize_role_name "$role_input")" || die "unknown role: $role_input"
      target="$(abs_path "$target")"
      [ -d "$target/.ai_project" ] || die ".ai_project missing; bootstrap project first"

      task_file=""
      if [ -n "$task_id" ]; then
        task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      fi

      catalog="$(workflow_catalog_path "$target" "" 2>/dev/null || true)"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for project context"

      ruby -ryaml -rjson -rdate -ropen3 -rshellwords -e '
        target = ARGV[0]
        role = ARGV[1]
        task_file = ARGV[2]
        task_id = ARGV[3]
        catalog_path = ARGV[4]
        as_json = ARGV[5] == "yes"

        def scalar_string(value)
          return nil unless value.is_a?(String) || value.is_a?(Integer) || value.is_a?(Float) || value == true || value == false
          string = value.to_s.strip
          if string.length >= 2
            quote_pairs = { 34.chr => 34.chr, 39.chr => 39.chr, 96.chr => 96.chr }
            first = string[0]
            string = string[1...-1].strip if quote_pairs[first] == string[-1]
          end
          string
        end

        def front_matter(path)
          return {} unless File.file?(path)
          text = File.read(path)
          return {} unless text.start_with?("---\n")
          lines = text.lines
          closing = nil
          lines[1..].each_with_index do |line, idx|
            if line.strip == "---"
              closing = idx + 1
              break
            end
          end
          return {} unless closing
          YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
        rescue Psych::SyntaxError
          {}
        end

        def legacy_field(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
              value = Regexp.last_match(1).strip
              return nil if value.empty?
              return value.gsub(/\A`|`\z/, "")
            end
          end
          nil
        end

        def table_value(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            next unless line.include?("|")
            cells = line.split("|").map { |cell| cell.strip.gsub(/\A`|`\z/, "") }
            next unless cells.length >= 4
            return cells[2] if cells[1] == key && !cells[2].empty?
          end
          nil
        end

        def value_from(data, path, key)
          value = data[key]
          value = legacy_field(path, key) || table_value(path, key) if value.nil? || value == ""
          return nil if value.nil?
          value = scalar_string(value)
          return nil if value.nil?
          return nil if value.empty?
          return nil if %w[null unresolved pending_decision {{CANONICAL_STATUS_REF}}].include?(value)
          value
        end

        def list(value)
          case value
          when Array then value.compact.map(&:to_s).reject(&:empty?)
          when nil then []
          else value.to_s.split(",").map(&:strip).reject(&:empty?)
          end
        end

        def git(target, *args)
          stdout, _stderr, status = Open3.capture3("git", "-C", target, *args)
          return nil unless status.success?
          stdout.strip
        end

        def normalize(value)
          case value
          when Hash
            value.each_with_object({}) { |(key, item), out| out[key.to_s] = normalize(item) }
          when Array
            value.map { |item| normalize(item) }
          when Date, Time
            value.to_s
          else
            value
          end
        end

        def command_target(target)
          Shellwords.escape(target)
        end

        def resolve_workflow(workflows, workflow_id, default_workflow, seen = [])
          return {} if workflow_id.nil? || seen.include?(workflow_id)
          entry = workflows[workflow_id] || workflows[default_workflow] || {}
          inherited = entry["inherits"]
          if inherited
            parent = resolve_workflow(workflows, inherited, default_workflow, seen + [workflow_id])
            parent.merge(entry) do |key, parent_value, child_value|
              if key == "statuses"
                parent_value.merge(child_value || {})
              elsif key == "transitions"
                child_value || parent_value
              else
                child_value.nil? ? parent_value : child_value
              end
            end
          else
            entry
          end
        end

        project_dir = File.join(target, ".ai_project")
        operating_path = File.join(project_dir, "operating_model.md")
        registry_path = File.join(project_dir, "agent_registry.md")
        operating = front_matter(operating_path)
        registry = front_matter(registry_path)
        status_ref = value_from(operating, operating_path, "canonical_status_ref")
        status_ref_sha = status_ref ? git(target, "rev-parse", "--verify", "#{status_ref}^{commit}") : nil
        git_inside = git(target, "rev-parse", "--is-inside-work-tree") == "true"

        catalog = File.file?(catalog_path) ? JSON.parse(File.read(catalog_path)) : {}
        workflows = catalog["workflows"] || {}
        default_workflow = catalog["default_workflow"] || "feature"

        task = nil
        valid_next = []
        workflow_entry = {}
        status_meta = {}
        allowed_paths = []
        source_of_truth = []
        required_files = [
          ".ai/runtime/workflows.json",
          ".ai/runtime/workflow.md",
          ".ai/runtime/task_queue.md",
          ".ai/runtime/role_handoff.md",
          ".ai/policies/shared_status_policy.md",
          ".ai/policies/session_orchestration_policy.md",
          ".ai_project/operating_model.md",
          ".ai_project/agent_registry.md",
          ".ai_project/current_context.md",
          ".ai_project/task_board.md",
          ".ai_project/source_of_truth.md"
        ]

        if !task_file.to_s.empty?
          data = front_matter(task_file)
          workflow = data["workflow"] || legacy_field(task_file, "workflow") || default_workflow
          status = data["status"] || legacy_field(task_file, "status")
          target_role = data["target_role"] || legacy_field(task_file, "target_role")
          target_agent = data["target_agent"] || legacy_field(task_file, "target_agent")
          allowed_paths = list(data["allowed_paths"])
          source_of_truth = list(data["source_of_truth"])
          required_files += source_of_truth
          workflow_entry = resolve_workflow(workflows, workflow, default_workflow)
          status_meta = (workflow_entry["statuses"] || {})[status] || {}
          transitions = workflow_entry["transitions"].is_a?(Array) ? workflow_entry["transitions"] : []
          valid_next = transitions.select do |transition|
            roles = list(transition["allowed_roles"])
            transition.is_a?(Hash) &&
              transition["from"] == status &&
              (roles.include?(role) || roles.include?("any"))
          end.map do |transition|
            to = transition["to"]
            meta = (workflow_entry["statuses"] || {})[to] || {}
            {
              "to" => to,
              "next_role" => transition["next_role"],
              "checkpoint" => meta["checkpoint"],
              "canonical_publish" => meta["canonical_publish"],
              "meaning" => meta["meaning"]
            }
          end
          task = {
            "id" => data["id"] || task_id,
            "path" => task_file.sub(%r{\A#{Regexp.escape(target)}/?}, ""),
            "title" => data["title"],
            "status" => status,
            "workflow" => workflow,
            "status_meaning" => status_meta["meaning"],
            "checkpoint" => status_meta["checkpoint"],
            "canonical_publish" => status_meta["canonical_publish"],
            "target_role" => target_role,
            "target_agent" => target_agent,
            "allowed_paths" => allowed_paths,
            "source_of_truth" => source_of_truth,
            "locked_by" => data["locked_by"] || legacy_field(task_file, "locked_by"),
            "lock_session" => data["lock_session"] || legacy_field(task_file, "lock_session"),
            "status_ref" => data["status_ref"] || legacy_field(task_file, "status_ref"),
            "status_ref_sha" => data["status_ref_sha"] || legacy_field(task_file, "status_ref_sha")
          }
        end

        forbidden_actions = [
          "commit without explicit user approval",
          "push without explicit user approval",
          "merge without explicit user approval",
          "deploy without explicit user approval",
          "edit .ai/ core instructions unless the operator explicitly approved core changes"
        ]
        forbidden_actions << "edit outside allowed_paths" unless allowed_paths.empty?

        contract = normalize({
          "schema" => "aiops.project_context.v1",
          "target" => target,
          "role" => role,
          "project" => {
            "name" => value_from(operating, operating_path, "project") || File.basename(target),
            "operating_mode" => value_from(operating, operating_path, "operating_mode") || "unknown",
            "workflow_policy" => value_from(operating, operating_path, "workflow_policy") || "unknown",
            "knowledge_mode" => value_from(operating, operating_path, "knowledge_mode") || "unknown"
          },
          "git" => {
            "inside_worktree" => git_inside,
            "branch" => git_inside ? git(target, "rev-parse", "--abbrev-ref", "HEAD") : nil,
            "head" => git_inside ? git(target, "rev-parse", "--short", "HEAD") : nil,
            "canonical_status_ref" => status_ref,
            "canonical_status_sha" => status_ref_sha
          },
          "task" => task,
          "required_files" => required_files.uniq,
          "allowed_paths" => allowed_paths,
          "source_of_truth" => source_of_truth,
          "valid_next_transitions" => valid_next,
          "handoff_target" => valid_next.map { |transition| transition["next_role"] }.compact.uniq,
          "approval_required_for" => ["commit", "push", "create_pr", "merge", "deploy", "external configuration changes"],
          "forbidden_actions" => forbidden_actions,
          "recommended_checks" => begin
            escaped_target = command_target(target)
            checks = ["aiops project snapshot --target #{escaped_target} --json", "aiops project inspect --target #{escaped_target}", "aiops validate project --target #{escaped_target} --strict"]
            checks << "aiops status-ref --target #{escaped_target}" if status_ref
            checks << "aiops sync-status --target #{escaped_target}" if status_ref
            checks << "aiops task status #{task["id"]} --target #{escaped_target}" if task
            checks << "aiops task status #{task["id"]} --target #{escaped_target} --source canonical" if task && status_ref
            checks
          end
        })

        if as_json
          puts JSON.pretty_generate(contract)
          exit 0
        end

        puts "AI Ops project context"
        puts "target: #{contract["target"]}"
        puts "role: #{contract["role"]}"
        puts "project: #{contract["project"]["name"]}"
        puts "operating_mode: #{contract["project"]["operating_mode"]}"
        puts "workflow_policy: #{contract["project"]["workflow_policy"]}"
        puts ""
        puts "git:"
        puts "  branch: #{contract["git"]["branch"] || "unknown"}"
        puts "  head: #{contract["git"]["head"] || "unknown"}"
        puts "  canonical_status_ref: #{contract["git"]["canonical_status_ref"] || "unresolved"}"
        puts "  canonical_status_sha: #{contract["git"]["canonical_status_sha"] || "unresolved"}"

        if contract["task"]
          t = contract["task"]
          puts ""
          puts "task:"
          puts "  id: #{t["id"]}"
          puts "  path: #{t["path"]}"
          puts "  status: #{t["status"]}"
          puts "  workflow: #{t["workflow"]}"
          puts "  status_meaning: #{t["status_meaning"] || "unknown"}"
          puts "  checkpoint: #{t["checkpoint"].nil? ? "unknown" : t["checkpoint"]}"
          puts "  canonical_publish: #{t["canonical_publish"] || "unknown"}"
          puts "  target_role: #{t["target_role"] || "unassigned"}"
          puts "  target_agent: #{t["target_agent"] || "unassigned"}"
          puts "  locked_by: #{t["locked_by"] || "none"}"
          puts "  status_ref: #{t["status_ref"] || "unresolved"}"
          puts "  status_ref_sha: #{t["status_ref_sha"] || "unresolved"}"
        end

        puts ""
        puts "required_files:"
        contract["required_files"].each { |file| puts "  - #{file}" }
        puts ""
        puts "allowed_paths:"
        if contract["allowed_paths"].empty?
          puts "  - unrestricted_by_task"
        else
          contract["allowed_paths"].each { |path| puts "  - #{path}" }
        end
        puts ""
        puts "valid_next_transitions:"
        if contract["valid_next_transitions"].empty?
          puts "  - none"
        else
          contract["valid_next_transitions"].each do |transition|
            puts "  - to: #{transition["to"]}"
            puts "    next_role: #{transition["next_role"] || "none"}"
            puts "    checkpoint: #{transition["checkpoint"]}"
            puts "    canonical_publish: #{transition["canonical_publish"]}"
          end
        end
        puts ""
        puts "handoff_target: #{contract["handoff_target"].empty? ? "none" : contract["handoff_target"].join(", ")}"
        puts ""
        puts "forbidden_actions:"
        contract["forbidden_actions"].each { |action| puts "  - #{action}" }
        puts ""
        puts "recommended_checks:"
        contract["recommended_checks"].each { |check| puts "  - #{check}" }
      ' "$target" "$role" "$task_file" "$task_id" "$catalog" "$json"
      ;;
    health)
      target="$(pwd)"
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown project health option: $1"
            ;;
        esac
        shift
      done

      target="$(abs_path "$target")"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for project health"

      ruby -ryaml -rjson -rdate -rfind -ropen3 -e '
        target = ARGV[0]
        as_json = ARGV[1] == "yes"

        def scalar_string(value)
          return nil unless value.is_a?(String) || value.is_a?(Integer) || value.is_a?(Float) || value == true || value == false
          string = value.to_s.strip
          if string.length >= 2
            quote_pairs = { 34.chr => 34.chr, 39.chr => 39.chr, 96.chr => 96.chr }
            first = string[0]
            string = string[1...-1].strip if quote_pairs[first] == string[-1]
          end
          string
        end

        def front_matter(path)
          return {} unless File.file?(path)
          text = File.read(path)
          return {} unless text.start_with?("---\n")
          lines = text.lines
          closing = nil
          lines[1..].each_with_index do |line, idx|
            if line.strip == "---"
              closing = idx + 1
              break
            end
          end
          return {} unless closing
          YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
        rescue Psych::SyntaxError
          {}
        end

        def legacy_field(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
              value = Regexp.last_match(1).strip
              return nil if value.empty?
              return value.gsub(/\A`|`\z/, "")
            end
          end
          nil
        end

        def table_value(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            next unless line.include?("|")
            cells = line.split("|").map { |cell| cell.strip.gsub(/\A`|`\z/, "") }
            next unless cells.length >= 4
            return cells[2] if cells[1] == key && !cells[2].empty?
          end
          nil
        end

        def value_from(data, path, key)
          value = data[key]
          value = legacy_field(path, key) || table_value(path, key) if value.nil? || value == ""
          return nil if value.nil?
          value = scalar_string(value)
          return nil if value.nil?
          return nil if value.empty?
          return nil if %w[null unresolved pending_decision {{CANONICAL_STATUS_REF}}].include?(value)
          value
        end

        def git(target, *args)
          stdout, _stderr, status = Open3.capture3("git", "-C", target, *args)
          return nil unless status.success?
          stdout.strip
        end

        def git_tracked?(target, path)
          _stdout, _stderr, status = Open3.capture3("git", "-C", target, "ls-files", "--error-unmatch", path)
          status.success?
        end

        def files_under(path)
          return [] unless Dir.exist?(path)
          files = []
          Find.find(path) do |entry|
            files << entry if File.file?(entry) && File.basename(entry).end_with?(".md")
          end
          files.sort
        end

        def runtime_status_ref(path)
          data = {}
          return data unless File.file?(path)
          File.foreach(path) do |line|
            key, value = line.split(":", 2)
            next unless key && value
            data[key.strip] = value.strip
          end
          data
        end

        def normalize(value)
          case value
          when Hash
            value.each_with_object({}) { |(key, item), out| out[key.to_s] = normalize(item) }
          when Array
            value.map { |item| normalize(item) }
          when Date, Time
            value.to_s
          else
            value
          end
        end

        def conditional_project_file_required?(file_name, project)
          case file_name
          when "branch_pr_strategy.md"
            value = project["branch_pr"].to_s
            !value.empty? && !%w[null unresolved pending pending_decision none unknown].include?(value)
          when "workflow_overrides.md"
            project["workflow_policy"].to_s == "custom" ||
              project["workflow_override"].to_s == "true" ||
              project["workflow_overrides"].to_s == "true"
          when "ops_migration_plan.md"
            bootstrap_mode = project["bootstrap_mode"].to_s
            bootstrap_mode == "migrated" || bootstrap_mode.include?("migration")
          else
            true
          end
        end

        def conditional_project_file_reason(file_name, project)
          case file_name
          when "branch_pr_strategy.md"
            "branch_pr #{project["branch_pr"] || "pending_decision"}"
          when "workflow_overrides.md"
            "workflow_policy #{project["workflow_policy"] || "unknown"}"
          when "ops_migration_plan.md"
            "bootstrap_mode #{project["bootstrap_mode"] || "unknown"}"
          else
            "conditional project file"
          end
        end

        checks = []
        add = lambda do |level, code, message|
          checks << { "level" => level, "code" => code, "message" => message }
        end

        project_dir = File.join(target, ".ai_project")
        ai_path = File.join(target, ".ai")
        operating_path = File.join(project_dir, "operating_model.md")
        registry_path = File.join(project_dir, "agent_registry.md")
        core_version_path = File.join(ai_path, "VERSION")
        workflow_catalog_path = File.join(ai_path, "runtime", "workflows.json")

        core_version = File.file?(core_version_path) ? File.read(core_version_path).strip : "unknown"
        operating = front_matter(operating_path)
        registry = front_matter(registry_path)
        recorded_core_version = value_from(operating, operating_path, "core_version")
        project_name = value_from(operating, operating_path, "project") || File.basename(target)
        project = {
          "bootstrap_mode" => value_from(operating, operating_path, "bootstrap_mode") || "unknown",
          "workflow_policy" => value_from(operating, operating_path, "workflow_policy") || "unknown",
          "workflow_override" => value_from(operating, operating_path, "workflow_override"),
          "workflow_overrides" => value_from(operating, operating_path, "workflow_overrides"),
          "branch_pr" => value_from(operating, operating_path, "branch_pr") || "pending_decision"
        }

        if File.exist?(ai_path)
          add.call("ok", "core_connected", ".ai core is connected")
        else
          add.call("blocker", "core_missing", ".ai core missing; run aiops seed first")
        end

        if File.file?(File.join(target, "AGENTS.md")) || File.file?(File.join(target, "CLAUDE.md"))
          add.call("ok", "adapter_present", "at least one Agent adapter exists")
        else
          add.call("warn", "adapter_missing", "AGENTS.md or CLAUDE.md adapter is missing")
        end

        if Dir.exist?(project_dir)
          add.call("ok", "project_config_present", ".ai_project exists")
        else
          add.call("blocker", "project_config_missing", ".ai_project missing; run bootstrap first")
        end

        required_files = %w[
          operating_model.md
          agent_registry.md
          current_context.md
          source_of_truth.md
          task_board.md
          ops_decisions.md
          ops_issues.md
        ]
        required_files.each do |name|
          path = File.join(project_dir, name)
          if File.file?(path)
            add.call("ok", "required_file_present", ".ai_project/#{name} exists")
          else
            add.call("blocker", "required_file_missing", ".ai_project/#{name} missing")
          end
        end

        %w[branch_pr_strategy.md workflow_overrides.md ops_migration_plan.md].each do |name|
          path = File.join(project_dir, name)
          if conditional_project_file_required?(name, project)
            if File.file?(path)
              add.call("ok", "required_file_present", ".ai_project/#{name} exists")
            else
              add.call("blocker", "required_file_missing", ".ai_project/#{name} missing; #{conditional_project_file_reason(name, project)}")
            end
          elsif File.exist?(path)
            add.call("ok", "optional_file_present", ".ai_project/#{name} exists")
          else
            add.call("ok", "conditional_file_not_required", ".ai_project/#{name} not required; #{conditional_project_file_reason(name, project)}")
          end
        end

        %w[tasks tasks/active tasks/backlog tasks/archive].each do |name|
          path = File.join(project_dir, name)
          if Dir.exist?(path)
            add.call("ok", "required_dir_present", ".ai_project/#{name} exists")
          else
            add.call("blocker", "required_dir_missing", ".ai_project/#{name} missing")
          end
        end

        if operating["schema"] == "aiops.operating_model.v1"
          add.call("ok", "operating_model_schema", "operating_model schema is aiops.operating_model.v1")
        elsif File.file?(operating_path)
          add.call("warn", "operating_model_schema_missing", "operating_model schema missing or legacy")
        end

        if registry["schema"] == "aiops.agent_registry.v1"
          add.call("ok", "agent_registry_schema", "agent_registry schema is aiops.agent_registry.v1")
        elsif File.file?(registry_path)
          add.call("warn", "agent_registry_schema_missing", "agent_registry schema missing or legacy")
        end

        if File.file?(workflow_catalog_path)
          begin
            catalog = JSON.parse(File.read(workflow_catalog_path))
            if catalog["schema"] == "aiops.workflow_catalog.v1" && catalog["workflows"].is_a?(Hash)
              add.call("ok", "workflow_catalog_valid", "workflow catalog is readable")
            else
              add.call("blocker", "workflow_catalog_invalid", "workflow catalog schema is invalid")
            end
          rescue JSON::ParserError
            add.call("blocker", "workflow_catalog_unreadable", "workflow catalog JSON cannot be parsed")
          end
        else
          add.call("blocker", "workflow_catalog_missing", ".ai/runtime/workflows.json missing")
        end

        if recorded_core_version && core_version != "unknown" && recorded_core_version == core_version
          add.call("ok", "core_version_current", ".ai_project core_version matches current core")
        elsif Dir.exist?(project_dir) && core_version != "unknown"
          add.call("warn", "migration_needed", ".ai_project core_version differs or is missing")
        end

        status_ref = value_from(operating, operating_path, "canonical_status_ref")
        git_inside = git(target, "rev-parse", "--is-inside-work-tree") == "true"
        if git_inside && git_tracked?(target, ".ai_project/.runtime/status_ref")
          add.call("warn", "runtime_status_ref_tracked", ".ai_project/.runtime/status_ref is tracked; remove it from Git and keep .ai_project/.runtime/ ignored")
        end
        git_branch = git_inside ? git(target, "rev-parse", "--abbrev-ref", "HEAD") : nil
        git_head = git_inside ? git(target, "rev-parse", "--short", "HEAD") : nil
        status_ref_sha = git_inside && status_ref ? git(target, "rev-parse", "--verify", "#{status_ref}^{commit}") : nil
        runtime_ref = runtime_status_ref(File.join(project_dir, ".runtime", "status_ref"))
        runtime_sha = runtime_ref["status_ref_sha"]
        status_ref_state =
          if !status_ref
            "unresolved"
          elsif !status_ref_sha
            "ref_not_found_locally"
          elsif runtime_sha.nil? || runtime_sha.empty?
            "not_recorded"
          elsif runtime_sha == status_ref_sha
            "recorded_current"
          else
            "recorded_stale"
          end

        tasks = files_under(File.join(project_dir, "tasks")).map do |path|
          data = front_matter(path)
          {
            "id" => data["id"] || File.basename(path, ".md"),
            "path" => path.sub(%r{\A#{Regexp.escape(target)}/?}, ""),
            "status" => data["status"] || legacy_field(path, "status"),
            "workflow" => data["workflow"] || legacy_field(path, "workflow"),
            "target_role" => data["target_role"] || legacy_field(path, "target_role"),
            "target_agent" => data["target_agent"] || legacy_field(path, "target_agent"),
            "status_ref_sha" => data["status_ref_sha"] || legacy_field(path, "status_ref_sha")
          }
        end

        task_counts_by_status = Hash.new(0)
        tasks.each { |task| task_counts_by_status[task["status"] || "unknown"] += 1 }
        active_tasks = tasks.select { |task| !%w[done cancelled].include?(task["status"].to_s) }
        missing_task_metadata = tasks.select { |task| task["status"].to_s.empty? || task["workflow"].to_s.empty? || task["target_role"].to_s.empty? }
        tasks_missing_status_ref = active_tasks.select { |task| task["status_ref_sha"].to_s.empty? }

        if tasks.empty?
          add.call("ok", "task_board_empty", "no tasks registered yet")
        elsif missing_task_metadata.empty?
          add.call("ok", "task_metadata_present", "all tasks have status, workflow, and target_role")
        else
          add.call("warn", "task_metadata_incomplete", "#{missing_task_metadata.length} task(s) missing status, workflow, or target_role")
        end

        if status_ref
          case status_ref_state
          when "recorded_current"
            add.call("ok", "canonical_status_current", "recorded canonical status SHA is current")
          when "ref_not_found_locally"
            add.call("blocker", "canonical_status_ref_unavailable", "canonical_status_ref cannot be resolved locally")
          when "not_recorded"
            add.call("warn", "canonical_status_not_recorded", "canonical status SHA is not recorded; run aiops sync-status")
          when "recorded_stale"
            add.call("warn", "canonical_status_stale", "recorded canonical status SHA is stale; run aiops sync-status")
          end

          if tasks_missing_status_ref.empty?
            add.call("ok", "task_status_ref_present", "active tasks include status_ref_sha or no active tasks need it")
          elsif active_tasks.any?
            add.call("warn", "task_status_ref_missing", "#{tasks_missing_status_ref.length} active task(s) missing status_ref_sha")
          end
        elsif Dir.exist?(project_dir)
          add.call("warn", "canonical_status_ref_unresolved", "canonical_status_ref unresolved; recommended for multi-worktree projects")
        end

        unresolved_count = 0
        if Dir.exist?(project_dir)
          files_under(project_dir).each do |path|
            next if path.include?("/tasks/archive/")
            text = File.read(path)
            unresolved_count += text.scan(/pending_decision|unresolved|TBD|TODO/i).length
          end
        end
        if unresolved_count.positive?
          add.call("warn", "unresolved_decisions_present", "#{unresolved_count} unresolved decision marker(s) found")
        else
          add.call("ok", "unresolved_decisions_absent", "no unresolved decision markers found")
        end

        blocker_count = checks.count { |check| check["level"] == "blocker" }
        warning_count = checks.count { |check| check["level"] == "warn" }
        overall =
          if blocker_count.positive?
            "blocked"
          elsif warning_count.positive?
            "warning"
          else
            "ok"
          end

        bootstrap =
          if checks.any? { |check| check["code"] == "project_config_missing" || check["code"] == "core_missing" }
            "missing"
          elsif checks.any? { |check| check["level"] == "blocker" }
            "partial"
          else
            "complete"
          end

        task_work =
          if blocker_count.positive?
            "blocked"
          elsif warning_count.positive?
            "allowed_with_warnings"
          else
            "allowed"
          end

        multi_agent =
          if !status_ref
            "needs_canonical_status_ref"
          elsif status_ref_state == "recorded_current"
            "ready"
          elsif status_ref_state == "ref_not_found_locally"
            "blocked"
          else
            "sync_required"
          end

        migration =
          if checks.any? { |check| check["code"] == "project_config_missing" }
            "not_configured"
          elsif checks.any? { |check| check["code"] == "migration_needed" }
            "migration_needed"
          elsif checks.any? { |check| check["code"].end_with?("_schema_missing") }
            "review_needed"
          else
            "not_required"
          end

        next_steps = []
        next_steps << "run aiops seed --adapter both" if checks.any? { |check| check["code"] == "core_missing" }
        next_steps << "run AI Ops bootstrap before task work" if checks.any? { |check| check["code"] == "project_config_missing" }
        next_steps << "run aiops migrate --plan" if migration == "migration_needed"
        next_steps << "set canonical_status_ref for multi-worktree projects" if status_ref.nil? && Dir.exist?(project_dir)
        next_steps << "run aiops sync-status --target #{target}" if %w[not_recorded recorded_stale].include?(status_ref_state)
        next_steps << "run aiops validate project --target #{target} --strict" if checks.any? { |check| check["level"] != "ok" }
        next_steps.uniq!

        health = normalize({
          "schema" => "aiops.project_health.v1",
          "target" => target,
          "overall" => overall,
          "summary" => {
            "ok" => checks.count { |check| check["level"] == "ok" },
            "warnings" => warning_count,
            "blockers" => blocker_count,
            "tasks" => tasks.length,
            "active_tasks" => active_tasks.length,
            "unresolved_decisions" => unresolved_count
          },
          "project" => {
            "name" => project_name,
            "core_version" => core_version,
            "recorded_core_version" => recorded_core_version,
            "operating_mode" => value_from(operating, operating_path, "operating_mode") || "unknown",
            "workflow_policy" => value_from(operating, operating_path, "workflow_policy") || "unknown",
            "knowledge_mode" => value_from(operating, operating_path, "knowledge_mode") || "unknown"
          },
          "git" => {
            "inside_worktree" => git_inside,
            "branch" => git_branch,
            "head" => git_head,
            "canonical_status_ref" => status_ref,
            "canonical_status_sha" => status_ref_sha,
            "recorded_status_sha" => runtime_sha,
            "status_ref_state" => status_ref_state
          },
          "tasks" => {
            "total" => tasks.length,
            "active" => active_tasks.length,
            "by_status" => task_counts_by_status.sort.to_h,
            "missing_metadata" => missing_task_metadata.length,
            "missing_status_ref_sha" => tasks_missing_status_ref.length
          },
          "readiness" => {
            "bootstrap" => bootstrap,
            "task_work" => task_work,
            "multi_agent" => multi_agent,
            "migration" => migration
          },
          "checks" => checks,
          "next" => next_steps
        })

        if as_json
          puts JSON.pretty_generate(health)
          exit 0
        end

        puts "AI Ops project health"
        puts "target: #{health["target"]}"
        puts "overall: #{health["overall"]}"
        puts ""
        puts "project:"
        puts "  name: #{health["project"]["name"]}"
        puts "  core_version: #{health["project"]["core_version"]}"
        puts "  recorded_core_version: #{health["project"]["recorded_core_version"] || "unrecorded"}"
        puts "  operating_mode: #{health["project"]["operating_mode"]}"
        puts "  workflow_policy: #{health["project"]["workflow_policy"]}"
        puts ""
        puts "git:"
        puts "  branch: #{health["git"]["branch"] || "unknown"}"
        puts "  head: #{health["git"]["head"] || "unknown"}"
        puts "  canonical_status_ref: #{health["git"]["canonical_status_ref"] || "unresolved"}"
        puts "  status_ref_state: #{health["git"]["status_ref_state"]}"
        puts ""
        puts "readiness:"
        health["readiness"].each { |key, value| puts "  #{key}: #{value}" }
        puts ""
        puts "tasks:"
        puts "  total: #{health["tasks"]["total"]}"
        puts "  active: #{health["tasks"]["active"]}"
        puts "  by_status: #{health["tasks"]["by_status"].map { |key, value| "#{key}=#{value}" }.join(", ")}"
        puts "  missing_metadata: #{health["tasks"]["missing_metadata"]}"
        puts "  missing_status_ref_sha: #{health["tasks"]["missing_status_ref_sha"]}"
        puts ""
        puts "checks:"
        health["checks"].each { |check| puts "  #{check["level"]}: #{check["message"]}" }
        unless health["next"].empty?
          puts ""
          puts "next:"
          health["next"].each { |step| puts "  - #{step}" }
        end
      ' "$target" "$json"
      ;;
    -h|--help)
      usage
      ;;
    *)
      die "unknown project action: $action"
      ;;
  esac
}

cmd_validate() {
  subject="${1:-}"
  if [ "$#" -eq 0 ] || [ "${subject#-}" != "$subject" ]; then
    subject="project"
  else
    shift
  fi

  case "$subject" in
    task)
      strict="no"
      file=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --strict)
            strict="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          -*)
            die "unknown validate task option: $1"
            ;;
          *)
            [ -z "$file" ] || die "validate task requires exactly one FILE"
            file="$1"
            ;;
        esac
        shift
      done
      [ -n "$file" ] || die "validate task requires exactly one FILE"
      if [ "$strict" = "yes" ]; then
        [ -f "$file" ] || {
          info "missing: $file"
          return 1
        }
        info "AI Ops task validate"
        info "task: $file"
        validate_front_matter task "$file" yes
        info "ok: task metadata"
      else
        validate_task_file "$file"
      fi
      ;;
    handoff)
      strict="no"
      file=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --strict)
            strict="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          -*)
            die "unknown validate handoff option: $1"
            ;;
          *)
            [ -z "$file" ] || die "validate handoff requires exactly one FILE"
            file="$1"
            ;;
        esac
        shift
      done
      [ -n "$file" ] || die "validate handoff requires exactly one FILE"
      [ -f "$file" ] || {
        info "missing: $file"
        return 1
      }
      info "AI Ops handoff validate"
      info "handoff: $file"
      validate_front_matter handoff "$file" "$strict"
      info "ok: handoff metadata"
      ;;
    policy-rules)
      core=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --core)
            shift
            [ "$#" -gt 0 ] || die "--core requires a value"
            core="$1"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown validate policy-rules option: $1"
            ;;
        esac
        shift
      done

      if [ -n "$core" ]; then
        core="$(abs_path "$core")"
      else
        core="$(default_core_dir)"
      fi
      rules_path="$core/runtime/policy_rules.json"
      schema_path="$core/schemas/policy_rules.schema.json"
      [ -f "$rules_path" ] || die "policy rules catalog not found: $rules_path"
      [ -f "$schema_path" ] || die "policy rules schema not found: $schema_path"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for policy rules validation"

      info "AI Ops policy rules validate"
      info "catalog: $rules_path"
      ruby -rjson -e '
        path = ARGV[0]
        schema_path = ARGV[1]
        catalog = JSON.parse(File.read(path))
        schema = JSON.parse(File.read(schema_path))

        abort("schema_error: catalog must be an object") unless catalog.is_a?(Hash)
        abort("schema_error: schema file must define aiops.policy_rules.v1") unless schema.dig("properties", "schema", "const") == "aiops.policy_rules.v1"

        id_pattern = /\A[a-z][a-z0-9_\/-]*\z/
        allowed_top_level = %w[schema version generated_from strict_levels rules]
        extra_top_level = catalog.keys - allowed_top_level
        abort("schema_error: unknown top-level keys #{extra_top_level.join(", ")}") unless extra_top_level.empty?
        abort("schema_error: schema must be aiops.policy_rules.v1") unless catalog["schema"] == "aiops.policy_rules.v1"
        abort("schema_error: version must be a non-empty string") unless catalog["version"].is_a?(String) && !catalog["version"].empty?

        if catalog.key?("generated_from")
          generated_from = catalog["generated_from"]
          abort("schema_error: generated_from must be an array") unless generated_from.is_a?(Array)
          abort("schema_error: generated_from must contain strings") unless generated_from.all? { |item| item.is_a?(String) && !item.empty? }
          abort("schema_error: generated_from must be unique") unless generated_from.uniq.length == generated_from.length
        end

        levels = catalog["strict_levels"]
        abort("schema_error: strict_levels must be a non-empty array") unless levels.is_a?(Array) && !levels.empty?
        level_ids = []
        levels.each do |level|
          abort("schema_error: strict level must be an object") unless level.is_a?(Hash)
          allowed_level_keys = %w[id label description]
          extra_level_keys = level.keys - allowed_level_keys
          abort("schema_error: strict level unknown keys #{extra_level_keys.join(", ")}") unless extra_level_keys.empty?
          id = level["id"]
          abort("schema_error: strict level id must be a valid identifier") unless id.is_a?(String) && id.match?(id_pattern)
          abort("schema_error: strict level label missing #{id}") unless level["label"].is_a?(String) && !level["label"].empty?
          abort("schema_error: strict level description missing #{id}") unless level["description"].is_a?(String) && !level["description"].empty?
          level_ids << id
        end
        abort("schema_error: strict level ids must be unique") unless level_ids.uniq.length == level_ids.length

        rules = catalog["rules"]
        abort("schema_error: rules must be a non-empty array") unless rules.is_a?(Array) && !rules.empty?
        rule_ids = []
        allowed_severity = %w[info warn blocker]
        allowed_source = %w[project_snapshot project_health project_validate]
        rules.each do |rule|
          abort("schema_error: rule must be an object") unless rule.is_a?(Hash)
          allowed_rule_keys = %w[id description severity applies_to source when message]
          extra_rule_keys = rule.keys - allowed_rule_keys
          abort("schema_error: rule unknown keys #{extra_rule_keys.join(", ")}") unless extra_rule_keys.empty?
          id = rule["id"]
          abort("schema_error: rule id must be a valid identifier") unless id.is_a?(String) && id.match?(id_pattern)
          abort("schema_error: rule description missing #{id}") unless rule["description"].is_a?(String) && !rule["description"].empty?
          abort("schema_error: rule severity invalid #{id}") unless rule["severity"].is_a?(String) && allowed_severity.include?(rule["severity"])
          abort("schema_error: rule source invalid #{id}") unless rule["source"].is_a?(String) && allowed_source.include?(rule["source"])
          abort("schema_error: rule message missing #{id}") unless rule["message"].is_a?(String) && !rule["message"].empty?

          applies_to = rule["applies_to"]
          abort("schema_error: rule applies_to missing #{id}") unless applies_to.is_a?(Array) && !applies_to.empty?
          abort("schema_error: rule applies_to must be unique #{id}") unless applies_to.uniq.length == applies_to.length
          applies_to.each do |level|
            abort("schema_error: rule applies_to unknown level #{id}: #{level}") unless level.is_a?(String) && level_ids.include?(level)
          end

          condition = rule["when"]
          abort("schema_error: rule when must be a non-empty object #{id}") unless condition.is_a?(Hash) && !condition.empty?
          condition.each do |key, value|
            abort("schema_error: rule when key invalid #{id}: #{key}") unless key.is_a?(String) && key.match?(/\A[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*\z/)
            valid_value =
              value.nil? ||
              value == true ||
              value == false ||
              (value.is_a?(String) && !value.empty?) ||
              (value.is_a?(Array) && !value.empty? && value.all? { |item| item.is_a?(String) && !item.empty? } && value.uniq.length == value.length)
            abort("schema_error: rule when value invalid #{id}: #{key}") unless valid_value
          end

          rule_ids << id
        end
        abort("schema_error: rule ids must be unique") unless rule_ids.uniq.length == rule_ids.length

        puts "ok: schema"
        puts "ok: levels #{level_ids.join(", ")}"
        puts "ok: rules #{rules.length}"
      ' "$rules_path" "$schema_path"
      info "ok: policy rules"
      ;;
    workflow-catalog)
      target="$(pwd)"
      core=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --core)
            shift
            [ "$#" -gt 0 ] || die "--core requires a value"
            core="$1"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown validate workflow-catalog option: $1"
            ;;
        esac
        shift
      done

      target="$(abs_path "$target")"
      if [ -n "$core" ]; then
        core="$(abs_path "$core")"
      fi
      catalog="$(workflow_catalog_path "$target" "$core")" || die "workflow catalog not found"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for workflow catalog validation"

      info "AI Ops workflow catalog validate"
      info "catalog: $catalog"
      ruby -rjson -e '
        path = ARGV[0]
        catalog = JSON.parse(File.read(path))
        abort("schema_error: catalog must be an object") unless catalog.is_a?(Hash)
        id_pattern = /\A[a-z][a-z0-9_\/-]*\z/
        allowed_top_level = %w[schema version default_workflow generated_from workflows]
        extra_top_level = catalog.keys - allowed_top_level
        abort("schema_error: unknown top-level keys #{extra_top_level.join(", ")}") unless extra_top_level.empty?
        abort("schema_error: schema must be aiops.workflow_catalog.v1") unless catalog["schema"] == "aiops.workflow_catalog.v1"
        abort("schema_error: version must be a non-empty string") unless catalog["version"].is_a?(String) && !catalog["version"].empty?
        if catalog.key?("generated_from")
          generated_from = catalog["generated_from"]
          abort("schema_error: generated_from must be an array") unless generated_from.is_a?(Array)
          abort("schema_error: generated_from must contain strings") unless generated_from.all? { |item| item.is_a?(String) && !item.empty? }
          abort("schema_error: generated_from must be unique") unless generated_from.uniq.length == generated_from.length
        end
        workflows = catalog["workflows"]
        abort("schema_error: workflows must be an object") unless workflows.is_a?(Hash) && !workflows.empty?
        default_workflow = catalog["default_workflow"]
        abort("schema_error: default_workflow must be a string") unless default_workflow.is_a?(String) && !default_workflow.empty?
        abort("schema_error: default_workflow pattern invalid #{default_workflow}") unless default_workflow.match?(id_pattern)
        abort("schema_error: default_workflow missing") unless workflows.key?(default_workflow)

        allowed_publish = %w[not_required optional recommended required]
        allowed_statuses = %w[
          proposed scoped approved in_progress verification_ready
          verification_in_progress verification_passed completion_review done
          blocked rework_requested cancelled
        ]
        allowed_roles = [
          nil, "Direction Role", "Lead Role", "Execution Role", "Verification Role",
          "Completion Role", "Release Role", "Ops Governance Role", "Product Owner", "any"
        ]

        def resolve_workflow(workflows, workflow_id, seen = [])
          abort("schema_error: circular workflow inheritance #{workflow_id}") if seen.include?(workflow_id)
          entry = workflows[workflow_id]
          abort("schema_error: missing inherited workflow #{workflow_id}") unless entry.is_a?(Hash)
          if entry["inherits"]
            parent = resolve_workflow(workflows, entry["inherits"], seen + [workflow_id])
            parent.merge(entry) do |key, parent_value, child_value|
              if key == "statuses"
                parent_value.merge(child_value || {})
              elsif key == "transitions"
                child_value || parent_value
              else
                child_value.nil? ? parent_value : child_value
              end
            end
          else
            entry
          end
        end

        workflows.each do |workflow_id, entry|
          abort("schema_error: workflow id pattern invalid #{workflow_id}") unless workflow_id.match?(id_pattern)
          abort("schema_error: workflow #{workflow_id} must be an object") unless entry.is_a?(Hash)
          workflow_keys = %w[label description inherits statuses transitions]
          extra_workflow_keys = entry.keys - workflow_keys
          abort("schema_error: workflow #{workflow_id} unknown keys #{extra_workflow_keys.join(", ")}") unless extra_workflow_keys.empty?
          abort("schema_error: workflow #{workflow_id} label missing") unless entry["label"].is_a?(String) && !entry["label"].empty?
          abort("schema_error: workflow #{workflow_id} description missing") unless entry["description"].is_a?(String) && !entry["description"].empty?
          if entry.key?("inherits")
            abort("schema_error: workflow #{workflow_id} inherits must be string or null") unless entry["inherits"].nil? || entry["inherits"].is_a?(String)
            abort("schema_error: workflow #{workflow_id} inherits pattern invalid #{entry["inherits"]}") if entry["inherits"].is_a?(String) && !entry["inherits"].match?(id_pattern)
            abort("schema_error: workflow #{workflow_id} inherits missing workflow #{entry["inherits"]}") if entry["inherits"].is_a?(String) && !workflows.key?(entry["inherits"])
          else
            abort("schema_error: workflow #{workflow_id} statuses missing") unless entry["statuses"].is_a?(Hash) && !entry["statuses"].empty?
            abort("schema_error: workflow #{workflow_id} transitions missing") unless entry["transitions"].is_a?(Array) && !entry["transitions"].empty?
          end
          if entry.key?("statuses")
            abort("schema_error: workflow #{workflow_id} statuses must be an object") unless entry["statuses"].is_a?(Hash)
          end
          if entry.key?("transitions")
            abort("schema_error: workflow #{workflow_id} transitions must be an array") unless entry["transitions"].is_a?(Array)
          end
          resolved = resolve_workflow(workflows, workflow_id)
          statuses = resolved["statuses"]
          transitions = resolved["transitions"]
          abort("schema_error: workflow #{workflow_id} statuses missing") unless statuses.is_a?(Hash) && !statuses.empty?
          abort("schema_error: workflow #{workflow_id} transitions missing") unless transitions.is_a?(Array) && !transitions.empty?

          statuses.each do |status, meta|
            abort("schema_error: invalid status #{workflow_id}.#{status}") unless allowed_statuses.include?(status)
            abort("schema_error: #{workflow_id}.#{status} must be an object") unless meta.is_a?(Hash)
            status_keys = %w[checkpoint canonical_publish meaning]
            extra_status_keys = meta.keys - status_keys
            abort("schema_error: #{workflow_id}.#{status} unknown keys #{extra_status_keys.join(", ")}") unless extra_status_keys.empty?
            abort("schema_error: #{workflow_id}.#{status} checkpoint must be boolean") unless meta["checkpoint"] == true || meta["checkpoint"] == false
            abort("schema_error: #{workflow_id}.#{status} canonical_publish invalid") unless meta["canonical_publish"].is_a?(String) && allowed_publish.include?(meta["canonical_publish"])
            abort("schema_error: #{workflow_id}.#{status} meaning missing") unless meta["meaning"].is_a?(String) && !meta["meaning"].empty?
          end

          transitions.each do |transition|
            abort("schema_error: transition must be an object #{workflow_id}") unless transition.is_a?(Hash)
            transition_keys = %w[from to allowed_roles next_role]
            extra_transition_keys = transition.keys - transition_keys
            abort("schema_error: transition unknown keys #{workflow_id}: #{extra_transition_keys.join(", ")}") unless extra_transition_keys.empty?
            from = transition["from"]
            to = transition["to"]
            roles = transition["allowed_roles"]
            abort("schema_error: transition from missing #{workflow_id}") unless from.is_a?(String) && !from.empty?
            abort("schema_error: transition to missing #{workflow_id}") unless to.is_a?(String) && !to.empty?
            abort("schema_error: transition from invalid #{workflow_id}: #{from}") unless statuses.key?(from)
            abort("schema_error: transition to invalid #{workflow_id}: #{to}") unless statuses.key?(to)
            abort("schema_error: transition roles missing #{workflow_id}: #{from}->#{to}") unless roles.is_a?(Array) && !roles.empty?
            abort("schema_error: transition roles must be unique #{workflow_id}: #{from}->#{to}") unless roles.uniq.length == roles.length
            roles.each do |role|
              abort("schema_error: transition role invalid #{workflow_id}: #{role}") unless allowed_roles.include?(role)
            end
            next_role = transition["next_role"]
            abort("schema_error: next_role invalid #{workflow_id}: #{next_role}") unless allowed_roles.include?(next_role)
          end
        end

        puts "ok: schema"
        puts "ok: workflows #{workflows.keys.sort.join(", ")}"
        puts "ok: checkpoint metadata"
      ' "$catalog"
      info "ok: workflow catalog"
      ;;
    project-snapshot|project-dashboard|policy-evaluation)
      file=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          -h|--help)
            usage
            exit 0
            ;;
          -*)
            die "unknown validate $subject option: $1"
            ;;
          *)
            [ -z "$file" ] || die "validate $subject requires exactly one FILE"
            file="$1"
            ;;
        esac
        shift
      done
      [ -n "$file" ] || die "validate $subject requires exactly one FILE"
      [ -f "$file" ] || die "$subject file not found: $file"

      core="$(default_core_dir)"
      case "$subject" in
        project-snapshot)
          schema="$core/schemas/project_snapshot.schema.json"
          label="project snapshot"
          ;;
        project-dashboard)
          schema="$core/schemas/project_dashboard.schema.json"
          label="project dashboard"
          ;;
        policy-evaluation)
          schema="$core/schemas/policy_evaluation.schema.json"
          label="policy evaluation"
          ;;
      esac
      [ -f "$schema" ] || die "$label schema not found: $schema"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for $label validation"

      info "AI Ops $label validate"
      info "file: $file"
      ruby -rjson -e '
        data = JSON.parse(File.read(ARGV[0]))
        schema = JSON.parse(File.read(ARGV[1]))
        errors = []

        def valid_type?(value, type)
          case type
          when "object" then value.is_a?(Hash)
          when "array" then value.is_a?(Array)
          when "string" then value.is_a?(String)
          when "integer" then value.is_a?(Integer)
          when "number" then value.is_a?(Numeric)
          when "boolean" then value == true || value == false
          when "null" then value.nil?
          else true
          end
        end

        def validate_schema(value, schema, path, errors)
          return unless schema.is_a?(Hash)

          if schema.key?("const") && value != schema["const"]
            errors << "#{path}: expected const #{schema["const"].inspect}, got #{value.inspect}"
          end

          if schema.key?("enum") && !schema["enum"].include?(value)
            errors << "#{path}: expected one of #{schema["enum"].inspect}, got #{value.inspect}"
          end

          if schema.key?("type")
            types = Array(schema["type"])
            unless types.any? { |type| valid_type?(value, type) }
              errors << "#{path}: expected type #{types.join("|")}, got #{value.class}"
              return
            end
          end

          if value.is_a?(String) && schema.key?("minLength") && value.length < schema["minLength"].to_i
            errors << "#{path}: shorter than minLength #{schema["minLength"]}"
          end

          if value.is_a?(Numeric) && schema.key?("minimum") && value < schema["minimum"]
            errors << "#{path}: smaller than minimum #{schema["minimum"]}"
          end

          if value.is_a?(Array)
            if schema["uniqueItems"] && value.uniq.length != value.length
              errors << "#{path}: array items must be unique"
            end
            if schema["items"].is_a?(Hash)
              value.each_with_index do |item, index|
                validate_schema(item, schema["items"], "#{path}[#{index}]", errors)
              end
            end
          end

          if value.is_a?(Hash)
            Array(schema["required"]).each do |key|
              errors << "#{path}.#{key}: required property missing" unless value.key?(key)
            end

            properties = schema["properties"].is_a?(Hash) ? schema["properties"] : {}
            properties.each do |key, child_schema|
              validate_schema(value[key], child_schema, "#{path}.#{key}", errors) if value.key?(key)
            end

            additional = schema.fetch("additionalProperties", true)
            extra_keys = value.keys - properties.keys
            if additional == false && !extra_keys.empty?
              errors << "#{path}: unknown properties #{extra_keys.join(", ")}"
            elsif additional.is_a?(Hash)
              extra_keys.each do |key|
                validate_schema(value[key], additional, "#{path}.#{key}", errors)
              end
            end

            if schema["anyOf"].is_a?(Array)
              matched = schema["anyOf"].any? do |candidate|
                candidate_errors = []
                validate_schema(value, candidate, path, candidate_errors)
                candidate_errors.empty?
              end
              errors << "#{path}: did not match anyOf" unless matched
            end
          end
        end

        validate_schema(data, schema, "$", errors)
        abort("schema_error:\n" + errors.join("\n")) unless errors.empty?
        puts "ok: schema"
      ' "$file" "$schema"
      info "ok: $label"
      ;;
    project)
      target="$(pwd)"
      strict="no"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --strict)
            strict="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown validate project option: $1"
            ;;
        esac
        shift
      done
      validate_project "$target" "$strict"
      ;;
    *)
      die "unknown validate subject: $subject"
      ;;
  esac
}

cmd_task() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "task requires an action: create, status, transition, lock, unlock"
  shift

  case "$action" in
    create)
      target="$(pwd)"
      title=""
      workflow="feature"
      role="Lead Role"
      capability="planning"
      queue="active"
      status="proposed"
      priority="medium"
      allowed_path="."
      source_of_truth=".ai_project/source_of_truth.md"
      created_by="AI Ops CLI"
      task_id=""

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --title)
            shift
            [ "$#" -gt 0 ] || die "--title requires a value"
            title="$1"
            ;;
          --id)
            shift
            [ "$#" -gt 0 ] || die "--id requires a value"
            task_id="$1"
            ;;
          --workflow)
            shift
            [ "$#" -gt 0 ] || die "--workflow requires a value"
            workflow="$1"
            ;;
          --role)
            shift
            [ "$#" -gt 0 ] || die "--role requires a value"
            role="$1"
            ;;
          --capability)
            shift
            [ "$#" -gt 0 ] || die "--capability requires a value"
            capability="$1"
            ;;
          --queue)
            shift
            [ "$#" -gt 0 ] || die "--queue requires a value"
            queue="$1"
            ;;
          --status)
            shift
            [ "$#" -gt 0 ] || die "--status requires a value"
            status="$1"
            ;;
          --priority)
            shift
            [ "$#" -gt 0 ] || die "--priority requires a value"
            priority="$1"
            ;;
          --allowed-path)
            shift
            [ "$#" -gt 0 ] || die "--allowed-path requires a value"
            allowed_path="$1"
            ;;
          --source-of-truth)
            shift
            [ "$#" -gt 0 ] || die "--source-of-truth requires a value"
            source_of_truth="$1"
            ;;
          --created-by)
            shift
            [ "$#" -gt 0 ] || die "--created-by requires a value"
            created_by="$1"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown task create option: $1"
            ;;
        esac
        shift
      done

      [ -n "$title" ] || die "task create requires --title"
      case "$queue" in active|backlog|archive) ;; *) die "task create --queue must be active, backlog, or archive" ;; esac

      target="$(abs_path "$target")"
      task_require_project "$target"

      date_compact="$(date +%Y%m%d)"
      date_value="$(date +%Y-%m-%d)"
      [ -n "$task_id" ] || task_id="$(task_next_id "$target" "$date_compact")"
      task_file="$target/.ai_project/tasks/$queue/$task_id.md"
      [ ! -e "$task_file" ] || die "task already exists: ${task_file#$target/}"

      cat > "$task_file" <<EOF
---
schema: aiops.task.v1
id: $task_id
title: $title
status: $status
type: $workflow
priority: $priority
priority_reason:
org_unit:
team:
team_lead:
workflow: $workflow
target_agent:
target_role: $role
required_capabilities:
  - $capability
ownership:
  paths: []
  domains: []
  documents: []
ownership_review:
  required: false
  reviewer:
depends_on: []
blocks: []
parallel_group:
allowed_paths:
  - $allowed_path
source_of_truth:
  - $source_of_truth
created_by: $created_by
approved_by:
locked_by:
locked_at:
lock_session:
lock_timeout_minutes: 240
created_at: $date_value
updated_at: $date_value
report_to: .ai_project/reports/${task_id}_task-report.md
qa_to: .ai_project/qa/${task_id}_qa-report.md
status_ref:
status_ref_sha:
worktree_path:
worktree_role:
base_ref:
base_sha:
branch:
  name:
  base:
pr:
  url:
  status:
---

# $title

## 배경

## 작업 범위

## 완료 조건

## AI Ops CLI 기록

| 날짜 | Actor | Event | Reason |
|---|---|---|---|
| $date_value | $created_by | created: $status | task create |
EOF

      validate_front_matter task "$task_file" yes >/dev/null || {
        rm -f "$task_file"
        die "created task failed schema validation"
      }

      info "AI Ops task create"
      info "created: ${task_file#$target/}"
      info "task_id: $task_id"
      info "status: $status"
      info "target_role: $role"
      ;;

    status)
      target="$(pwd)"
      task_id=""
      source="local"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --source)
            shift
            [ "$#" -gt 0 ] || die "--source requires a value"
            source="$1"
            ;;
          -*)
            die "unknown task status option: $1"
            ;;
          *)
            [ -z "$task_id" ] || die "task status requires exactly one TASK_ID"
            task_id="$1"
            ;;
        esac
        shift
      done
      [ -n "$task_id" ] || die "task status requires TASK_ID"
      target="$(abs_path "$target")"
      case "$source" in local|canonical) ;; *) die "task status --source must be local or canonical" ;; esac

      if [ "$source" = "canonical" ]; then
        git_require_repo "$target"
        status_ref="$(canonical_status_ref_value "$target")"
        [ -n "$status_ref" ] || die "canonical_status_ref unresolved; run aiops status-ref"
        status_ref_sha="$(git_ref_sha "$target" "$status_ref")" || die "canonical_status_ref not found locally: $status_ref; run aiops sync-status"
        task_path="$(task_find_file_in_ref "$target" "$status_ref" "$task_id")"
        [ -n "$task_path" ] || die "task not found in $status_ref: $task_id"
        tmp_task="${TMPDIR:-/tmp}/aiops-canonical-task.$$"
        git -C "$target" show "$status_ref:$task_path" > "$tmp_task" || {
          rm -f "$tmp_task"
          die "failed to read task from $status_ref: $task_path"
        }

        info "AI Ops task status"
        info "source: canonical"
        info "status_ref: $status_ref"
        info "status_ref_sha: $status_ref_sha"
        info "task: $status_ref:$task_path"
        for field in id title status workflow target_role target_agent locked_by lock_session updated_at; do
          info "$field: $(task_yaml_field "$tmp_task" "$field")"
        done
        rm -f "$tmp_task"
        return 0
      fi

      task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"

      info "AI Ops task status"
      info "source: local"
      info "task: ${task_file#$target/}"
      for field in id title status workflow target_role target_agent locked_by lock_session updated_at; do
        info "$field: $(task_yaml_field "$task_file" "$field")"
      done
      ;;

    transition)
      target="$(pwd)"
      task_id=""
      to_status=""
      role=""
      actor=""
      reason="task transition"
      blocker=""
      next_decision=""

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --to)
            shift
            [ "$#" -gt 0 ] || die "--to requires a value"
            to_status="$1"
            ;;
          --role)
            shift
            [ "$#" -gt 0 ] || die "--role requires a value"
            role="$1"
            ;;
          --by)
            shift
            [ "$#" -gt 0 ] || die "--by requires a value"
            actor="$1"
            ;;
          --reason)
            shift
            [ "$#" -gt 0 ] || die "--reason requires a value"
            reason="$1"
            ;;
          --blocker)
            shift
            [ "$#" -gt 0 ] || die "--blocker requires a value"
            blocker="$1"
            ;;
          --next-decision)
            shift
            [ "$#" -gt 0 ] || die "--next-decision requires a value"
            next_decision="$1"
            ;;
          -*)
            die "unknown task transition option: $1"
            ;;
          *)
            [ -z "$task_id" ] || die "task transition requires exactly one TASK_ID"
            task_id="$1"
            ;;
        esac
        shift
      done

      [ -n "$task_id" ] || die "task transition requires TASK_ID"
      [ -n "$to_status" ] || die "task transition requires --to"
      [ -n "$role" ] || die "task transition requires --role"

      target="$(abs_path "$target")"
      task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      from_status="$(task_yaml_field "$task_file" status)"
      workflow="$(task_yaml_field "$task_file" workflow)"
      locked_by="$(task_yaml_field "$task_file" locked_by)"
      status_ref="$(canonical_status_ref_value "$target")"
      status_ref_sha=""
      canonical_status=""
      canonical_task_path=""

      if [ -n "$status_ref" ]; then
        git_require_repo "$target"
        status_ref_sha="$(git_ref_sha "$target" "$status_ref")" || die "canonical_status_ref not found locally: $status_ref; run aiops sync-status"
        local_status_ref_sha="$(task_yaml_field "$task_file" status_ref_sha)"

        if [ -n "$local_status_ref_sha" ] && [ "$local_status_ref_sha" != "$status_ref_sha" ]; then
          info "AI Ops canonical transition guard"
          info "task_id: $task_id"
          info "local_status: $from_status"
          info "canonical_status_ref: $status_ref"
          info "local_status_ref_sha: $local_status_ref_sha"
          info "canonical_status_sha: $status_ref_sha"
          info "next: run aiops sync-status and reload task state"
          die "local task status_ref_sha is stale against canonical_status_ref"
        fi

        canonical_task_path="$(task_find_file_in_ref "$target" "$status_ref" "$task_id" || true)"
        if [ -n "$canonical_task_path" ]; then
          tmp_task="${TMPDIR:-/tmp}/aiops-canonical-transition-task.$$"
          git -C "$target" show "$status_ref:$canonical_task_path" > "$tmp_task" || {
            rm -f "$tmp_task"
            die "failed to read task from $status_ref: $canonical_task_path"
          }
          canonical_status="$(task_yaml_field "$tmp_task" status)"
          rm -f "$tmp_task"

          if [ -z "$local_status_ref_sha" ] && [ -n "$canonical_status" ] && [ "$canonical_status" != "$from_status" ]; then
            info "AI Ops canonical transition guard"
            info "task_id: $task_id"
            info "local_status: $from_status"
            info "canonical_status: $canonical_status"
            info "canonical_status_ref: $status_ref"
            info "canonical_status_sha: $status_ref_sha"
            info "next: run aiops sync-status and reload task state"
            die "local task state is stale against canonical_status_ref"
          fi
        fi
      fi

      if [ -n "$locked_by" ]; then
        if [ -z "$actor" ] || [ "$actor" != "$locked_by" ]; then
          die "task is locked by $locked_by; transition denied"
        fi
      fi

      if ! task_transition_allowed "$target" "$workflow" "$from_status" "$to_status" "$role"; then
        die "invalid transition: $from_status -> $to_status by $role"
      fi

      if [ "$to_status" = "blocked" ]; then
        [ -n "$blocker" ] || blocker="$(task_yaml_field "$task_file" blocker)"
        [ -n "$next_decision" ] || next_decision="$(task_yaml_field "$task_file" next_decision)"
        [ -n "$blocker" ] || die "blocked transition requires --blocker"
        [ -n "$next_decision" ] || die "blocked transition requires --next-decision"
      fi

      next_role="$(task_next_role_for_status "$to_status")"
      checkpoint="$(workflow_status_field "$target" "$workflow" "$to_status" checkpoint)"
      canonical_publish="$(workflow_status_field "$target" "$workflow" "$to_status" canonical_publish)"
      status_meaning="$(workflow_status_field "$target" "$workflow" "$to_status" meaning)"
      date_value="$(date +%Y-%m-%d)"
      actor_label="${actor:-$role}"

      transition_tmp="${TMPDIR:-/tmp}/aiops-task-transition-${task_id}-$$.md"
      cp "$task_file" "$transition_tmp" || die "failed to stage task transition"

      case "$to_status" in
        in_progress)
          if [ -n "$status_ref" ]; then
            task_update_front_matter "$transition_tmp" \
              "status=$to_status" \
              "target_role=$next_role" \
              "updated_at=$date_value" \
              "locked_by=${actor_label}" \
              "locked_at=$date_value" \
              "status_ref=$status_ref" \
              "status_ref_sha=$status_ref_sha" \
              "base_ref=$status_ref" \
              "base_sha=$status_ref_sha"
          else
            task_update_front_matter "$transition_tmp" \
              "status=$to_status" \
              "target_role=$next_role" \
              "updated_at=$date_value" \
              "locked_by=${actor_label}" \
              "locked_at=$date_value"
          fi
          ;;
        *)
          if [ -n "$status_ref" ]; then
            task_update_front_matter "$transition_tmp" \
              "status=$to_status" \
              "target_role=${next_role:-__AIOPS_NULL__}" \
              "updated_at=$date_value" \
              "locked_by=__AIOPS_NULL__" \
              "locked_at=__AIOPS_NULL__" \
              "lock_session=__AIOPS_NULL__" \
              "blocker=${blocker:-__AIOPS_NULL__}" \
              "next_decision=${next_decision:-__AIOPS_NULL__}" \
              "status_ref=$status_ref" \
              "status_ref_sha=$status_ref_sha" \
              "base_ref=$status_ref" \
              "base_sha=$status_ref_sha"
          else
            task_update_front_matter "$transition_tmp" \
              "status=$to_status" \
              "target_role=${next_role:-__AIOPS_NULL__}" \
              "updated_at=$date_value" \
              "locked_by=__AIOPS_NULL__" \
              "locked_at=__AIOPS_NULL__" \
              "lock_session=__AIOPS_NULL__" \
              "blocker=${blocker:-__AIOPS_NULL__}" \
              "next_decision=${next_decision:-__AIOPS_NULL__}"
          fi
          ;;
      esac

      task_append_event "$transition_tmp" "transition: $from_status -> $to_status" "$actor_label" "$reason"
      if ! validate_front_matter task "$transition_tmp" yes >/dev/null; then
        rm -f "$transition_tmp"
        die "transition produced invalid task metadata"
      fi
      mv "$transition_tmp" "$task_file" || die "failed to apply task transition"

      info "AI Ops task transition"
      info "task_id: $task_id"
      info "from: $from_status"
      info "to: $to_status"
      info "workflow: $workflow"
      info "role: $role"
      info "next_role: $next_role"
      [ -z "$checkpoint" ] || info "checkpoint: $checkpoint"
      [ -z "$canonical_publish" ] || info "canonical_publish: $canonical_publish"
      [ -z "$status_meaning" ] || info "status_meaning: $status_meaning"
      case "$canonical_publish" in
        not_required)
          info "checkpoint_note: local/task branch state is enough for this status"
          ;;
        optional)
          info "checkpoint_note: canonical publish is optional for this status"
          ;;
        recommended)
          info "checkpoint_note: publish this checkpoint to the project canonical status ref when the next Agent should continue from it"
          ;;
        required)
          info "checkpoint_note: publish this checkpoint to the project canonical status ref before other Agents rely on it"
          ;;
      esac
      if [ -n "$status_ref" ]; then
        info "canonical_status_ref: $status_ref"
        info "canonical_status_sha: $status_ref_sha"
        info "canonical_task_status: ${canonical_status:-unresolved}"
      fi
      ;;

    lock)
      target="$(pwd)"
      task_id=""
      actor=""
      role=""
      session=""
      reason="task lock"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --by)
            shift
            [ "$#" -gt 0 ] || die "--by requires a value"
            actor="$1"
            ;;
          --role)
            shift
            [ "$#" -gt 0 ] || die "--role requires a value"
            role="$1"
            ;;
          --session)
            shift
            [ "$#" -gt 0 ] || die "--session requires a value"
            session="$1"
            ;;
          --reason)
            shift
            [ "$#" -gt 0 ] || die "--reason requires a value"
            reason="$1"
            ;;
          -*)
            die "unknown task lock option: $1"
            ;;
          *)
            [ -z "$task_id" ] || die "task lock requires exactly one TASK_ID"
            task_id="$1"
            ;;
        esac
        shift
      done

      [ -n "$task_id" ] || die "task lock requires TASK_ID"
      [ -n "$actor" ] || die "task lock requires --by"
      target="$(abs_path "$target")"
      task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      locked_by="$(task_yaml_field "$task_file" locked_by)"
      if [ -n "$locked_by" ] && [ "$locked_by" != "$actor" ]; then
        die "task is already locked by $locked_by"
      fi

      date_value="$(date +%Y-%m-%d)"
      task_update_front_matter "$task_file" \
        "locked_by=$actor" \
        "locked_at=$date_value" \
        "lock_session=${session:-__AIOPS_NULL__}" \
        "updated_at=$date_value"
      task_append_event "$task_file" "lock" "$actor" "$reason"

      info "AI Ops task lock"
      info "task_id: $task_id"
      info "locked_by: $actor"
      [ -z "$role" ] || info "role: $role"
      [ -z "$session" ] || info "session: $session"
      ;;

    unlock)
      target="$(pwd)"
      task_id=""
      actor=""
      reason="task unlock"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --by)
            shift
            [ "$#" -gt 0 ] || die "--by requires a value"
            actor="$1"
            ;;
          --reason)
            shift
            [ "$#" -gt 0 ] || die "--reason requires a value"
            reason="$1"
            ;;
          -*)
            die "unknown task unlock option: $1"
            ;;
          *)
            [ -z "$task_id" ] || die "task unlock requires exactly one TASK_ID"
            task_id="$1"
            ;;
        esac
        shift
      done

      [ -n "$task_id" ] || die "task unlock requires TASK_ID"
      [ -n "$actor" ] || die "task unlock requires --by"
      target="$(abs_path "$target")"
      task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      locked_by="$(task_yaml_field "$task_file" locked_by)"
      if [ -n "$locked_by" ] && [ "$locked_by" != "$actor" ]; then
        die "task is locked by $locked_by; unlock denied"
      fi

      date_value="$(date +%Y-%m-%d)"
      task_update_front_matter "$task_file" \
        "locked_by=__AIOPS_NULL__" \
        "locked_at=__AIOPS_NULL__" \
        "lock_session=__AIOPS_NULL__" \
        "updated_at=$date_value"
      task_append_event "$task_file" "unlock" "$actor" "$reason"

      info "AI Ops task unlock"
      info "task_id: $task_id"
      info "unlocked_by: $actor"
      ;;

    *)
      die "unknown task action: $action"
      ;;
  esac
}

cmd_action() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "action requires an action: plan, validate"
  shift

  case "$action" in
    plan)
      target="$(pwd)"
      role_input=""
      task_id=""
      intends="read_source,edit_allowed_paths,run_tests"
      paths=""
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --role)
            shift
            [ "$#" -gt 0 ] || die "--role requires a value"
            role_input="$1"
            ;;
          --task)
            shift
            [ "$#" -gt 0 ] || die "--task requires a value"
            task_id="$1"
            ;;
          --intends)
            shift
            [ "$#" -gt 0 ] || die "--intends requires a value"
            intends="$1"
            ;;
          --paths)
            shift
            [ "$#" -gt 0 ] || die "--paths requires a value"
            paths="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown action plan option: $1"
            ;;
        esac
        shift
      done

      [ "$json" = "yes" ] || die "action plan currently requires --json"
      [ -n "$role_input" ] || die "action plan requires --role"
      [ -n "$task_id" ] || die "action plan requires --task"
      role="$(normalize_role_name "$role_input")" || die "unknown role: $role_input"
      target="$(abs_path "$target")"
      [ -d "$target/.ai_project" ] || die ".ai_project missing; bootstrap project first"
      task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for action plan"
      aiops_path="$(script_dir)/$(basename "$0")"

      ruby -ryaml -rjson -rdate -rtime -rfind -ropen3 -e '
        aiops_path = ARGV[0]
        target = ARGV[1]
        role = ARGV[2]
        task_id = ARGV[3]
        task_file = ARGV[4]
        intends_raw = ARGV[5]
        paths_raw = ARGV[6]

        def front_matter(path)
          return {} unless File.file?(path)
          text = File.read(path)
          return {} unless text.start_with?("---\n")
          lines = text.lines
          closing = nil
          lines[1..].each_with_index do |line, idx|
            if line.strip == "---"
              closing = idx + 1
              break
            end
          end
          return {} unless closing
          YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
        rescue Psych::SyntaxError
          {}
        end

        def legacy_field(path, key)
          return nil unless File.file?(path)
          File.foreach(path) do |line|
            if line =~ /^[[:space:]]*#{Regexp.escape(key)}:[[:space:]]*(.*)$/
              value = Regexp.last_match(1).strip
              return nil if value.empty?
              return value.gsub(/\A`|`\z/, "")
            end
          end
          nil
        end

        def list(value)
          case value
          when Array then value.compact.map(&:to_s).map(&:strip).reject(&:empty?)
          when nil then []
          else value.to_s.split(",").map(&:strip).reject(&:empty?)
          end
        end

        def csv(value)
          value.to_s.split(",").map(&:strip).reject(&:empty?)
        end

        def normalize_intended_action(action)
          normalized = action.to_s.strip.downcase.tr("-", "_")
          aliases = {
            "pr" => "create_pr",
            "pull_request" => "create_pr",
            "create_pull_request" => "create_pr",
            "open_pr" => "create_pr",
            "lock" => "task_lock",
            "task_lock" => "task_lock",
            "unlock" => "task_unlock",
            "task_unlock" => "task_unlock",
            "handoff" => "create_handoff",
            "create_handoff" => "create_handoff",
            "external_config" => "external_configuration_changes",
            "external_configuration" => "external_configuration_changes",
            "external_configuration_change" => "external_configuration_changes",
            "external_configuration_changes" => "external_configuration_changes"
          }
          aliases.fetch(normalized, normalized)
        end

        def normalize(value)
          case value
          when Hash
            value.each_with_object({}) { |(key, item), out| out[key.to_s] = normalize(item) }
          when Array
            value.map { |item| normalize(item) }
          when Date, Time
            value.to_s
          else
            value
          end
        end

        def project_snapshot(aiops_path, target)
          stdout, stderr, status = Open3.capture3(aiops_path, "project", "snapshot", "--target", target, "--json")
          unless status.success?
            abort("error: project snapshot failed before action plan\n#{stderr}#{stdout}")
          end
          JSON.parse(stdout)
        rescue JSON::ParserError => error
          abort("error: project snapshot returned invalid JSON: #{error.message}")
        end

        def clean_relative_path(path)
          value = path.to_s.strip
          return nil if value.empty? || value.start_with?("/")
          parts = []
          value.split("/").each do |part|
            next if part.empty? || part == "."
            if part == ".."
              return nil if parts.empty?
              parts.pop
            else
              parts << part
            end
          end
          parts.empty? ? "." : parts.join("/")
        end

        def path_allowed?(path, allowed_paths)
          normalized = clean_relative_path(path)
          return false unless normalized
          return true if allowed_paths.empty?
          allowed_paths.any? do |allowed|
            prefix = clean_relative_path(allowed)
            next false unless prefix
            prefix == "." || normalized == prefix || normalized.start_with?(prefix.end_with?("/") ? prefix : "#{prefix}/")
          end
        end

        project_dir = File.join(target, ".ai_project")
        task = front_matter(task_file)
        allowed_intended_actions = %w[
          read_source
          edit_allowed_paths
          edit_paths
          run_tests
          task_transition
          task_lock
          task_unlock
          create_handoff
          commit
          push
          create_pr
          merge
          deploy
          external_configuration_changes
        ]
        intended_actions = csv(intends_raw).map { |action| normalize_intended_action(action) }
        unknown_actions = intended_actions - allowed_intended_actions
        abort("error: unknown intended action(s): #{unknown_actions.uniq.join(", ")}") unless unknown_actions.empty?
        requested_paths = csv(paths_raw)
        allowed_paths = list(task["allowed_paths"])
        snapshot = project_snapshot(aiops_path, target)
        source_refs = snapshot.fetch("source_refs", {})
        control = snapshot.fetch("control", {})
        snapshot_health = snapshot.dig("health", "overall")
        snapshot_can_start_task = control["can_start_task"] == true
        snapshot_can_transition = control["can_transition"] == true
        status_ref_state = source_refs["status_ref_state"]
        status_ref = source_refs["canonical_status_ref"]
        status_ref_sha = source_refs["canonical_status_sha"]
        recorded_sha = source_refs["recorded_status_sha"]
        snapshot_blockers = snapshot.fetch("checks", [])
          .select { |check| check.is_a?(Hash) && check["severity"] == "blocker" }
          .map { |check| check["id"] }
          .compact

        blocked_actions = []
        warnings = []
        approval_actions = %w[commit push create_pr merge deploy external_configuration_changes]
        requires_user_approval = (intended_actions & approval_actions)
        requires_user_approval << "external_configuration_changes" if intended_actions.include?("deploy")
        requires_user_approval << "external_configuration_changes" if intended_actions.include?("external_configuration_changes")

        target_role = task["target_role"] || legacy_field(task_file, "target_role")
        if target_role && target_role != role
          warnings << {
            "action" => "role_alignment",
            "reason" => "requested role differs from task target_role",
            "evidence" => { "role" => role, "target_role" => target_role }
          }
        end

        if intended_actions.include?("edit_paths") || intended_actions.include?("edit_allowed_paths")
          outside = requested_paths.reject { |path| path_allowed?(path, allowed_paths) }
          unless outside.empty?
            blocked_actions << {
              "action" => "edit_paths",
              "reason" => "requested path is outside task allowed_paths",
              "evidence" => { "requested_paths" => outside, "allowed_paths" => allowed_paths }
            }
          end
        end

        if intended_actions.include?("task_transition") && %w[ref_not_found_locally not_recorded recorded_stale].include?(status_ref_state)
          blocked_actions << {
            "action" => "task_transition",
            "reason" => "canonical status ref is not current",
            "evidence" => {
              "status_ref_state" => status_ref_state,
              "canonical_status_ref" => status_ref,
              "canonical_status_sha" => status_ref_sha,
              "recorded_status_sha" => recorded_sha
            }
          }
        end

        if intended_actions.empty?
          warnings << {
            "action" => "intended_actions",
            "reason" => "no intended actions declared",
            "evidence" => {}
          }
        end

        plan = normalize({
          "schema" => "aiops.action_plan.v1",
          "generated_at" => Time.now.utc.iso8601,
          "target" => target,
          "role" => role,
          "task_id" => task["id"] || task_id,
          "task" => {
            "path" => task_file.sub(%r{\A#{Regexp.escape(target)}/?}, ""),
            "status" => task["status"] || legacy_field(task_file, "status"),
            "workflow" => task["workflow"] || legacy_field(task_file, "workflow"),
            "target_role" => target_role,
            "target_agent" => task["target_agent"] || legacy_field(task_file, "target_agent")
          },
          "intended_actions" => intended_actions.uniq,
          "allowed_paths" => allowed_paths.uniq,
          "requested_paths" => requested_paths.uniq,
          "requires_user_approval" => requires_user_approval.uniq,
          "blocked_actions" => blocked_actions,
          "warnings" => warnings,
          "evidence" => {
            "snapshot_health" => snapshot_health,
            "can_start_task" => snapshot_can_start_task,
            "can_transition" => snapshot_can_transition,
            "status_ref_state" => status_ref_state,
            "canonical_status_ref" => status_ref,
            "canonical_status_sha" => status_ref_sha,
            "recorded_status_sha" => recorded_sha,
            "snapshot_blockers" => snapshot_blockers
          }
        })

        puts JSON.pretty_generate(plan)
      ' "$aiops_path" "$target" "$role" "$task_id" "$task_file" "$intends" "$paths"
      ;;
    validate)
      file=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          -h|--help)
            usage
            exit 0
            ;;
          -*)
            die "unknown action validate option: $1"
            ;;
          *)
            [ -z "$file" ] || die "action validate requires exactly one FILE"
            file="$1"
            ;;
        esac
        shift
      done
      [ -n "$file" ] || die "action validate requires exactly one FILE"
      [ -f "$file" ] || die "action plan file not found: $file"
      core="$(default_core_dir)"
      schema="$core/schemas/action_plan.schema.json"
      [ -f "$schema" ] || die "action plan schema not found: $schema"
      command -v ruby >/dev/null 2>&1 || die "ruby is required for action plan validation"
      info "AI Ops action plan validate"
      info "plan: $file"
      ruby -rjson -e '
        data = JSON.parse(File.read(ARGV[0]))
        schema = JSON.parse(File.read(ARGV[1]))
        errors = []

        def type_ok?(value, type)
          case type
          when "object" then value.is_a?(Hash)
          when "array" then value.is_a?(Array)
          when "string" then value.is_a?(String)
          when "boolean" then value == true || value == false
          when "null" then value.nil?
          else true
          end
        end

        def validate(value, schema, path, errors)
          return unless schema.is_a?(Hash)
          if schema.key?("$ref")
            ref = schema["$ref"].sub("#/$defs/", "")
            return validate(value, $defs[ref], path, errors)
          end
          if schema.key?("const") && value != schema["const"]
            errors << "#{path}: const mismatch"
          end
          if schema.key?("enum") && !schema["enum"].include?(value)
            errors << "#{path}: enum mismatch #{value.inspect}"
          end
          if schema.key?("type")
            types = Array(schema["type"])
            unless types.any? { |type| type_ok?(value, type) }
              errors << "#{path}: expected #{types.join("|")}, got #{value.class}"
              return
            end
          end
          if value.is_a?(String)
            errors << "#{path}: shorter than minLength" if schema["minLength"] && value.length < schema["minLength"].to_i
            errors << "#{path}: pattern mismatch" if schema["pattern"] && !value.match?(Regexp.new("\\A#{schema["pattern"]}\\z"))
          end
          if value.is_a?(Array)
            errors << "#{path}: array items must be unique" if schema["uniqueItems"] && value.uniq.length != value.length
            if schema["items"]
              value.each_with_index { |item, index| validate(item, schema["items"], "#{path}[#{index}]", errors) }
            end
          end
          if value.is_a?(Hash)
            Array(schema["required"]).each { |key| errors << "#{path}.#{key}: required property missing" unless value.key?(key) }
            properties = schema["properties"].is_a?(Hash) ? schema["properties"] : {}
            properties.each { |key, child| validate(value[key], child, "#{path}.#{key}", errors) if value.key?(key) }
            extra = value.keys - properties.keys
            errors << "#{path}: unknown properties #{extra.join(", ")}" if schema["additionalProperties"] == false && !extra.empty?
          end
        end

        $defs = schema["$defs"] || {}
        validate(data, schema, "$", errors)

        approval_actions = %w[commit push create_pr merge deploy external_configuration_changes]
        missing_approval = data.fetch("intended_actions", []) & approval_actions
        missing_approval -= data.fetch("requires_user_approval", [])
        errors << "$.requires_user_approval: missing approval actions #{missing_approval.join(", ")}" unless missing_approval.empty?

        def clean_relative_path(path)
          value = path.to_s.strip
          return nil if value.empty? || value.start_with?("/")
          parts = []
          value.split("/").each do |part|
            next if part.empty? || part == "."
            if part == ".."
              return nil if parts.empty?
              parts.pop
            else
              parts << part
            end
          end
          parts.empty? ? "." : parts.join("/")
        end

        def path_allowed?(path, allowed)
          normalized = clean_relative_path(path)
          return false unless normalized
          return true if allowed.empty?
          allowed.any? do |prefix_raw|
            prefix = clean_relative_path(prefix_raw)
            next false unless prefix
            prefix == "." || normalized == prefix || normalized.start_with?(prefix.end_with?("/") ? prefix : "#{prefix}/")
          end
        end

        if data.fetch("intended_actions", []).include?("edit_paths") || data.fetch("intended_actions", []).include?("edit_allowed_paths")
          requested = data.fetch("requested_paths", [])
          allowed = data.fetch("allowed_paths", [])
          outside = requested.reject { |path| path_allowed?(path, allowed) }
          has_blocker = data.fetch("blocked_actions", []).any? { |item| item["action"] == "edit_paths" }
          errors << "$.blocked_actions: missing edit_paths blocker" if outside.any? && !has_blocker
        end

        stale_states = %w[ref_not_found_locally not_recorded recorded_stale]
        if data.fetch("intended_actions", []).include?("task_transition") &&
            (stale_states.include?(data.dig("evidence", "status_ref_state").to_s) || data.dig("evidence", "can_transition") == false)
          has_blocker = data.fetch("blocked_actions", []).any? { |item| item["action"] == "task_transition" }
          errors << "$.blocked_actions: missing task_transition blocker" unless has_blocker
        end

        abort("schema_error:\n" + errors.join("\n")) unless errors.empty?
        puts "ok: schema"
      ' "$file" "$schema"
      info "ok: action plan"
      ;;
    *)
      die "unknown action subcommand: $action"
      ;;
  esac
}

cmd_handoff() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "handoff requires an action: create, validate"
  shift

  case "$action" in
    create)
      target="$(pwd)"
      task_id=""
      from_role=""
      to_role=""
      from_agent=""
      to_agent=""
      next_action=""
      summary="handoff created"
      validation_result="not_run"
      force="no"
      report_paths=""
      changed_paths=""
      risks=""
      blockers=""
      open_questions=""

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --from)
            shift
            [ "$#" -gt 0 ] || die "--from requires a value"
            from_role="$1"
            ;;
          --to)
            shift
            [ "$#" -gt 0 ] || die "--to requires a value"
            to_role="$1"
            ;;
          --from-agent)
            shift
            [ "$#" -gt 0 ] || die "--from-agent requires a value"
            from_agent="$1"
            ;;
          --to-agent)
            shift
            [ "$#" -gt 0 ] || die "--to-agent requires a value"
            to_agent="$1"
            ;;
          --next-action)
            shift
            [ "$#" -gt 0 ] || die "--next-action requires a value"
            next_action="$1"
            ;;
          --summary)
            shift
            [ "$#" -gt 0 ] || die "--summary requires a value"
            summary="$1"
            ;;
          --report)
            shift
            [ "$#" -gt 0 ] || die "--report requires a value"
            report_paths="${report_paths}
$1"
            ;;
          --changed-path)
            shift
            [ "$#" -gt 0 ] || die "--changed-path requires a value"
            changed_paths="${changed_paths}
$1"
            ;;
          --risk)
            shift
            [ "$#" -gt 0 ] || die "--risk requires a value"
            risks="${risks}
$1"
            ;;
          --blocker)
            shift
            [ "$#" -gt 0 ] || die "--blocker requires a value"
            blockers="${blockers}
$1"
            ;;
          --open-question)
            shift
            [ "$#" -gt 0 ] || die "--open-question requires a value"
            open_questions="${open_questions}
$1"
            ;;
          --validation-result)
            shift
            [ "$#" -gt 0 ] || die "--validation-result requires a value"
            validation_result="$1"
            ;;
          --force)
            force="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          -*)
            die "unknown handoff create option: $1"
            ;;
          *)
            [ -z "$task_id" ] || die "handoff create requires exactly one TASK_ID"
            task_id="$1"
            ;;
        esac
        shift
      done

      [ -n "$task_id" ] || die "handoff create requires TASK_ID"
      [ -n "$from_role" ] || die "handoff create requires --from"
      [ -n "$to_role" ] || die "handoff create requires --to"
      [ -n "$next_action" ] || die "handoff create requires --next-action"

      target="$(abs_path "$target")"
      task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      handoff_dir="$target/.ai_project/handoffs"
      mkdir -p "$handoff_dir"

      current_status="$(task_yaml_field "$task_file" status)"
      source_of_truth="$(task_yaml_field "$task_file" source_of_truth)"
      allowed_paths="$(task_yaml_field "$task_file" allowed_paths)"
      task_report="$(task_yaml_field "$task_file" report_to)"
      qa_report="$(task_yaml_field "$task_file" qa_to)"
      status_ref="$(canonical_status_ref_value "$target")"
      status_ref_sha=""
      if [ -n "$status_ref" ] && git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        status_ref_sha="$(git_ref_sha "$target" "$status_ref" || true)"
      fi
      worktree_path="$target"
      date_value="$(date +%Y-%m-%d)"
      from_slug="$(role_slug "$from_role")"
      to_slug="$(role_slug "$to_role")"
      handoff_file="$handoff_dir/${task_id}_${from_slug}_to_${to_slug}.md"

      if [ -e "$handoff_file" ] && [ "$force" != "yes" ]; then
        die "handoff already exists: ${handoff_file#$target/}; use --force to replace"
      fi

      if [ -z "$report_paths" ]; then
        [ -z "$task_report" ] || report_paths="${report_paths}
$task_report"
        [ -z "$qa_report" ] || report_paths="${report_paths}
$qa_report"
      fi

      ruby -ryaml -e '
        path = ARGV[0]
        task_id = ARGV[1]
        from_role = ARGV[2]
        to_role = ARGV[3]
        from_agent = ARGV[4]
        to_agent = ARGV[5]
        current_status = ARGV[6]
        next_action = ARGV[7]
        status_ref = ARGV[8]
        status_ref_sha = ARGV[9]
        worktree_path = ARGV[10]
        source_of_truth = ARGV[11]
        allowed_paths = ARGV[12]
        report_paths = ARGV[13]
        changed_paths = ARGV[14]
        validation_result = ARGV[15]
        risks = ARGV[16]
        blockers = ARGV[17]
        open_questions = ARGV[18]
        created_at = ARGV[19]
        summary = ARGV[20]

        def list(value)
          value.to_s.lines.map(&:strip).reject(&:empty?).flat_map { |line| line.split(",").map(&:strip) }.reject(&:empty?)
        end

        data = {
          "schema" => "aiops.handoff.v1",
          "task_id" => task_id,
          "from_role" => from_role,
          "to_role" => to_role,
          "from_agent" => from_agent.empty? ? nil : from_agent,
          "to_agent" => to_agent.empty? ? nil : to_agent,
          "current_status" => current_status,
          "next_action" => next_action,
          "status_ref" => status_ref.empty? ? nil : status_ref,
          "status_ref_sha" => status_ref_sha.empty? ? nil : status_ref_sha,
          "worktree_path" => worktree_path.empty? ? nil : worktree_path,
          "worktree_role" => nil,
          "source_of_truth" => list(source_of_truth),
          "allowed_paths" => list(allowed_paths),
          "report_paths" => list(report_paths),
          "changed_or_affected_paths" => list(changed_paths),
          "validation_result" => validation_result,
          "risks" => list(risks),
          "blockers" => list(blockers),
          "open_questions" => list(open_questions),
          "created_at" => created_at,
          "created_by" => from_agent.empty? ? from_role : from_agent
        }

        body = <<~MD
          # Handoff: #{task_id}

          ## 다음 Agent에게 전달할 말

          너는 #{to_agent.empty? ? "다음 Agent" : to_agent} / #{to_role}이야.
          Task #{task_id}를 이어서 처리해줘.

          - 현재 상태: #{current_status}
          - 기준 상태 ref: #{status_ref.empty? ? "unresolved" : status_ref}
          - 기준 상태 SHA: #{status_ref_sha.empty? ? "unresolved" : status_ref_sha}
          - 다음에 해야 할 일: #{next_action}
          - 기준 문서: #{data["source_of_truth"].join(", ")}
          - 허용 경로: #{data["allowed_paths"].join(", ")}
          - 참고 산출물: #{data["report_paths"].empty? ? "없음" : data["report_paths"].join(", ")}
          - 변경/검토 대상: #{data["changed_or_affected_paths"].empty? ? "미기록" : data["changed_or_affected_paths"].join(", ")}
          - 남은 리스크: #{data["risks"].empty? ? "없음" : data["risks"].join(", ")}
          - 차단/결정 필요: #{data["blockers"].empty? ? "없음" : data["blockers"].join(", ")}
          - 주의: 현재 Task의 workflow, status, target_agent, target_role이 네 Role과 맞는지 먼저 확인해줘.

          먼저 확인:

          ```bash
          aiops task status #{task_id}
          aiops task status #{task_id} --source canonical
          aiops handoff validate #{task_id} --strict
          ```

          ## 인계 기록

          | 날짜 | From | To | 상태 | 요약 |
          |---|---|---|---|---|
          | #{created_at} | #{from_role} | #{to_role} | #{current_status} | #{summary} |
        MD

        File.write(path, YAML.dump(data) + "---\n\n" + body)
      ' "$handoff_file" "$task_id" "$from_role" "$to_role" "$from_agent" "$to_agent" "$current_status" "$next_action" "$status_ref" "$status_ref_sha" "$worktree_path" "$source_of_truth" "$allowed_paths" "$report_paths" "$changed_paths" "$validation_result" "$risks" "$blockers" "$open_questions" "$date_value" "$summary"

      validate_front_matter handoff "$handoff_file" yes >/dev/null || {
        rm -f "$handoff_file"
        die "created handoff failed schema validation"
      }
      task_append_event "$task_file" "handoff: $from_role -> $to_role" "${from_agent:-$from_role}" "$summary"

      info "AI Ops handoff create"
      info "created: ${handoff_file#$target/}"
      info "task_id: $task_id"
      info "from_role: $from_role"
      info "to_role: $to_role"
      info "current_status: $current_status"
      ;;

    validate)
      target="$(pwd)"
      value=""
      strict="no"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --strict)
            strict="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          -*)
            die "unknown handoff validate option: $1"
            ;;
          *)
            [ -z "$value" ] || die "handoff validate requires exactly one FILE or TASK_ID"
            value="$1"
            ;;
        esac
        shift
      done
      [ -n "$value" ] || die "handoff validate requires FILE or TASK_ID"
      target="$(abs_path "$target")"
      handoff_file="$(handoff_find_file "$target" "$value")" || die "handoff not found: $value"
      info "AI Ops handoff validate"
      info "handoff: ${handoff_file#$target/}"
      validate_front_matter handoff "$handoff_file" "$strict"
      info "ok: handoff metadata"
      ;;

    *)
      die "unknown handoff action: $action"
      ;;
  esac
}

cmd_session_guide() {
  target="$(pwd)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown session-guide option: $1"
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"

  info "AI Ops session guide"
  info "target: $target"
  info ""

  if [ ! -d "$target/.ai_project" ]; then
    info "missing: .ai_project"
    info "먼저 AI Ops bootstrap을 완료하세요."
    return 1
  fi

  info "세션 유형:"
  info "  - orchestration_session: Lead/Direction이 Task와 인계를 조율"
  info "  - role_session: 특정 Role 책임을 맡은 독립 Agent 세션"
  info "  - delegated_worker: 현재 세션 안의 좁은 보조 작업자"
  info ""
  info "선택 기준:"
  info "  - 무엇을 만들지 정해야 함: Direction Role"
  info "  - Task 범위/우선순위/담당을 정해야 함: Lead Role"
  info "  - 승인된 Task를 구현해야 함: Execution Role"
  info "  - 구현 결과를 독립 검증해야 함: Verification Role"
  info "  - 완료 처리/잔여 리스크 판단이 필요함: Completion Role"
  info "  - 운영모델/마이그레이션/정책 충돌을 봐야 함: Ops Governance Role"
  info ""
  info "기본 원칙:"
  info "  - Execution과 Verification은 가능하면 별도 Role Session으로 분리합니다."
  info "  - delegated_worker는 독립 Verification/Completion을 대체하지 않습니다."
  info "  - 세션 전환은 Task status, target_role, lock, handoff로 기록합니다."
  info "  - 여러 worktree를 쓰면 먼저 aiops sync-status로 canonical status ref와 SHA를 확인합니다."
  info ""

  info "활성 Agent / Role 후보:"
  if [ -f "$target/.ai_project/agent_registry.md" ]; then
    agent_rows="$(print_agent_registry_rows "$target/.ai_project/agent_registry.md" || true)"
    if [ -n "$agent_rows" ]; then
      printf '%s\n' "$agent_rows" | while IFS= read -r line; do
        info "$line"
      done
    else
      info "      - agent_registry.md에서 표시할 Agent/Role을 찾지 못함"
    fi
  else
    info "      - .ai_project/agent_registry.md 없음"
  fi
  info ""

  info "현재 초점:"
  if [ -f "$target/.ai_project/current_context.md" ]; then
    focus_rows="$(print_current_focus_rows "$target/.ai_project/current_context.md" || true)"
    if [ -n "$focus_rows" ]; then
      printf '%s\n' "$focus_rows" | while IFS= read -r line; do
        info "$line"
      done
    else
      info "      - current_context.md에 현재 초점이 비어 있음"
    fi
  elif [ -f "$target/.ai_project/task_board.md" ]; then
    focus_rows="$(print_current_focus_rows "$target/.ai_project/task_board.md" || true)"
    if [ -n "$focus_rows" ]; then
      printf '%s\n' "$focus_rows" | while IFS= read -r line; do
        info "$line"
      done
    else
      info "      - task_board.md에 현재 초점이 비어 있음"
    fi
  else
    info "      - current_context.md 없음"
  fi
  info ""

  info "추천 다음 세션:"
  info "  - 제품 방향/요구사항을 정리하려면:"
  info "      aiops role prompt direction --target \"$target\""
  info "  - 다음 Task를 등록/조율하려면:"
  info "      aiops role prompt lead --target \"$target\""
  info "  - 승인된 Task를 실행하려면:"
  info "      aiops role prompt execution --target \"$target\" --task TASK_ID"
  info "  - 운영모델 자체를 점검하려면:"
  info "      aiops role prompt ops --target \"$target\""
  info ""

  info "Role Session 시작 문구 생성:"
  info "  aiops role prompt lead --target \"$target\""
  info "  aiops role prompt execution --target \"$target\" --task TASK_ID"
  info "  aiops role prompt verification --target \"$target\" --task TASK_ID"
  info "  aiops role prompt completion --target \"$target\" --task TASK_ID"
  info "  aiops role prompt ops --target \"$target\""
  info ""
  info "Role Session 실행 계약 확인:"
  info "  aiops project context --role execution --target \"$target\" --task TASK_ID"
  info "  aiops project context --role lead --target \"$target\""
  info ""
  info "Codex / Claude 지정 예시:"
  info "  aiops role prompt execution --adapter codex --task TASK_ID"
  info "  aiops role prompt verification --adapter claude --task TASK_ID"
}

cmd_policy() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "policy requires an action: evaluate"
  shift

  case "$action" in
    evaluate)
      target="$(pwd)"
      target_explicit="no"
      snapshot_file=""
      strict_level=""
      json="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            target_explicit="yes"
            ;;
          --snapshot)
            shift
            [ "$#" -gt 0 ] || die "--snapshot requires a value"
            snapshot_file="$1"
            ;;
          --strict-level)
            shift
            [ "$#" -gt 0 ] || die "--strict-level requires a value"
            strict_level="$1"
            ;;
          --json)
            json="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown policy evaluate option: $1"
            ;;
        esac
        shift
      done

      [ "$json" = "yes" ] || die "policy evaluate currently requires --json"
      [ "$target_explicit" = "no" ] || [ -z "$snapshot_file" ] || die "policy evaluate accepts either --target or --snapshot, not both"
      [ -z "$snapshot_file" ] || [ -f "$snapshot_file" ] || die "snapshot file not found: $snapshot_file"
      target="$(abs_path "$target")"
      aiops_path="$(script_dir)/$(basename "$0")"
      core="$(default_core_dir)"
      if [ -n "$snapshot_file" ]; then
        "$aiops_path" validate project-snapshot "$snapshot_file" >/dev/null || die "snapshot failed project-snapshot schema validation: $snapshot_file"
      fi
      command -v ruby >/dev/null 2>&1 || die "ruby is required for policy evaluation"

      ruby -rjson -rtime -ropen3 -e '
        aiops_path = ARGV[0]
        target = ARGV[1]
        snapshot_file = ARGV[2]
        strict_level_arg = ARGV[3]
        core = ARGV[4]

        def project_snapshot(aiops_path, target)
          stdout, stderr, status = Open3.capture3(aiops_path, "project", "snapshot", "--target", target, "--json")
          unless status.success?
            abort("error: project snapshot failed before policy evaluation\n#{stderr}#{stdout}")
          end
          JSON.parse(stdout)
        rescue JSON::ParserError => error
          abort("error: project snapshot returned invalid JSON: #{error.message}")
        end

        def value_at_path(data, path)
          current = data
          path.to_s.split(".").each do |part|
            return nil unless current.is_a?(Hash)
            return nil unless current.key?(part)
            current = current[part]
          end
          current
        end

        def condition_matches?(snapshot, key, expected)
          if key.start_with?("checks.")
            check_id = key.split(".", 2)[1]
            present = snapshot.fetch("checks", []).any? { |check| check.is_a?(Hash) && check["id"] == check_id }
            return present if expected == "present"
            return !present if expected == "absent"
            return present == expected if expected == true || expected == false
            return false
          end

          actual = value_at_path(snapshot, key)
          case expected
          when Array
            expected.include?(actual)
          when "present"
            !actual.nil?
          when "absent"
            actual.nil?
          else
            actual == expected
          end
        end

        def evaluate_policy(policy_rules_path, snapshot, strict_level_arg)
          summary = { "info" => 0, "warn" => 0, "blocker" => 0 }
          unless File.file?(policy_rules_path)
            level = strict_level_arg.to_s.empty? ? "basic" : strict_level_arg
            abort("error: unknown strict level: #{level}") unless %w[basic team regulated].include?(level)
            return {
              "catalog_present" => false,
              "strict_level" => level,
              "matched_rules" => [],
              "summary" => summary
            }
          end

          catalog = JSON.parse(File.read(policy_rules_path))
          levels = Array(catalog["strict_levels"]).map { |level| level.is_a?(Hash) ? level["id"] : nil }.compact
          level =
            if strict_level_arg.to_s.empty?
              value_at_path(snapshot, "project.policy_level") || "basic"
            else
              strict_level_arg
            end
          abort("error: unknown strict level: #{level}") unless levels.include?(level)

          matched = []
          Array(catalog["rules"]).each do |rule|
            next unless rule.is_a?(Hash)
            next unless Array(rule["applies_to"]).include?(level)
            conditions = rule["when"]
            next unless conditions.is_a?(Hash) && conditions.all? { |key, expected| condition_matches?(snapshot, key, expected) }
            severity = rule["severity"].to_s
            summary[severity] += 1 if summary.key?(severity)
            evidence = {}
            conditions.each_key do |key|
              evidence[key] = key.start_with?("checks.") ? "present" : value_at_path(snapshot, key)
            end
            matched << {
              "id" => rule["id"],
              "severity" => severity,
              "message" => rule["message"],
              "source" => rule["source"],
              "evidence" => evidence
            }
          end

          {
            "catalog_present" => true,
            "strict_level" => level,
            "matched_rules" => matched,
            "summary" => summary
          }
        rescue JSON::ParserError => error
          abort("error: policy rules JSON invalid: #{error.message}")
        end

        snapshot =
          if snapshot_file.to_s.empty?
            project_snapshot(aiops_path, target)
          else
            JSON.parse(File.read(snapshot_file))
          end
        evaluation_target =
          if snapshot_file.to_s.empty?
            target
          else
            snapshot["target"].to_s.empty? ? target : snapshot["target"]
          end
        policy_rules_path = File.join(evaluation_target, ".ai", "runtime", "policy_rules.json")
        policy_rules_path = File.join(core, "runtime", "policy_rules.json") unless File.file?(policy_rules_path)
        policy = evaluate_policy(policy_rules_path, snapshot, strict_level_arg)
        result = {
          "schema" => "aiops.policy_evaluation.v1",
          "generated_at" => Time.now.utc.iso8601,
          "strict_level" => policy["strict_level"],
          "catalog_present" => policy["catalog_present"],
          "matched_rules" => policy["matched_rules"],
          "summary" => policy["summary"]
        }
        puts JSON.pretty_generate(result)
      ' "$aiops_path" "$target" "$snapshot_file" "$strict_level" "$core"
      ;;
    *)
      die "unknown policy action: $action"
      ;;
  esac
}

cmd_role() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "role requires an action: prompt"
  shift

  case "$action" in
    prompt)
      role_input="${1:-}"
      [ "$#" -gt 0 ] || die "role prompt requires ROLE"
      shift

      role="$(normalize_role_name "$role_input")" || die "unknown role: $role_input"
      target="$(pwd)"
      task_id=""
      adapter="generic"
      agent=""

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --task)
            shift
            [ "$#" -gt 0 ] || die "--task requires a value"
            task_id="$1"
            ;;
          --adapter)
            shift
            [ "$#" -gt 0 ] || die "--adapter requires a value"
            adapter="$1"
            ;;
          --agent)
            shift
            [ "$#" -gt 0 ] || die "--agent requires a value"
            agent="$1"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown role prompt option: $1"
            ;;
        esac
        shift
      done

      case "$adapter" in codex|claude|generic) ;; *) die "--adapter must be codex, claude, or generic" ;; esac

      target="$(abs_path "$target")"
      [ -n "$agent" ] || agent="$(role_default_agent "$role")"

      task_file=""
      if [ -n "$task_id" ]; then
        task_file="$(task_find_file "$target" "$task_id")" || die "task not found: $task_id"
      fi

      info "AI Ops role prompt"
      info "target: $target"
      info "adapter: $adapter"
      info "role: $role"
      info "agent: $agent"
      [ -z "$task_file" ] || info "task: ${task_file#$target/}"
      info ""
      info "아래 문구를 새 Agent 세션의 첫 메시지로 사용하세요."
      info ""
      info "----- ROLE SESSION PROMPT START -----"
      info "너는 이 프로젝트의 $agent / $role 세션이야."
      info ""
      info "먼저 다음 문서를 확인해줘."
      info "- .ai/runtime/workflow.md"
      info "- .ai/runtime/workflows.json"
      info "- .ai/runtime/task_queue.md"
      info "- .ai/runtime/role_handoff.md"
      info "- .ai/policies/shared_status_policy.md"
      info "- .ai/policies/session_orchestration_policy.md"
      info "- .ai_project/operating_model.md"
      info "- .ai_project/agent_registry.md"
      info "- .ai_project/current_context.md"
      info "- .ai_project/task_board.md"
      info "- .ai_project/source_of_truth.md"
      info "- 필요한 경우 .ai_knowledge/context_packs/"
      info ""
      info "세션 규칙:"
      info "- 현재 세션은 role_session이다."
      info "- 한 세션이 여러 Role을 연속 수행하려면 workflow 또는 사용자 명시 승인이 필요하다."
      info "- delegated_worker를 사용할 수 있어도 독립 Role Session을 대체하지 않는다."
      info "- 상태 전이, lock, handoff는 aiops CLI 명령으로 처리한다."
      info "- Role이 바뀌면 최종 응답에 '다음 Agent에게 전달할 말'을 남긴다."
      info "- 다중 worktree 환경에서는 현재 worktree 문서를 최신 공용 상태로 가정하지 않는다."
      info "- 작업 상태 판단 전 canonical status ref와 SHA를 확인한다."
      info "- .ai_project/.runtime/status_ref는 로컬 runtime cache이므로 commit/PR에 포함하지 않는다."
      info "- 실제 파일 수정, 상태 전이, lock, handoff, commit, push, PR, merge, deploy, 외부 설정 변경 전에는 aiops action plan으로 의도와 차단 항목을 확인한다."
      info "- Action Plan의 blocked_actions가 있으면 진행하지 않고 이유와 evidence를 사용자에게 요약한다."
      info "- Action Plan의 requires_user_approval 항목은 사용자 승인 전 실행하지 않는다."
      info "- 사용자 승인 없이 commit, push, PR, merge, deploy, 외부 설정 변경을 진행하지 않는다."
      info ""
      info "이 Role의 책임:"
      role_responsibility_text "$role"
      info ""

      if [ -n "$task_file" ]; then
        status="$(task_yaml_field "$task_file" status)"
        target_role="$(task_yaml_field "$task_file" target_role)"
        allowed_paths="$(task_yaml_field "$task_file" allowed_paths)"
        source_of_truth="$(task_yaml_field "$task_file" source_of_truth)"
        locked_by="$(task_yaml_field "$task_file" locked_by)"

        info "대상 Task:"
        info "- task_id: $task_id"
        info "- task_file: ${task_file#$target/}"
        info "- current_status: $status"
        info "- target_role: $target_role"
        info "- allowed_paths: $allowed_paths"
        info "- source_of_truth: $source_of_truth"
        info "- locked_by: $locked_by"
        info ""
        info "작업 시작 전 확인:"
        info "- aiops project context --role \"$role\" --target \"$target\" --task $task_id"
        info "- aiops status-ref --target \"$target\""
        info "- aiops sync-status --target \"$target\""
        info "- aiops task status $task_id --target \"$target\""
        info "- 필요하면 aiops task status $task_id --target \"$target\" --source canonical"
        info "- 실제 행동 전 aiops action plan --role \"$role\" --target \"$target\" --task $task_id --intends ACTIONS --paths PATHS --json"
        info "- 현재 Role이 Task의 status/target_role과 맞는지 확인한다."
        info "- allowed_paths 밖 파일은 수정하지 않는다."
        info "- action plan에 blocked_actions가 있으면 작업하지 말고 사용자에게 차단 사유를 보고한다."
        info ""

        case "$role" in
          "Execution Role")
            info "Execution 진행 기준:"
            info "- 실행 가능하면 aiops task transition $task_id --target \"$target\" --to in_progress --role \"Execution Role\" --by \"$agent\""
            info "- 완료 전 자체 테스트/검증 결과를 task report에 남긴다."
            info "- 완료 후 aiops handoff create $task_id --target \"$target\" --from \"Execution Role\" --to \"Verification Role\" --next-action \"작업 결과 독립 검증\""
            info "- handoff 생성 후 aiops task transition $task_id --target \"$target\" --to verification_ready --role \"Execution Role\" --by \"$agent\""
            ;;
          "Verification Role")
            info "Verification 진행 기준:"
            info "- 검증 시작 시 aiops task transition $task_id --target \"$target\" --to verification_in_progress --role \"Verification Role\" --by \"$agent\""
            info "- PASS/PASS_WITH_RISK/FAIL/BLOCKED 중 하나로 결과를 명확히 남긴다."
            info "- 통과 시 Completion 인계를 만들고 verification_passed로 전환한다."
            info "- 실패 또는 차단 시 Lead Role로 rework_requested 또는 blocked 인계를 남긴다."
            ;;
          "Completion Role")
            info "Completion 진행 기준:"
            info "- 검증 결과와 남은 리스크를 확인한다."
            info "- 완료 가능하면 completion_review를 거쳐 done으로 전환한다."
            info "- 완료가 어렵다면 Lead Role로 rework/blocked 인계를 남긴다."
            ;;
          "Lead Role")
            info "Lead 진행 기준:"
            info "- Task 범위와 ownership을 정리한다."
            info "- 승인 전에는 Execution Role에게 구현을 시작시키지 않는다."
            info "- 승인된 실행 Task는 Execution Role로 인계한다."
            ;;
        esac
        info ""
      else
        info "작업 시작 전 확인:"
        info "- aiops project context --role \"$role\" --target \"$target\""
        info "- aiops project inspect --target \"$target\""
        info "- aiops validate project --target \"$target\" --strict"
        info ""
      fi

      case "$adapter" in
        codex)
          info "Codex 참고:"
          info "- AGENTS.md의 AI Ops 지침을 우선 확인한다."
          ;;
        claude)
          info "Claude 참고:"
          info "- CLAUDE.md의 AI Ops 지침을 우선 확인한다."
          ;;
        generic)
          info "Adapter 참고:"
          info "- Codex면 AGENTS.md, Claude면 CLAUDE.md를 확인한다."
          ;;
      esac
      info "----- ROLE SESSION PROMPT END -----"
      ;;
    *)
      die "unknown role action: $action"
      ;;
  esac
}

cmd_knowledge() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "knowledge requires an action: init, pack, lint, status"
  shift

  target="$(pwd)"
  mode="minimal"
  force="no"
  core="$(default_core_dir)"
  pack_topic=""
  pack_create="no"
  pack_task=""
  pack_source=".ai_project/source_of_truth.md"
  pack_purpose=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      --mode)
        shift
        [ "$#" -gt 0 ] || die "--mode requires a value"
        mode="$1"
        ;;
      --force)
        force="yes"
        ;;
      --create)
        pack_create="yes"
        ;;
      --task)
        shift
        [ "$#" -gt 0 ] || die "--task requires a value"
        pack_task="$1"
        ;;
      --source)
        shift
        [ "$#" -gt 0 ] || die "--source requires a value"
        pack_source="$1"
        ;;
      --purpose)
        shift
        [ "$#" -gt 0 ] || die "--purpose requires a value"
        pack_purpose="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        if [ "$action" = "pack" ] && [ -z "$pack_topic" ]; then
          pack_topic="$1"
        else
          die "unknown knowledge option: $1"
        fi
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"
  core="$(abs_path "$core")"
  knowledge_dir="$target/.ai_knowledge"

  case "$action" in
    init)
      case "$mode" in
        minimal|full) ;;
        *) die "unknown knowledge mode: $mode" ;;
      esac

      [ -d "$target" ] || die "target directory not found: $target"
      [ -d "$core/templates/ai_knowledge" ] || die "knowledge templates not found"

      if [ -e "$knowledge_dir" ] && [ "$force" != "yes" ]; then
        die ".ai_knowledge already exists; use --force to replace"
      fi

      if [ -e "$knowledge_dir" ]; then
        rm -rf "$knowledge_dir"
      fi

      mkdir -p "$knowledge_dir"
      date_value="$(date +%Y-%m-%d)"
      project_name="$(basename "$target")"

      for file in README.md index.md log.md project_brief.md; do
        render_template_file "$core/templates/ai_knowledge/$file" "$knowledge_dir/$file" "$date_value" "$project_name"
      done
      mkdir -p "$knowledge_dir/context_packs"
      render_template_file "$core/templates/ai_knowledge/context_packs/_template.md" "$knowledge_dir/context_packs/_template.md" "$date_value" "$project_name"

      if [ "$mode" = "full" ]; then
        for dir in concepts decisions architecture open_questions; do
          mkdir -p "$knowledge_dir/$dir"
          render_template_file "$core/templates/ai_knowledge/$dir/_template.md" "$knowledge_dir/$dir/_template.md" "$date_value" "$project_name"
        done
      fi

      info "created: $knowledge_dir"
      info "mode: $mode"
      ;;
    pack)
      [ -n "$pack_topic" ] || die "knowledge pack requires TOPIC"
      [ -d "$knowledge_dir" ] || die ".ai_knowledge missing; run aiops knowledge init first"

      safe_topic="$(printf '%s\n' "$pack_topic" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g; s/_\{2,\}/_/g; s/^_//; s/_$//')"
      [ -n "$safe_topic" ] || die "invalid pack topic: $pack_topic"
      pack_dir="$knowledge_dir/context_packs"
      pack_file="$pack_dir/$safe_topic.md"

      if [ "$pack_create" = "yes" ]; then
        mkdir -p "$pack_dir"
        date_value="$(date +%Y-%m-%d)"
        project_name="$(basename "$target")"
        [ -n "$pack_purpose" ] || pack_purpose="Task 또는 주제 '$pack_topic' 작업에 필요한 최소 지식 묶음"

        cat > "$pack_file" <<EOF
# Context Pack: $pack_topic

작성일: $date_value
프로젝트: $project_name

## 목적

$pack_purpose

## 언제 읽는가

- 관련 Task를 시작하기 전
- Role Session을 새로 열 때
- source of truth와 작업 범위를 빠르게 확인해야 할 때

## 관련 Task

- ${pack_task:-미지정}

## 먼저 확인할 원본

| 원본 | 확인할 내용 |
|---|---|
| $pack_source | 현재 작업 기준 |

## 필요한 Wiki 항목

- \`project_brief.md\`
- \`index.md\`

## 작업 전 확인할 미결정 사항

- 미작성

## 주의

이 context pack은 원본 문서를 대체하지 않는다. 구현, 검증, 완료 판단 전에는 반드시 source of truth를 확인한다.
EOF

        {
          printf '\n| %s | AI Ops CLI / Ops Governance Role | context_packs/%s.md | %s | context pack 생성 | |\n' "$date_value" "$safe_topic" "$pack_source"
        } >> "$knowledge_dir/log.md"

        info "AI Ops knowledge pack"
        info "created: .ai_knowledge/context_packs/$safe_topic.md"
        info "topic: $pack_topic"
        [ -z "$pack_task" ] || info "task: $pack_task"
        return 0
      fi

      [ -f "$pack_file" ] || die "context pack not found: $safe_topic; use --create"
      info "AI Ops knowledge pack"
      info "topic: $pack_topic"
      info "file: .ai_knowledge/context_packs/$safe_topic.md"
      info ""
      sed -n '1,220p' "$pack_file"
      ;;
    lint)
      failed=0
      info "AI Ops knowledge lint"
      info "target: $target"
      if [ -d "$knowledge_dir" ]; then
        info "ok: .ai_knowledge"
      else
        info "missing: .ai_knowledge"
        failed=1
      fi

      for file in README.md index.md log.md project_brief.md; do
        knowledge_required_file "$target" "$file" || failed=1
      done
      if [ -d "$knowledge_dir/context_packs" ]; then
        info "ok: .ai_knowledge/context_packs"
      else
        info "note: .ai_knowledge/context_packs missing"
      fi

      [ "$failed" -eq 0 ] || exit 1
      info "ok: knowledge workspace"
      ;;
    status)
      info "AI Ops knowledge status"
      info "target: $target"
      if [ -d "$knowledge_dir" ]; then
        info "ok: .ai_knowledge exists"
        for file in README.md index.md log.md project_brief.md; do
          if [ -f "$knowledge_dir/$file" ]; then
            info "  - $file"
          fi
        done
        if [ -d "$knowledge_dir/context_packs" ]; then
          info "context packs:"
          find "$knowledge_dir/context_packs" -maxdepth 1 -type f -name '*.md' | sort | while IFS= read -r pack; do
            info "  - context_packs/$(basename "$pack")"
          done
        fi
      else
        info "missing: .ai_knowledge"
        info "Next: aiops knowledge init --target \"$target\" --mode minimal"
      fi
      ;;
    *)
      die "unknown knowledge action: $action"
      ;;
  esac
}

cmd_ci() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "ci requires an action: init"
  shift

  case "$action" in
    init)
      target="$(pwd)"
      provider="github"
      force="no"

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --provider)
            shift
            [ "$#" -gt 0 ] || die "--provider requires a value"
            provider="$1"
            ;;
          --force)
            force="yes"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown ci init option: $1"
            ;;
        esac
        shift
      done

      [ "$provider" = "github" ] || die "unsupported ci provider: $provider"

      target="$(abs_path "$target")"
      [ -d "$target" ] || die "target directory not found: $target"

      if [ -d "$target/.ai" ] || [ -L "$target/.ai" ]; then
        core="$target/.ai"
      else
        core="$(default_core_dir)"
      fi

      template="$core/templates/ci/github-actions/aiops.yml"
      [ -f "$template" ] || die "CI template not found: $template"

      workflow_dir="$target/.github/workflows"
      workflow_file="$workflow_dir/aiops.yml"
      mkdir -p "$workflow_dir"

      if [ -e "$workflow_file" ] && [ "$force" != "yes" ]; then
        info "AI Ops CI init"
        info "target: $target"
        info "provider: github"
        info "skip: .github/workflows/aiops.yml already exists"
        info "Use --force to replace it."
        return 0
      fi

      cp "$template" "$workflow_file"

      info "AI Ops CI init"
      info "target: $target"
      info "provider: github"
      info "created: .github/workflows/aiops.yml"
      info ""
      info "CI checks:"
      info "  - aiops doctor --strict"
      info "  - aiops validate --strict when .ai_project exists"
      info "  - aiops migrate --plan when .ai_project exists"
      info "  - aiops knowledge lint when .ai_knowledge exists"
      ;;
    -h|--help)
      usage
      ;;
    *)
      die "unknown ci action: $action"
      ;;
  esac
}

cmd_export() {
  action="${1:-}"
  [ "$#" -gt 0 ] || die "export requires an action: runtime"
  shift

  case "$action" in
    runtime)
      target="$(pwd)"
      output=""

      while [ "$#" -gt 0 ]; do
        case "$1" in
          --target)
            shift
            [ "$#" -gt 0 ] || die "--target requires a value"
            target="$1"
            ;;
          --output)
            shift
            [ "$#" -gt 0 ] || die "--output requires a value"
            output="$1"
            ;;
          -h|--help)
            usage
            exit 0
            ;;
          *)
            die "unknown export runtime option: $1"
            ;;
        esac
        shift
      done

      target="$(abs_path "$target")"
      [ -d "$target/.ai_project" ] || die ".ai_project missing; bootstrap project first"
      [ -f "$target/.ai_project/operating_model.md" ] || die ".ai_project/operating_model.md missing"

      if [ -n "$output" ]; then
        output="$(abs_path "$output")"
        output_dir="$(dirname "$output")"
        [ -d "$output_dir" ] || die "output directory not found: $output_dir"
      fi

      if command -v ruby >/dev/null 2>&1; then
        ruby -ryaml -rjson -rtime -rdate -rfind -e '
          target = ARGV[0]
          output = ARGV[1].to_s

          def front_matter(path)
            return {} unless File.file?(path)
            text = File.read(path)
            return {} unless text.start_with?("---\n")
            lines = text.lines
            closing = nil
            lines[1..].each_with_index do |line, idx|
              if line.strip == "---"
                closing = idx + 1
                break
              end
            end
            return {} unless closing
            YAML.safe_load(lines[1...closing].join, permitted_classes: [Date, Time, Symbol], aliases: true) || {}
          rescue Psych::SyntaxError
            {}
          end

          def files_under(path, pattern)
            return [] unless Dir.exist?(path)
            files = []
            Find.find(path) do |entry|
              next unless File.file?(entry)
              files << entry if File.fnmatch(pattern, File.basename(entry))
            end
            files.sort
          end

          project_dir = File.join(target, ".ai_project")
          operating_model = front_matter(File.join(project_dir, "operating_model.md"))
          agent_registry = front_matter(File.join(project_dir, "agent_registry.md"))

          tasks = files_under(File.join(project_dir, "tasks"), "*.md").map do |path|
            data = front_matter(path)
            {
              "id" => data["id"] || File.basename(path, ".md"),
              "title" => data["title"],
              "status" => data["status"],
              "workflow" => data["workflow"],
              "target_role" => data["target_role"],
              "target_agent" => data["target_agent"],
              "required_capabilities" => data["required_capabilities"] || [],
              "allowed_paths" => data["allowed_paths"] || [],
              "source_of_truth" => data["source_of_truth"] || [],
              "depends_on" => data["depends_on"] || [],
              "blocks" => data["blocks"] || [],
              "locked_by" => data["locked_by"],
              "lock_session" => data["lock_session"],
              "report_to" => data["report_to"],
              "qa_to" => data["qa_to"],
              "status_ref" => data["status_ref"],
              "status_ref_sha" => data["status_ref_sha"],
              "worktree_path" => data["worktree_path"],
              "worktree_role" => data["worktree_role"],
              "base_ref" => data["base_ref"],
              "base_sha" => data["base_sha"],
              "branch" => data["branch"] || {},
              "pr" => data["pr"] || {},
              "path" => path.sub(%r{\A#{Regexp.escape(target)}/?}, "")
            }
          end

          handoffs = files_under(File.join(project_dir, "handoffs"), "*.md").map do |path|
            data = front_matter(path)
            {
              "task_id" => data["task_id"],
              "from_role" => data["from_role"],
              "to_role" => data["to_role"],
              "from_agent" => data["from_agent"],
              "to_agent" => data["to_agent"],
              "current_status" => data["current_status"],
              "next_action" => data["next_action"],
              "status_ref" => data["status_ref"],
              "status_ref_sha" => data["status_ref_sha"],
              "worktree_path" => data["worktree_path"],
              "worktree_role" => data["worktree_role"],
              "source_of_truth" => data["source_of_truth"] || [],
              "allowed_paths" => data["allowed_paths"] || [],
              "report_paths" => data["report_paths"] || [],
              "risks" => data["risks"] || [],
              "blockers" => data["blockers"] || [],
              "open_questions" => data["open_questions"] || [],
              "created_at" => data["created_at"],
              "path" => path.sub(%r{\A#{Regexp.escape(target)}/?}, "")
            }
          end

          approval_statuses = %w[proposed scoped approved verification_ready verification_in_progress verification_passed completion_review done blocked rework_requested cancelled]
          checkpoints = tasks.map do |task|
            status = task["status"]
            next unless approval_statuses.include?(status.to_s)
            {
              "task_id" => task["id"],
              "status" => status,
              "type" => case status
                        when "approved" then "work_approved"
                        when "verification_ready", "verification_in_progress" then "verification_checkpoint"
                        when "completion_review" then "completion_approval"
                        when "done" then "completion_recorded"
                        when "blocked", "rework_requested", "cancelled" then "lead_decision_required"
                        else "scope_or_direction_decision"
                        end,
              "owner_role" => task["target_role"]
            }
          end.compact

          export = {
            "schema" => "aiops.runtime_export.v1",
            "exported_at" => Time.now.utc.iso8601,
            "target" => target,
            "project" => operating_model["project"] || File.basename(target),
            "core_version" => operating_model["core_version"],
            "operating_model" => operating_model,
            "agents" => agent_registry["agents"] || [],
            "tasks" => tasks,
            "handoffs" => handoffs,
            "approval_checkpoints" => checkpoints,
            "adapter_contract" => {
              "task_graph" => "tasks[].depends_on / tasks[].blocks",
              "role_assignment" => "tasks[].target_role and agents[].roles",
              "state_transitions" => "tasks[].status plus runtime/workflows.json",
              "handoff_events" => "handoffs[]",
              "approval_checkpoints" => "approval_checkpoints[]"
            }
          }

          json = JSON.pretty_generate(export) + "\n"
          if output.empty?
            puts json
          else
            File.write(output, json)
          end
        ' "$target" "$output"
        if [ -n "$output" ]; then
          info "AI Ops runtime export"
          info "target: $target"
          info "created: $output"
        fi
      else
        die "ruby is required for runtime export"
      fi
      ;;
    -h|--help)
      usage
      ;;
    *)
      die "unknown export action: $action"
      ;;
  esac
}

cmd_version() {
  core="$(default_core_dir)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --core)
        shift
        [ "$#" -gt 0 ] || die "--core requires a value"
        core="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown version option: $1"
        ;;
    esac
    shift
  done

  core="$(abs_path "$core")"
  require_core "$core"
  if [ -f "$core/VERSION" ]; then
    cat "$core/VERSION"
  else
    die "VERSION not found"
  fi
}

cmd_update() {
  core="$(default_core_dir)"
  check_only="no"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --core)
        shift
        [ "$#" -gt 0 ] || die "--core requires a value"
        core="$1"
        ;;
      --check)
        check_only="yes"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown update option: $1"
        ;;
    esac
    shift
  done

  core="$(abs_path "$core")"
  require_core "$core"

  current_version="unknown"
  if [ -f "$core/VERSION" ]; then
    current_version="$(cat "$core/VERSION")"
  fi

  info "AI Ops update"
  info "core: $core"
  info "current version: $current_version"

  if [ -d "$core/.git" ]; then
    branch="$(git -C "$core" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'unknown')"
    info "install method: git checkout"
    info "branch: $branch"

    if [ "$check_only" = "yes" ]; then
      info ""
      info "No files changed."
      info "To update this git-based core:"
      info "  aiops update --core \"$core\""
      return 0
    fi

    if ! git -C "$core" diff --quiet || ! git -C "$core" diff --cached --quiet; then
      die "core has local changes; commit, stash, or resolve them before update"
    fi

    git -C "$core" pull --ff-only

    new_version="$current_version"
    if [ -f "$core/VERSION" ]; then
      new_version="$(cat "$core/VERSION")"
    fi

    info ""
    info "AI Ops update complete."
    info "previous version: $current_version"
    info "current version: $new_version"
    info "Next: run doctor in target projects:"
    info "  aiops doctor --strict"
    return 0
  fi

  info "install method: packaged or copied core"
  info ""
  if [ "$check_only" = "yes" ]; then
    info "No files changed."
  fi
  info "This core is not a git checkout, so aiops will not modify it directly."
  info "If installed with Homebrew in the future, update with:"
  info "  brew upgrade ai-agent-ops"
  info "If copied into a project, reseed from an updated core after reviewing migration impact."
}

cmd_release_check() {
  core="$(default_core_dir)"
  strict="no"
  allow_pending_release="no"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --core)
        shift
        [ "$#" -gt 0 ] || die "--core requires a value"
        core="$1"
        ;;
      --strict)
        strict="yes"
        ;;
      --allow-pending-release)
        allow_pending_release="yes"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown release-check option: $1"
        ;;
    esac
    shift
  done

  core="$(abs_path "$core")"
  require_core "$core"

  failed=0
  warnings=0
  version="unknown"
  if [ -f "$core/VERSION" ]; then
    version="$(cat "$core/VERSION")"
  fi

  info "AI Ops release check"
  info "core: $core"
  info "version: $version"
  info "strict: $strict"

  case "$version" in
    *[!0-9.]*|*.*.*.*|.*|*.)
      info "warn: VERSION should be semantic numeric form like 0.6.1"
      warnings=$((warnings + 1))
      ;;
    *.*.*)
      info "ok: VERSION format"
      ;;
    *)
      info "warn: VERSION should be semantic numeric form like 0.6.1"
      warnings=$((warnings + 1))
      ;;
  esac

  for required in \
    "$core/README.md" \
    "$core/QUICKSTART.md" \
    "$core/CHANGELOG.md" \
    "$core/.github/workflows/ci.yml" \
    "$core/docs/installation.md" \
    "$core/docs/distribution.md" \
    "$core/docs/agent_intent.md" \
    "$core/docs/project_state.md" \
    "$core/docs/shared_status.md" \
    "$core/scripts/test.sh" \
    "$core/bin/aiops" \
    "$core/schemas/README.md" \
    "$core/schemas/task.schema.json" \
    "$core/schemas/workflow.schema.json" \
    "$core/schemas/workflow_catalog.schema.json" \
    "$core/schemas/handoff.schema.json" \
    "$core/schemas/agent_registry.schema.json" \
    "$core/schemas/operating_model.schema.json" \
    "$core/schemas/bootstrap_options.schema.json" \
    "$core/schemas/runtime_export.schema.json" \
    "$core/schemas/project_snapshot.schema.json" \
    "$core/schemas/project_dashboard.schema.json" \
    "$core/schemas/policy_rules.schema.json" \
    "$core/schemas/policy_evaluation.schema.json" \
    "$core/schemas/action_plan.schema.json" \
    "$core/adapters/README.md" \
    "$core/adapters/langgraph/README.md" \
    "$core/adapters/openai_agents/README.md" \
    "$core/bootstrap/bootstrap_reference.md" \
    "$core/bootstrap/migration_runbook.md" \
    "$core/Formula/ai-agent-ops.rb" \
    "$core/core/constitution.md" \
    "$core/models/knowledge_model.md" \
    "$core/policies/knowledge_policy.md" \
    "$core/policies/migration_policy.md" \
    "$core/policies/shared_status_policy.md" \
    "$core/policies/session_orchestration_policy.md" \
    "$core/policies/versioning_policy.md" \
    "$core/runtime/workflow.md" \
    "$core/runtime/workflows.json" \
    "$core/runtime/policy_rules.json" \
    "$core/runtime/task_queue.md" \
    "$core/runtime/bootstrap_options.json" \
    "$core/templates/ci/github-actions/aiops.yml" \
    "$core/templates/tool_adapters/codex/AGENTS.md" \
    "$core/templates/tool_adapters/claude/CLAUDE.md"
  do
    check_required_file "$required" "${required#$core/}" || failed=1
  done

  shell_syntax_failed=0
  for shell_file in "$core/bin/aiops" "$core/scripts/test.sh" "$core"/tests/e2e_*.sh; do
    [ -f "$shell_file" ] || continue
    if sh -n "$shell_file"; then
      :
    else
      shell_syntax_failed=1
    fi
  done
  if [ "$shell_syntax_failed" -eq 0 ]; then
    info "ok: shell syntax"
  else
    info "warn: shell syntax failed"
    warnings=$((warnings + 1))
  fi

  if command -v ruby >/dev/null 2>&1; then
    if ruby -rjson -e 'ARGV.each { |path| JSON.parse(File.read(path)) }' "$core"/schemas/*.schema.json >/dev/null 2>&1; then
      info "ok: schema JSON syntax"
    else
      info "warn: schema JSON syntax failed"
      warnings=$((warnings + 1))
    fi
  else
    info "note: ruby not available; schema JSON syntax not checked"
  fi

  if "$core/bin/aiops" validate workflow-catalog --core "$core" >/dev/null 2>&1; then
    info "ok: workflow catalog validation"
  else
    info "warn: workflow catalog validation failed"
    warnings=$((warnings + 1))
  fi

  if "$core/bin/aiops" validate policy-rules --core "$core" >/dev/null 2>&1; then
    info "ok: policy rules validation"
  else
    info "warn: policy rules validation failed"
    warnings=$((warnings + 1))
  fi

  release_tmp="${TMPDIR:-/tmp}/aiops-release-check-project.$$"
  rm -rf "$release_tmp"
  if (
    set -eu
    mkdir -p "$release_tmp"
    "$core/bin/aiops" seed --target "$release_tmp" --adapter both --mode link --core "$core" >/dev/null
    cp -R "$core/templates/ai_project/fast_track" "$release_tmp/.ai_project"
    mkdir -p \
      "$release_tmp/.ai_project/tasks/active" \
      "$release_tmp/.ai_project/tasks/backlog" \
      "$release_tmp/.ai_project/tasks/archive" \
      "$release_tmp/.ai_project/handoffs"
    "$core/bin/aiops" knowledge init --target "$release_tmp" --mode minimal >/dev/null
    "$core/bin/aiops" doctor --target "$release_tmp" --strict >/dev/null
    "$core/bin/aiops" validate --target "$release_tmp" --strict >/dev/null
    "$core/bin/aiops" migrate --target "$release_tmp" --plan >/dev/null
    "$core/bin/aiops" knowledge lint --target "$release_tmp" >/dev/null
    "$core/bin/aiops" export runtime --target "$release_tmp" >/dev/null
    "$core/bin/aiops" project snapshot --target "$release_tmp" --json > "$release_tmp/project_snapshot.json"
    "$core/bin/aiops" validate project-snapshot "$release_tmp/project_snapshot.json" >/dev/null
    "$core/bin/aiops" project dashboard --target "$release_tmp" --json > "$release_tmp/project_dashboard.json"
    "$core/bin/aiops" validate project-dashboard "$release_tmp/project_dashboard.json" >/dev/null
    "$core/bin/aiops" policy evaluate --target "$release_tmp" --json > "$release_tmp/policy_evaluation.json"
    "$core/bin/aiops" validate policy-evaluation "$release_tmp/policy_evaluation.json" >/dev/null
    printf '{}\n' > "$release_tmp/invalid_project_snapshot.json"
    if "$core/bin/aiops" policy evaluate --snapshot "$release_tmp/invalid_project_snapshot.json" --json >/dev/null 2>&1; then
      exit 1
    fi
  ); then
    info "ok: seeded project release gate"
  else
    info "warn: seeded project release gate failed"
    warnings=$((warnings + 1))
  fi
  rm -rf "$release_tmp"

  if [ -f "$core/CHANGELOG.md" ]; then
    if grep -q "^## $version " "$core/CHANGELOG.md"; then
      info "ok: CHANGELOG has version section"
    else
      info "warn: CHANGELOG missing section for $version"
      warnings=$((warnings + 1))
    fi
    if awk '
      /^## Unreleased/ { in_unreleased = 1; next }
      /^## / && in_unreleased { exit }
      in_unreleased && /^- / { found = 1 }
      END { exit(found ? 0 : 1) }
    ' "$core/CHANGELOG.md"; then
      if [ "$allow_pending_release" = "yes" ]; then
        info "note: CHANGELOG has pending Unreleased entries"
      else
        info "warn: CHANGELOG has pending Unreleased entries; finalize release notes or use --allow-pending-release"
        warnings=$((warnings + 1))
      fi
    else
      info "ok: CHANGELOG Unreleased is empty"
    fi
  fi

  formula="$core/Formula/ai-agent-ops.rb"
  if [ -f "$formula" ]; then
    if grep -q "refs/tags/v$version.tar.gz" "$formula" || grep -q "tag:[[:space:]]*\"v$version\"" "$formula"; then
      info "ok: Formula version reference matches VERSION"
    else
      info "warn: Formula version reference does not match VERSION v$version"
      warnings=$((warnings + 1))
    fi

    if grep -q 'libexec.install.*"adapters"' "$formula"; then
      info "ok: Formula installs adapters"
    else
      info "warn: Formula missing adapters install"
      warnings=$((warnings + 1))
    fi

    for formula_dir in bootstrap core docs models policies runtime schemas templates workflows; do
      if grep -q "libexec.install.*\"$formula_dir\"" "$formula"; then
        info "ok: Formula installs $formula_dir"
      else
        info "warn: Formula missing $formula_dir install"
        warnings=$((warnings + 1))
      fi
    done

    if grep -q 'REPLACE_WITH_RELEASE_SHA256' "$formula"; then
      if [ "$allow_pending_release" = "yes" ]; then
        info "note: Formula sha256 placeholder pending release"
      else
        info "warn: Formula sha256 placeholder must be replaced before Homebrew release"
        warnings=$((warnings + 1))
      fi
    elif grep -q "refs/tags/v$version.tar.gz" "$formula"; then
      if grep -Eq 'sha256 "[0-9a-f]{64}"' "$formula"; then
        info "ok: Formula sha256 format"
      else
        info "warn: Formula sha256 is missing or invalid"
        warnings=$((warnings + 1))
      fi
    elif grep -q "tag:[[:space:]]*\"v$version\"" "$formula"; then
      if grep -Eq 'revision:[[:space:]]*"[0-9a-f]{40}"' "$formula"; then
        info "ok: Formula git revision format"
      else
        info "warn: Formula git revision is missing or invalid"
        warnings=$((warnings + 1))
      fi
    else
      info "warn: Formula source format is not recognized"
      warnings=$((warnings + 1))
    fi

    if command -v ruby >/dev/null 2>&1; then
      if ruby -c "$formula" >/dev/null 2>&1; then
        info "ok: Formula Ruby syntax"
      else
        info "warn: Formula Ruby syntax failed"
        warnings=$((warnings + 1))
      fi
    else
      info "note: ruby not available; Formula syntax not checked"
    fi
  fi

  if [ -f "$core/LICENSE" ] || [ -f "$core/LICENSE.md" ]; then
    info "ok: LICENSE"
  else
    info "warn: LICENSE missing; choose a license before public Homebrew release"
    warnings=$((warnings + 1))
  fi

  if [ -d "$core/.git" ]; then
    if git -C "$core" diff --quiet && git -C "$core" diff --cached --quiet; then
      info "ok: git working tree clean"
    else
      info "warn: git working tree has uncommitted changes"
      warnings=$((warnings + 1))
    fi
  fi

  if [ "$strict" = "yes" ] && [ "$warnings" -gt 0 ]; then
    failed=1
  fi

  info "warnings: $warnings"
  [ "$failed" -eq 0 ] || exit 1
}

cmd_bootstrap_guide() {
  target="$(pwd)"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        target="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown bootstrap-guide option: $1"
        ;;
    esac
    shift
  done

  target="$(abs_path "$target")"
  ai="$target/.ai"

  info "AI Ops bootstrap guide"
  info "target: $target"
  info ""

  if [ -L "$ai" ] || [ -d "$ai" ]; then
    info "ok: .ai exists"
  else
    info "missing: .ai"
    info ""
    info "먼저 seed를 실행하세요:"
    info "  aiops seed --target \"$target\" --adapter codex"
    info ""
    info "Codex와 Claude를 함께 쓸 경우:"
    info "  aiops seed --target \"$target\" --adapter both"
    return 0
  fi

  if [ -f "$target/AGENTS.md" ]; then
    info "ok: AGENTS.md"
  else
    info "note: AGENTS.md missing"
  fi

  if [ -f "$target/CLAUDE.md" ]; then
    info "ok: CLAUDE.md"
  else
    info "note: CLAUDE.md missing"
  fi

  if [ -d "$target/.ai_project" ]; then
    info "ok: .ai_project exists"
    info ""
    info "현재 프로젝트는 AI Ops 운영 구성이 이미 완료된 상태입니다."
    info "bootstrap을 다시 시작하지 말고, 목적에 맞는 Role Session을 여는 흐름으로 진행하세요."
    info ""
    info "활성 Agent / Role 후보:"
    if [ -f "$target/.ai_project/agent_registry.md" ]; then
      agent_rows="$(print_agent_registry_rows "$target/.ai_project/agent_registry.md" || true)"
      if [ -n "$agent_rows" ]; then
        printf '%s\n' "$agent_rows" | while IFS= read -r line; do
          info "$line"
        done
      else
        info "      - agent_registry.md에서 표시할 Agent/Role을 찾지 못함"
      fi
    else
      info "      - agent_registry.md 없음"
    fi
    info ""
    info "현재 초점:"
    if [ -f "$target/.ai_project/current_context.md" ]; then
      focus_rows="$(print_current_focus_rows "$target/.ai_project/current_context.md" || true)"
      if [ -n "$focus_rows" ]; then
        printf '%s\n' "$focus_rows" | while IFS= read -r line; do
          info "$line"
        done
      else
        info "      - current_context.md에 현재 초점이 비어 있음"
      fi
    elif [ -f "$target/.ai_project/task_board.md" ]; then
      focus_rows="$(print_current_focus_rows "$target/.ai_project/task_board.md" || true)"
      if [ -n "$focus_rows" ]; then
        printf '%s\n' "$focus_rows" | while IFS= read -r line; do
          info "$line"
        done
      else
        info "      - task_board.md에 현재 초점이 비어 있음"
      fi
    else
      info "      - current_context.md 없음"
    fi
    info ""
    info "다음 단계:"
    info "  - 운영 상태를 점검하려면:"
    info "      aiops doctor --target \"$target\" --strict"
    info "  - 어떤 Role 세션을 열지 보려면:"
    info "      aiops session-guide --target \"$target\""
    info "  - 제품 방향/요구사항을 정리하려면:"
    info "      aiops role prompt direction --target \"$target\""
    info "  - 다음 Task를 등록/조율하려면:"
    info "      aiops role prompt lead --target \"$target\""
    info "  - 승인된 Task를 실행하려면:"
    info "      aiops role prompt execution --target \"$target\" --task TASK_ID"
    info "  - 운영모델 자체를 점검하려면:"
    info "      aiops role prompt ops --target \"$target\""
    info "  - 운영 구성을 다시 검토해야 할 때만:"
    info "      AI Ops bootstrap 재검토해줘."
  else
    info "note: .ai_project missing"
    info ""
    info "새 운영 구성을 시작하려면 Agent 세션에서 말하세요:"
    info "  AI Ops bootstrap 시작해줘."
    info ""
    info "이때 Agent의 역할:"
    info "  - AI Ops Agent / Ops Governance Role로 동작합니다."
    info "  - 제품 기획을 깊게 진행하지 않고 운영 구성만 결정합니다."
    info "  - 제품 아이디어 탐색은 Apply 후 PM/Direction Role 세션으로 넘깁니다."
    info ""
    info "Bootstrap 진행 방식:"
    info "  1. 빠른 시작"
    info "     - 처음 쓰는 사용자나 작은 프로젝트에 적합합니다."
    info "     - 쉬운 질문 몇 개와 안전 기본값으로 시작합니다."
    info "  2. 세부 설정"
    info "     - Team, Role, Workflow, Ownership, Board, Branch/PR을 직접 비교하며 정합니다."
    info ""
    info "원칙:"
    info "  - Discovery Phase에서는 파일을 수정하지 않습니다."
    info "  - .ai_project 생성/수정은 Operating Model Draft 승인 후에만 진행합니다."
  fi
}

main() {
  cmd="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    seed) cmd_seed "$@" ;;
    doctor) cmd_doctor "$@" ;;
    migrate) cmd_migrate "$@" ;;
    project) cmd_project "$@" ;;
    bootstrap-guide) cmd_bootstrap_guide "$@" ;;
    session-guide) cmd_session_guide "$@" ;;
    role) cmd_role "$@" ;;
    policy) cmd_policy "$@" ;;
    action) cmd_action "$@" ;;
    validate) cmd_validate "$@" ;;
    task) cmd_task "$@" ;;
    handoff) cmd_handoff "$@" ;;
    status-ref) cmd_status_ref "$@" ;;
    sync-status) cmd_sync_status "$@" ;;
    worktree) cmd_worktree "$@" ;;
    knowledge) cmd_knowledge "$@" ;;
    ci) cmd_ci "$@" ;;
    export) cmd_export "$@" ;;
    version) cmd_version "$@" ;;
    update) cmd_update "$@" ;;
    release-check) cmd_release_check "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
