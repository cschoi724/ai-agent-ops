{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-ops.local/schemas/workflow_catalog.schema.json",
  "title": "AI Ops Workflow Catalog",
  "description": "Schema for machine-readable workflow catalog and checkpoint policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "default_workflow",
    "workflows"
  ],
  "properties": {
    "schema": {
      "const": "aiops.workflow_catalog.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "default_workflow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_/-]*$"
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_/-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inherits": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_/-]*$"
        },
        "default_profile": {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "strict"
          ]
        },
        "statuses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/status"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "inherits"
          ]
        },
        {
          "required": [
            "statuses",
            "transitions"
          ]
        }
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "canonical_publish",
        "meaning"
      ],
      "properties": {
        "checkpoint": {
          "type": "boolean"
        },
        "canonical_publish": {
          "type": "string",
          "enum": [
            "not_required",
            "optional",
            "recommended",
            "required"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roleName": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "Direction Role",
        "Lead Role",
        "Execution Role",
        "Verification Role",
        "Completion Role",
        "Release Role",
        "Ops Governance Role",
        "Product Owner",
        "any"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "allowed_roles"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/taskStatus"
        },
        "to": {
          "$ref": "#/$defs/taskStatus"
        },
        "allowed_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleName"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "next_role": {
          "$ref": "#/$defs/roleName"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["light", "standard", "strict"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "taskStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "scoped",
        "approved",
        "in_progress",
        "verification_ready",
        "verification_in_progress",
        "verification_passed",
        "completion_review",
        "done",
        "blocked",
        "rework_requested",
        "cancelled"
      ]
    }
  }
}
