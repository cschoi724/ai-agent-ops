{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-ops.local/schemas/project_dashboard.schema.json",
  "title": "AI Ops Project Dashboard",
  "description": "Machine-readable dashboard projection for terminal, tree, Mermaid, HTML, and later UI renderers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "target",
    "view",
    "level",
    "format",
    "map",
    "focus",
    "depth",
    "group_by",
    "project",
    "status",
    "progress",
    "readiness",
    "git",
    "agents",
    "tasks",
    "risks",
    "control",
    "next",
    "maps",
    "views"
  ],
  "properties": {
    "schema": { "const": "aiops.project_dashboard.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "view": { "type": "string", "enum": ["main", "work", "risk", "agents", "release"] },
    "level": { "type": "string", "enum": ["compact", "standard", "detail"] },
    "format": { "type": "string", "enum": ["terminal", "tree", "mermaid", "html"] },
    "map": { "type": "string", "enum": ["summary", "dependencies", "swimlane", "critical-path", "workflow", "agents", "blockers"] },
    "focus": { "type": ["string", "null"] },
    "depth": { "type": "integer", "minimum": 0 },
    "group_by": { "type": "string", "enum": ["area", "agent", "role", "status", "workflow"] },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "core_version", "operating_mode", "workflow_policy", "knowledge_mode"],
      "properties": {
        "name": { "type": "string" },
        "core_version": { "type": "string" },
        "recorded_core_version": { "type": ["string", "null"] },
        "operating_mode": { "type": ["string", "null"] },
        "workflow_policy": { "type": ["string", "null"] },
        "knowledge_mode": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "blockers", "warnings"],
      "properties": {
        "overall": { "type": "string", "enum": ["ok", "warning", "blocked"] },
        "blockers": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_tasks", "done_tasks", "active_tasks", "done_ratio"],
      "properties": {
        "total_tasks": { "type": "integer", "minimum": 0 },
        "done_tasks": { "type": "integer", "minimum": 0 },
        "active_tasks": { "type": "integer", "minimum": 0 },
        "done_ratio": { "type": "number", "minimum": 0 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["bootstrap", "task_work", "multi_agent", "migration"],
      "properties": {
        "bootstrap": { "type": ["string", "null"] },
        "task_work": { "type": ["string", "null"] },
        "multi_agent": { "type": ["string", "null"] },
        "migration": { "type": ["string", "null"] }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": true,
      "required": ["branch", "head", "canonical_status_ref", "canonical_status_sha", "recorded_status_sha", "status_ref_state"],
      "properties": {
        "branch": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"] },
        "canonical_status_ref": { "type": ["string", "null"] },
        "canonical_status_sha": { "type": ["string", "null"] },
        "recorded_status_sha": { "type": ["string", "null"] },
        "status_ref_state": { "type": ["string", "null"] }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "deferred", "total", "active_roles", "items"],
      "properties": {
        "enabled": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "active_roles": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array", "items": { "type": "object" } }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total", "active", "by_status", "items", "active_items"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "by_status": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/taskItem" } },
        "active_items": { "type": "array", "items": { "$ref": "#/$defs/taskItem" } }
      }
    },
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockers", "warnings"],
      "properties": {
        "blockers": { "type": "array", "items": { "type": "object" } },
        "warnings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "control": { "type": "object" },
    "next": { "type": "array", "items": { "type": "object" } },
    "maps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "dependencies", "swimlane", "critical_path", "workflow", "agents", "blockers"],
      "properties": {
        "summary": { "$ref": "#/$defs/map" },
        "dependencies": { "$ref": "#/$defs/map" },
        "swimlane": { "$ref": "#/$defs/map" },
        "critical_path": { "$ref": "#/$defs/map" },
        "workflow": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type", "direction", "statuses", "transitions", "task_positions"],
          "properties": {
            "type": { "const": "workflow" },
            "direction": { "type": "string" },
            "statuses": { "type": "array", "items": { "type": "object" } },
            "transitions": { "type": "array", "items": { "type": "object" } },
            "task_positions": { "type": "array", "items": { "type": "object" } }
          }
        },
        "agents": { "$ref": "#/$defs/map" },
        "blockers": { "$ref": "#/$defs/map" }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "agents", "release"],
      "properties": {
        "risk": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "overall",
            "blockers",
            "warnings",
            "policy_rules",
            "agent_drift",
            "blocked_actions",
            "approval_required_actions",
            "unresolved_decisions",
            "task_metadata_missing",
            "task_status_ref_missing",
            "status_ref_state"
          ],
          "properties": {
            "overall": { "type": ["string", "null"] },
            "blockers": { "type": "array", "items": { "type": "object" } },
            "warnings": { "type": "array", "items": { "type": "object" } },
            "policy_rules": { "type": "array", "items": { "type": "object" } },
            "agent_drift": { "type": "array", "items": { "type": "object" } },
            "blocked_actions": { "type": "array", "items": { "type": "object" } },
            "approval_required_actions": { "type": "array", "items": { "type": "string" } },
            "unresolved_decisions": { "type": "integer", "minimum": 0 },
            "task_metadata_missing": { "type": "integer", "minimum": 0 },
            "task_status_ref_missing": { "type": "integer", "minimum": 0 },
            "status_ref_state": { "type": ["string", "null"] }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "deferred", "total", "active_roles", "role_task_counts", "items", "unassigned_active_tasks"],
          "properties": {
            "enabled": { "type": "integer", "minimum": 0 },
            "deferred": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "active_roles": { "type": "array", "items": { "type": "string" } },
            "role_task_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "items": { "type": "array", "items": { "type": "object" } },
            "unassigned_active_tasks": { "type": "array", "items": { "$ref": "#/$defs/taskItem" } }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "gate_status",
            "readiness",
            "canonical_status",
            "blockers",
            "warnings",
            "policy_rules",
            "blocked_actions",
            "required_approvals",
            "pending_checks",
            "release_check_command"
          ],
          "properties": {
            "gate_status": { "type": "string" },
            "readiness": { "type": "object" },
            "canonical_status": { "type": "object" },
            "blockers": { "type": "array", "items": { "type": "object" } },
            "warnings": { "type": "array", "items": { "type": "object" } },
            "policy_rules": { "type": "array", "items": { "type": "object" } },
            "blocked_actions": { "type": "array", "items": { "type": "object" } },
            "required_approvals": { "type": "array", "items": { "type": "string" } },
            "pending_checks": { "type": "array", "items": { "type": "object" } },
            "release_check_command": { "type": "string" },
            "github": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason_code", "reason", "repository", "branch", "pull_request", "required_checks", "latest_run", "release"],
              "properties": {
                "status": { "type": "string", "enum": ["available", "partial", "unavailable"] },
                "reason_code": { "type": ["string", "null"] },
                "reason": { "type": ["string", "null"] },
                "repository": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name_with_owner", "url"],
                      "properties": {
                        "name_with_owner": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
                        "url": { "type": ["string", "null"] }
                      }
                    }
                  ]
                },
                "branch": { "type": ["string", "null"] },
                "pull_request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["available", "not_applicable", "not_found", "unavailable"] },
                    "reason": { "type": ["string", "null"] },
                    "number": { "type": ["integer", "null"] },
                    "title": { "type": ["string", "null"] },
                    "url": { "type": ["string", "null"] },
                    "head_branch": { "type": ["string", "null"] },
                    "base_branch": { "type": ["string", "null"] },
                    "draft": { "type": ["boolean", "null"] },
                    "mergeable": { "type": ["string", "null"] }
                  }
                },
                "required_checks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "total", "passing", "failing", "pending", "skipping", "items"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success", "failure", "pending", "not_applicable", "not_found", "unavailable"] },
                    "total": { "type": "integer", "minimum": 0 },
                    "passing": { "type": "integer", "minimum": 0 },
                    "failing": { "type": "integer", "minimum": 0 },
                    "pending": { "type": "integer", "minimum": 0 },
                    "skipping": { "type": "integer", "minimum": 0 },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "state", "bucket", "url", "workflow"],
                        "properties": {
                          "name": { "type": ["string", "null"] },
                          "state": { "type": ["string", "null"] },
                          "bucket": { "type": ["string", "null"] },
                          "url": { "type": ["string", "null"] },
                          "workflow": { "type": ["string", "null"] }
                        }
                      }
                    },
                    "reason": { "type": ["string", "null"] }
                  }
                },
                "latest_run": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string" },
                    "reason": { "type": ["string", "null"] },
                    "conclusion": { "type": ["string", "null"] },
                    "database_id": { "type": ["integer", "null"] },
                    "workflow": { "type": ["string", "null"] },
                    "title": { "type": ["string", "null"] },
                    "url": { "type": ["string", "null"] },
                    "head_sha": { "type": ["string", "null"] },
                    "created_at": { "type": ["string", "null"] },
                    "updated_at": { "type": ["string", "null"] },
                    "event": { "type": ["string", "null"] }
                  }
                },
                "release": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "tag", "local_version", "version_state"],
                  "properties": {
                    "status": { "type": "string", "enum": ["available", "not_found", "unavailable"] },
                    "tag": { "type": ["string", "null"] },
                    "name": { "type": ["string", "null"] },
                    "url": { "type": ["string", "null"] },
                    "published_at": { "type": ["string", "null"] },
                    "draft": { "type": ["boolean", "null"] },
                    "prerelease": { "type": ["boolean", "null"] },
                    "target_commitish": { "type": ["string", "null"] },
                    "local_version": { "type": ["string", "null"] },
                    "version_state": { "type": "string", "enum": ["match", "different", "local_version_missing", "release_missing"] },
                    "reason": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "taskItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "status_class",
        "workflow",
        "target_role",
        "target_agent_id",
        "target_agent",
        "lock_state",
        "depends_on",
        "blocks",
        "allowed_paths",
        "source_of_truth",
        "next",
        "path"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "status_class": { "type": "string" },
        "workflow": { "type": ["string", "null"] },
        "risk_profile": { "type": "string", "enum": ["light", "standard", "strict", "invalid"] },
        "recommended_risk_profile": { "type": "string", "enum": ["light", "standard", "strict"] },
        "risk_profile_ready": { "type": "boolean" },
        "target_role": { "type": ["string", "null"] },
        "target_agent_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "target_agent": { "type": ["string", "null"] },
        "locked_by": { "type": ["string", "null"] },
        "lock_state": { "type": "string", "enum": ["none", "locked"] },
        "branch": { "type": ["string", "object", "null"] },
        "worktree": { "type": ["string", "null"] },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "source_of_truth": { "type": "array", "items": { "type": "string" } },
        "report_to": { "type": ["string", "null"] },
        "qa_to": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "command"],
          "properties": {
            "action": { "type": "string" },
            "command": { "type": "string" }
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "direction", "nodes", "edges"],
      "properties": {
        "type": { "type": "string" },
        "direction": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
