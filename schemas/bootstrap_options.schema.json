{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-ops.local/schemas/bootstrap_options.schema.json",
  "title": "AI Ops Bootstrap Options",
  "description": "Schema for machine-readable bootstrap option catalogs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "categories"
  ],
  "properties": {
    "schema": {
      "const": "aiops.bootstrap_options.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_mode",
        "start_context",
        "readiness_level",
        "operating_mode",
        "team_pattern",
        "workflow_policy",
        "ownership_model",
        "coordination",
        "board_model",
        "branch_pr",
        "knowledge_mode"
      ],
      "properties": {
        "bootstrap_mode": {
          "$ref": "#/$defs/category"
        },
        "start_context": {
          "$ref": "#/$defs/category"
        },
        "readiness_level": {
          "$ref": "#/$defs/category"
        },
        "operating_mode": {
          "$ref": "#/$defs/category"
        },
        "team_pattern": {
          "$ref": "#/$defs/category"
        },
        "workflow_policy": {
          "$ref": "#/$defs/category"
        },
        "ownership_model": {
          "$ref": "#/$defs/category"
        },
        "coordination": {
          "$ref": "#/$defs/category"
        },
        "board_model": {
          "$ref": "#/$defs/category"
        },
        "branch_pr": {
          "$ref": "#/$defs/category"
        },
        "knowledge_mode": {
          "$ref": "#/$defs/category"
        }
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "question",
        "options"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "option_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_/-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended_when": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "activates_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleName"
          },
          "uniqueItems": true
        },
        "deferred_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleName"
          },
          "uniqueItems": true
        },
        "related_documents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "roleName": {
      "type": "string",
      "enum": [
        "Direction Role",
        "Lead Role",
        "Execution Role",
        "Verification Role",
        "Completion Role",
        "Release Role",
        "Ops Governance Role"
      ]
    }
  }
}
