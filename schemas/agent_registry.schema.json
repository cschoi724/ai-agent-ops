{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-ops.local/schemas/agent_registry.schema.json",
  "title": "AI Ops Agent Registry",
  "description": "Schema for project agent and role mapping metadata.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "project",
    "agents"
  ],
  "properties": {
    "schema": {
      "const": "aiops.agent_registry.v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "roleName": {
      "type": "string",
      "enum": [
        "Direction Role",
        "Lead Role",
        "Execution Role",
        "Verification Role",
        "Completion Role",
        "Release Role",
        "Ops Governance Role"
      ]
    },
    "agentStatus": {
      "type": "string",
      "enum": [
        "enabled",
        "deferred",
        "inactive",
        "planned"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agent",
        "status",
        "roles"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/agentStatus"
        },
        "team": {
          "type": [
            "string",
            "null"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleName"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "role_doc": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
