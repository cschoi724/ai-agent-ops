{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-ops.local/schemas/policy_rules.schema.json",
  "title": "AI Ops Policy Rules",
  "description": "Schema for machine-readable policy rule catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "strict_levels",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "aiops.policy_rules.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "strict_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/strictLevel"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_/-]*$"
    },
    "strictLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "severity",
        "applies_to",
        "source",
        "when",
        "message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warn", "blocker"]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": ["project_snapshot", "project_health", "project_validate"]
        },
        "when": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/conditionValue"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditionValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      ]
    }
  }
}
