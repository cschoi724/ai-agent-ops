{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-ops.local/schemas/policy_evaluation.schema.json",
  "title": "AI Ops Policy Evaluation",
  "description": "Schema for policy rule matches evaluated from a project snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "strict_level",
    "catalog_present",
    "matched_rules",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "aiops.policy_evaluation.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "strict_level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_/-]*$"
    },
    "catalog_present": {
      "type": "boolean"
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "message",
          "source",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_/-]*$"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warn", "blocker"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["project_snapshot", "project_health", "project_validate"]
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info", "warn", "blocker"],
      "properties": {
        "info": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "blocker": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
